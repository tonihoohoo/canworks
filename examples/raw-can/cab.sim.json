{
  "schema_version": 2,
  "raw_devices": [
    {
      "name": "joystick",
      "send": [
        {
          "id": 385, "dlc": 5, "period_ms": 20,
          "signals": [
            { "name": "X", "start_bit": 0, "length": 16, "signed": true, "source": { "sine": { "min": -1000, "max": 1000, "period_s": 4 } } },
            { "name": "Y", "start_bit": 16, "length": 16, "signed": true, "source": { "sine": { "min": -500, "max": 500, "period_s": 6 } } }
          ]
        }
      ]
    },
    {
      "name": "pedal",
      "send": [
        {
          "id": 419368992, "extended": true, "dlc": 2, "period_ms": 50,
          "signals": [
            { "name": "Position", "start_bit": 7, "length": 16, "byte_order": "big", "source": { "sine": { "min": 0, "max": 1000, "period_s": 10 } } }
          ]
        }
      ]
    },
    {
      "name": "sensor",
      "send": [
        {
          "id": 912, "dlc": 4, "period_ms": 100, "pages": "all",
          "signals": [
            { "name": "Page", "start_bit": 0, "length": 8, "multiplexer": true },
            { "name": "Temp", "start_bit": 8, "length": 8, "offset": -40, "mux": { "values": [1] }, "source": { "sine": { "min": 20, "max": 60, "period_s": 20 } } },
            { "name": "Press", "start_bit": 8, "length": 16, "scale": 0.1, "mux": { "values": [2] }, "source": { "sine": { "min": 100, "max": 300, "period_s": 8 } } },
            { "name": "Counter", "start_bit": 24, "length": 8, "source": { "counter": { "start": 0, "step": 1, "min": 0, "max": 255 } } }
          ]
        }
      ]
    }
  ],
  "networks": {
    "cab": {
      "scenarios": {
        "joystick_lost": {
          "steps": [
            { "at_ms": 5000, "device": "joystick", "fault": { "stop": true } },
            { "after_ms": 2000, "device": "joystick", "clear": "stop" },
            { "after_ms": 1000, "device": "pedal", "fault": { "wrong_dlc": 1 } },
            { "after_ms": 1000, "device": "pedal", "clear": "all" },
            { "log": "joystick_lost done" }
          ]
        }
      }
    }
  }
}
