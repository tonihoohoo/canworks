            { "after_ms": 2000, "device": "joystick", "clear": "stop" },
            { "after_ms": 1000, "device": "pedal", "fault": { "wrong_dlc": 1 } },
            { "after_ms": 1000, "device": "pedal", "clear": "all" },
            { "log": "joystick_lost done" }
          ]
