            { "name": "Y", "start_bit": 16, "length": 16, "signed": true, "source": { "sine": { "min": -500, "max": 500, "period_s": 6 } } }
          ]
        }
      ]
    },
    {
      "name": "pedal",
      "send": [
        {
          "id": 419368992, "extended": true, "dlc": 2, "period_ms": 50,
          "signals": [
            { "name": "Position", "start_bit": 7, "length": 16, "byte_order": "big", "source": { "sine": { "min": 0, "max": 1000, "period_s": 10 } } }
          ]
        }
      ]
    }
  ],
  "networks": {
    "cab": {
