{"id": "cwdash.ack", "type": "ui-button", "z": "cwdash.tab", "group": "cwdash.group.controls", "name": "ack", "label": "Ack", "order": 2, "width": "0", "height": "0", "emulateClick": false, "tooltip": "Clear the alarm (only while temperature 1 is at or below the limit)", "color": "", "bgcolor": "", "className": "", "icon": "check", "iconPosition": "left", "payload": "true", "payloadType": "bool", "topic": "ack", "topicType": "str", "buttonColor": "", "textColor": "", "iconColor": "", "enableClick": true, "enablePointerdown": false, "pointerdownPayload": "", "pointerdownPayloadType": "str", "enablePointerup": false, "pointerupPayload": "", "pointerupPayloadType": "str", "x": 510, "y": 300, "wires": [["cwdash.logic"]]},
{"id": "cwdash.logic", "type": "function", "z": "cwdash.tab", "name": "plant logic", "func": "// The example plant's logic, the same as PLANT_LOGIC in the CODESYS\n// example: alarm when temperature 1 is over the limit, held until\n// Ack while it is back under; the alarm sets output byte 0 bit 0. A light\n// runs along output byte 1 (one bit every 500 ms tick) and the loop back\n// is checked on input byte 1. Outputs: 1 canworks out, 2 page state,\n// 3 trend points, 4 alarm notification.\nconst s = context.get(\"s\") || {\n    temp1: null, temp2: null, limit: 25.0, ack: false, run: true, alarm: false,\n    in0: 0, in1: 0, out0: 0, out1: 0, user0: 0, user1: 0, pos: 0, lightOk: false,\n    rtdOk: false, dioOk: false, bridge: \"connecting\", busOk: false\n};\nconst out = [], trend = [];\nlet note = null;\nconst t = msg.topic, v = msg.payload;\nif (t === \"rtd.temp1\" || t === \"rtd.temp2\") {\n    const c = Number(v) / 10;\n    if (t === \"rtd.temp1\") s.temp1 = c; else s.temp2 = c;\n    trend.push({ topic: t === \"rtd.temp1\" ? \"Temperature 1\" : \"Temperature 2\", payload: c });\n} else if (t === \"dio.in0\") s.in0 = Number(v) || 0;\nelse if (t === \"dio.in1\") s.in1 = Number(v) || 0;\nelse if (t === \"rtd.status\") s.rtdOk = !!v;\nelse if (t === \"dio.status\") s.dioOk = !!v;\nelse if (t === \"bridge.state\") s.bridge = String(v);\nelse if (t === \"bridge.bus_ok\") s.busOk = !!v;\nelse if (t === \"limit\" && Number.isFinite(Number(v))) s.limit = Number(v);\nelse if (t === \"ack\") s.ack = true;\nelse if (t === \"run\") s.run = !!v;\nelse if (t === \"switch\" && v && typeof v === \"object\") {\n    const m = 1 << v.bit;\n    if (v.name === \"dio_out0\" && v.bit > 0) s.user0 = v.value ? s.user0 | m : s.user0 & ~m;\n    if (v.name === \"dio_out1\" && !s.run) s.user1 = v.value ? s.user1 | m : s.user1 & ~m;\n}\n// The alarm.\nconst was = s.alarm;\nif (s.temp1 !== null && s.temp1 > s.limit) s.alarm = true;\nelse if (s.ack) s.alarm = false;\ns.ack = false;\nif (s.alarm && !was) note = { payload: \"Temperature 1 is over \" + s.limit.toFixed(1) + \" °C\", topic: \"Alarm\" };\n// The running light: a step every tick while running.\nif (t === \"tick\" && s.run) {\n    s.lightOk = s.in1 === s.out1;\n    s.pos = (s.pos + 1) % 8;\n}\nif (!s.run) s.lightOk = false;\nconst out0 = (s.alarm ? 1 : 0) | (s.user0 & 0xfe);\nconst out1 = s.run ? 1 << s.pos : s.user1;\nif (out0 !== s.out0 || t === \"start\") { s.out0 = out0; out.push({ topic: \"dio.out0\", payload: out0 }); }\nif (out1 !== s.out1 || t === \"start\") { s.out1 = out1; out.push({ topic: \"dio.out1\", payload: out1 }); }\ncontext.set(\"s\", s);\nconst state = { topic: \"state\", payload: {\n    temp1: s.temp1, temp2: s.temp2, limit: s.limit, alarm: s.alarm, run: s.run, lightOk: s.lightOk,\n    rtdOk: s.rtdOk, dioOk: s.dioOk, bridge: s.bridge, busOk: s.busOk,\n    dio_in0: s.in0, dio_in1: s.in1, dio_out0: s.out0, dio_out1: s.out1\n} };\nconst last = context.get(\"last\");\nconst text = JSON.stringify(state.payload);\ncontext.set(\"last\", text);\nreturn [out, text === last ? null : state, trend, note];\n", "outputs": 4, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 760, "y": 180, "wires": [["cwdash.out"], ["cwdash.plant", "cwdash.iot"], ["cwdash.chart"], ["cwdash.notify"]]},
{"id": "cwdash.out", "type": "canworks-out", "z": "cwdash.tab", "name": "outputs", "bridge": "d4fafd0077e9c57d", "topic": "", "x": 990, "y": 120, "wires": []},
{"id": "cwdash.plant", "type": "ui-template", "z": "cwdash.tab", "group": "cwdash.group.plant", "page": "", "ui": "", "name": "plant", "order": 1, "width": "0", "height": "0", "head": "", "format": "<template>\n  <div class=\"cw-plant\">\n    <div class=\"cw-temps\">\n      <div class=\"cw-temp\" :class=\"{ hot: over }\">\n        <div class=\"cw-cap\">Temperature 1</div>\n        <div class=\"cw-val\">{{ fmt(s.temp1) }}<span> °C</span></div>\n      </div>\n      <div class=\"cw-temp\">\n        <div class=\"cw-cap\">Temperature 2</div>\n        <div class=\"cw-val\">{{ fmt(s.temp2) }}<span> °C</span></div>\n      </div>\n    </div>\n    <div class=\"cw-alarm\" :class=\"{ on: alarm }\">\n      <span class=\"cw-dot\"></span>{{ alarmText }}\n    </div>\n    <div class=\"cw-status\">\n      <span><span class=\"cw-dot\" :class=\"{ ok: s.rtdOk, bad: !s.rtdOk }\"></span>rtd_ok (node 5)</span>\n      <span><span class=\"cw-dot\" :class=\"{ ok: s.dioOk, bad: !s.dioOk }\"></span>dio_ok (node 6)</span>\n      <span><span class=\"cw-dot\" :class=\"{ ok: s.lightOk, off: !s.run, bad: s.run && !s.lightOk }\"></span>Light {{ s.run ? (s.lightOk ? 'OK' : 'not looped back') : 'stopped' }}</span>\n      <span><span class=\"cw-dot\" :class=\"{ ok: s.bridge === 'running', bad: s.bridge !== 'running' }\"></span>Bridge {{ s.bridge }}</span>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  computed: {\n    s () { return (this.msg && this.msg.payload) || {} },\n    alarm () { return !!this.s.alarm },\n    over () { return typeof this.s.temp1 === 'number' && this.s.temp1 > this.s.limit },\n    alarmText () {\n      const lim = Number(this.s.limit).toFixed(1) + ' °C'\n      if (!this.alarm) return 'No alarm (limit ' + lim + ')'\n      return this.over ? 'Alarm: temperature 1 is over ' + lim : 'Alarm: temperature 1 went over ' + lim + '. Press Ack to clear it.'\n    }\n  },\n  methods: {\n    fmt (v) { return typeof v === 'number' ? v.toFixed(1) : '–' }\n  }\n}\n</script>\n<style>\n.cw-plant { display: flex; flex-direction: column; gap: 12px; width: 100%; }\n.cw-temps { display: flex; gap: 12px; flex-wrap: wrap; }\n.cw-temp { flex: 1 1 140px; padding: 8px 12px; border-radius: 6px; background: rgba(var(--v-theme-primary), 0.08); }\n.cw-temp.hot { background: rgba(var(--v-theme-error), 0.15); }\n.cw-cap { font-size: 0.85rem; opacity: 0.75; }\n.cw-val { font-size: 2rem; font-weight: 600; font-variant-numeric: tabular-nums; }\n.cw-val span { font-size: 1rem; font-weight: 400; }\n.cw-alarm { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 6px; font-weight: 600; background: rgba(var(--v-theme-on-surface), 0.05); }\n.cw-alarm.on { background: rgb(var(--v-theme-error)); color: rgb(var(--v-theme-on-error)); }\n.cw-alarm .cw-dot { background: currentColor; }\n.cw-status { display: flex; flex-wrap: wrap; gap: 8px 16px; }\n.cw-dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; background: #9e9e9e; }\n.cw-dot.ok { background: #2e7d32; }\n.cw-dot.bad { background: #c62828; }\n.cw-dot.off { background: #9e9e9e; }\n</style>\n", "storeOutMessages": true, "passthru": false, "resendOnRefresh": true, "templateScope": "local", "className": "", "x": 990, "y": 160, "wires": [[]]},
{"id": "cwdash.iot", "type": "ui-template", "z": "cwdash.tab", "group": "cwdash.group.io", "page": "", "ui": "", "name": "digital I/O", "order": 1, "width": "0", "height": "0", "head": "", "format": "<template>\n  <div class=\"cw-io\">\n    <div v-for=\"row in rows\" :key=\"row.name\" class=\"cw-row\">\n      <div class=\"cw-name\">{{ row.label }}<span>{{ row.name }}</span></div>\n      <div class=\"cw-bits\">\n        <button v-for=\"i in [7, 6, 5, 4, 3, 2, 1, 0]\" :key=\"i\" class=\"cw-bit\"\n                :class=\"{ on: bit(row.name, i), out: row.out, fixed: row.out && !can(row.name, i) }\"\n                :disabled=\"!can(row.name, i)\" :title=\"title(row, i)\" @click=\"toggle(row.name, i)\">{{ i }}</button>\n      </div>\n    </div>\n    <p class=\"cw-hint\">Outputs loop back to the inputs on the simulated module. Bit 0 of output byte 0 is the alarm; output byte 1 is the running light while it runs (stop it on the Plant page to switch it by hand).</p>\n  </div>\n</template>\n<script>\nexport default {\n  computed: {\n    s () { return (this.msg && this.msg.payload) || {} },\n    rows () {\n      return [\n        { name: 'dio_out0', label: 'Outputs, byte 0', out: true },\n        { name: 'dio_out1', label: 'Outputs, byte 1', out: true },\n        { name: 'dio_in0', label: 'Inputs, byte 0', out: false },\n        { name: 'dio_in1', label: 'Inputs, byte 1', out: false }\n      ]\n    }\n  },\n  methods: {\n    bit (name, i) { return ((Number(this.s[name]) || 0) >> i) & 1 },\n    can (name, i) { return (name === 'dio_out0' && i > 0) || (name === 'dio_out1' && this.s.run === false) },\n    title (row, i) {\n      if (row.name === 'dio_out0' && i === 0) return 'Bit 0: the alarm output'\n      if (row.name === 'dio_out1' && this.s.run !== false) return 'The running light owns this byte'\n      return row.name + ' bit ' + i\n    },\n    toggle (name, i) { this.send({ topic: 'switch', payload: { name: name, bit: i, value: !this.bit(name, i) } }) }\n  }\n}\n</script>\n<style>\n.cw-io { display: flex; flex-direction: column; gap: 10px; width: 100%; }\n.cw-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }\n.cw-name { width: 130px; font-weight: 600; }\n.cw-name span { display: block; font-weight: 400; font-size: 0.8rem; opacity: 0.7; font-family: monospace; }\n.cw-bits { display: flex; gap: 6px; flex-wrap: wrap; }\n.cw-bit { width: 34px; height: 34px; border-radius: 50%; border: 2px solid #9e9e9e; background: transparent; color: inherit; font-size: 0.8rem; cursor: default; }\n.cw-bit.out { border-radius: 6px; cursor: pointer; }\n.cw-bit.on { background: #2e7d32; border-color: #2e7d32; color: #fff; }\n.cw-bit.out.on { background: rgb(var(--v-theme-primary)); border-color: rgb(var(--v-theme-primary)); }\n.cw-bit.fixed { cursor: not-allowed; opacity: 0.75; border-style: dashed; }\n.cw-bit:focus-visible { outline: 2px solid rgb(var(--v-theme-primary)); outline-offset: 2px; }\n.cw-hint { margin: 4px 0 0; font-size: 0.85rem; opacity: 0.75; }\n</style>\n", "storeOutMessages": true, "passthru": false, "resendOnRefresh": true, "templateScope": "local", "className": "", "x": 1000, "y": 200, "wires": [["cwdash.logic"]]},
{"id": "cwdash.chart", "type": "ui-chart", "z": "cwdash.tab", "group": "cwdash.group.trend", "name": "trend", "label": "Temperatures (°C)", "order": 1, "chartType": "line", "category": "topic", "categoryType": "msg", "xAxisLabel": "", "xAxisProperty": "", "xAxisPropertyType": "timestamp", "xAxisType": "time", "xAxisFormat": "", "xAxisFormatType": "auto", "xmin": "", "xmax": "", "yAxisLabel": "°C", "yAxisProperty": "payload", "yAxisPropertyType": "msg", "ymin": "", "ymax": "", "bins": 10, "action": "append", "stackSeries": false, "pointShape": "false", "pointRadius": 4, "showLegend": true, "removeOlder": 5, "removeOlderUnit": "60", "removeOlderPoints": "", "colors": ["#0d74ce", "#e8590c", "#2e7d32", "#c62828", "#6741d9", "#868e96", "#f08c00", "#0b7285", "#a61e4d"], "textColor": ["#666666"], "textColorDefault": true, "gridColor": ["#e5e5e5"], "gridColorDefault": true, "width": "0", "height": "6", "className": "", "interpolation": "linear", "x": 990, "y": 240, "wires": [[]]},
