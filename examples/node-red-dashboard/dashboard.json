{"id": "cwdash.svc", "type": "function", "z": "cwdash.tab", "name": "service", "func": "// The Service page's buttons: NMT commands and the device name read for\n// the node picked in the dropdown. Outputs: 1 nmt, 2 sdo.\nif (msg.topic === \"node\") { flow.set(\"serviceNode\", Number(msg.payload)); return null; }\nconst target = flow.get(\"serviceNode\") || 5;\nif (msg.topic === \"nmt\") return [{ topic: \"nmt\", payload: { command: msg.payload, node: target } }, null];\nif (msg.topic === \"name\") return [null, { topic: \"name\", payload: { node: target } }];\nreturn null;\n", "outputs": 2, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 370, "y": 520, "wires": [["cwdash.nmt"], ["cwdash.sdo"]]},
{"id": "cwdash.nmt", "type": "canworks-nmt", "z": "cwdash.tab", "name": "", "bridge": "d4fafd0077e9c57d", "network": "", "command": "", "node": "0", "timeout": "", "x": 550, "y": 500, "wires": [["cwdash.result"]]},
{"id": "cwdash.sdo", "type": "canworks-sdo", "z": "cwdash.tab", "name": "device name", "bridge": "d4fafd0077e9c57d", "network": "", "node": "", "index": "0x1008", "subindex": "0", "action": "read", "datatype": "string", "size": "4", "value": "", "timeout": "", "x": 570, "y": 540, "wires": [["cwdash.result"]]},
{"id": "cwdash.result", "type": "function", "z": "cwdash.tab", "name": "result text", "func": "// One line per finished job, for the Service page.\nconst c = msg.canworks || {};\nconst what = msg.topic === \"name\" ? \"Device name\" : \"NMT\";\nif (c.status === \"done\") {\n    msg.payload = msg.topic === \"name\" ? String(msg.payload) : \"done\";\n} else {\n    msg.payload = \"error \" + c.errorId + (c.abortText ? \": \" + c.abortText : c.text ? \": \" + c.text : \"\");\n}\nmsg.payload = what + \": \" + msg.payload;\nreturn msg;\n", "outputs": 1, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 760, "y": 520, "wires": [["cwdash.result.text"]]},
{"id": "cwdash.result.text", "type": "ui-text", "z": "cwdash.tab", "group": "cwdash.group.node", "order": 6, "width": "0", "height": "0", "name": "last result", "label": "Last result", "format": "{{msg.payload}}", "layout": "row-left", "style": false, "font": "", "fontSize": 16, "color": "#717171", "wrapText": true, "className": "", "value": "payload", "valueType": "msg", "x": 960, "y": 520, "wires": []},
{"id": "cwdash.emcy", "type": "canworks-emcy", "z": "cwdash.tab", "name": "", "bridge": "d4fafd0077e9c57d", "network": "", "node": "0", "skip_old": false, "x": 120, "y": 680, "wires": [["cwdash.emcy.rows"]]},
{"id": "cwdash.emcy.rows", "type": "function", "z": "cwdash.tab", "name": "last 20", "func": "// The last 20 EMCY messages, newest first, for the table.\nconst rows = context.get(\"rows\") || [];\nconst p = msg.canworks && msg.canworks.status === \"error\" ? null : msg.payload;\nif (!p) return null;\nconst hex = (n, w) => \"0x\" + Number(n).toString(16).toUpperCase().padStart(w, \"0\");\nconst data = Buffer.isBuffer(p.data) ? p.data : Buffer.from(p.data || []);\nrows.unshift({\n    time: new Date(p.time || Date.now()).toLocaleTimeString(),\n    node: p.node, code: hex(p.code, 4), register: hex(p.register, 2),\n    data: data.toString(\"hex\").replace(/(..)/g, \"$1 \").trim()\n});\nrows.length = Math.min(rows.length, 20);\ncontext.set(\"rows\", rows);\nreturn { payload: rows };\n", "outputs": 1, "timeout": 0, "noerr": 0, "initialize": "", "finalize": "", "libs": [], "x": 330, "y": 680, "wires": [["cwdash.emcy.table"]]},
{"id": "cwdash.emcy.table", "type": "ui-table", "z": "cwdash.tab", "group": "cwdash.group.emcy", "name": "emcy", "label": "Received EMCY (newest first)", "order": 1, "width": "0", "height": "0", "maxrows": 0, "passthru": false, "autocols": false, "showSearch": false, "deselect": true, "selectionType": "none", "columns": [{"title": "Time", "key": "time", "keyType": "key", "type": "text", "width": "", "align": "start"}, {"title": "Node", "key": "node", "keyType": "key", "type": "text", "width": "", "align": "start"}, {"title": "Code", "key": "code", "keyType": "key", "type": "text", "width": "", "align": "start"}, {"title": "Register", "key": "register", "keyType": "key", "type": "text", "width": "", "align": "start"}, {"title": "Data", "key": "data", "keyType": "key", "type": "text", "width": "", "align": "start"}], "mobileBreakpoint": "sm", "mobileBreakpointType": "defaults", "action": "replace", "className": "", "x": 520, "y": 680, "wires": []}
