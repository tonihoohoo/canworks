{
  "$schema": "https://github.com/tonihoohoo/canworks/schema/canworks.v2.schema.json",
  "schema_version": 2,
  "networks": [
    {
      "name": "field",
      "adapter": {"type": "socketcan", "interface": "sim0", "bitrate": 250000, "simulate": true},
      "master": {"node_id": 1, "heartbeat_ms": 100, "sync_period_us": 20000, "state_location": "%IB14", "bus_state_location": "%IB15"},
      "nodes": [
        {
          "node_id": 5,
          "name": "rtd",
          "eds": "rtd8.eds",
          "heartbeat_ms": 100,
          "heartbeat_timeout_ms": 300,
          "status_location": "%IX16.0",
          "state_location": "%IB17",
          "emcy_code_location": "%IW20",
          "tx_pdos": [
            {
              "number": 1,
              "transmission": 1,
              "timeout_ms": 200,
              "timeout_location": "%IX16.2",
              "entries": [
                {"index": "0x7130", "subindex": 1, "type": "INTEGER16", "iec_location": "%IW0", "name": "temp1"},
                {"index": "0x7130", "subindex": 2, "type": "INTEGER16", "iec_location": "%IW2", "name": "temp2"},
                {"index": "0x7130", "subindex": 3, "type": "INTEGER16", "iec_location": "%IW4"},
                {"index": "0x7130", "subindex": 4, "type": "INTEGER16", "iec_location": "%IW6"}
              ]
            }
          ]
        },
        {
          "node_id": 6,
          "name": "dio",
          "eds": "dio16.eds",
          "heartbeat_consumer": true,
          "config_check": true,
          "heartbeat_ms": 100,
          "heartbeat_timeout_ms": 300,
          "status_location": "%IX16.1",
          "state_location": "%IB18",
          "emcy_code_location": "%IW22",
          "tx_pdos": [
            {
              "number": 1,
              "transmission": 1,
              "entries": [
                {"index": "0x6000", "subindex": 1, "type": "UNSIGNED8", "iec_location": "%IB8", "name": "in0"},
                {"index": "0x6000", "subindex": 2, "type": "UNSIGNED8", "iec_location": "%IB9", "name": "in1"},
                {"index": "0x6401", "subindex": 1, "type": "INTEGER16", "iec_location": "%IW10"},
                {"index": "0x6401", "subindex": 2, "type": "INTEGER16", "iec_location": "%IW12"}
              ]
            }
          ],
          "rx_pdos": [
            {
              "number": 1,
              "transmission": 1,
              "entries": [
                {"index": "0x6200", "subindex": 1, "type": "UNSIGNED8", "iec_location": "%QB0", "name": "out0"},
                {"index": "0x6200", "subindex": 2, "type": "UNSIGNED8", "iec_location": "%QB1", "name": "out1"},
                {"index": "0x6411", "subindex": 1, "type": "INTEGER16", "iec_location": "%QW2"},
                {"index": "0x6411", "subindex": 2, "type": "INTEGER16", "iec_location": "%QW4"}
              ]
            }
          ]
        }
      ]
    }
  ],
  "bridge": {
    "listen": "127.0.0.1:1502",
    "unit_id": 1,
    "word_order": "high_first",
    "max_clients": 16,
    "writers": ["127.0.0.1"],
    "watchdog_ms": 1000,
    "on_client_loss": "stop",
    "status_location": "%IB24",
    "control_location": "%QB6",
    "live_lists": [
      {"network": "field", "location": "%IB32"}
    ],
    "sdo_bridge_location": {"request": "%QB12", "response": "%IB48"},
    "sdo_bridge_write": true,
    "mailboxes": {"receive_blocks": 1, "input_location": "%IB64", "output_location": "%QB64"},
    "connections": [
      {
        "kind": "nodered",
        "name": "Node-RED",
        "address": "127.0.0.1",
        "writes": true,
        "period_ms": 10,
        "bridge_host": "127.0.0.1",
        "blocks": "receive"
      }
    ]
  }
}
