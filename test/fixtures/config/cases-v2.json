{
  "comment": [
    "Shared schema_version 2 fixtures (several networks), in the same form as cases.json and run by the same",
    "tests in the plugin (test/unit) and the deploy tool (tools/deploy/tests)."
  ],
  "base": {
    "schema_version": 2,
    "networks": [
      {
        "name": "io",
        "adapter": { "type": "socketcan", "interface": "vcan0", "bitrate": 125000 },
        "master": { "node_id": 1, "sync_period_us": 100000 },
        "nodes": [
          {
            "node_id": 2,
            "name": "pingpong",
            "eds": "cpp-slave.eds",
            "heartbeat_ms": 100,
            "status_location": "%IX10.0",
            "tx_pdos": [ { "entries": [ { "index": "0x4001", "subindex": 0, "type": "UNSIGNED32", "iec_location": "%ID100" } ] } ],
            "rx_pdos": [ { "entries": [ { "index": "0x4000", "subindex": 0, "type": "UNSIGNED32", "iec_location": "%QD100" } ] } ]
          }
        ]
      },
      {
        "name": "drives",
        "adapter": { "type": "socketcan", "interface": "vcan1", "bitrate": 500000 },
        "master": { "node_id": 1, "sync_period_us": 100000 },
        "nodes": [
          {
            "node_id": 2,
            "name": "pingpong",
            "eds": "cpp-slave.eds",
            "heartbeat_ms": 100,
            "status_location": "%IX10.1",
            "tx_pdos": [ { "entries": [ { "index": "0x4001", "subindex": 0, "type": "UNSIGNED32", "iec_location": "%ID101" } ] } ],
            "rx_pdos": [ { "entries": [ { "index": "0x4000", "subindex": 0, "type": "UNSIGNED32", "iec_location": "%QD101" } ] } ]
          }
        ]
      }
    ]
  },
  "cases": [
    { "name": "v2: two networks, same node ID and COB-IDs on both", "patch": [], "schema": "valid", "verdict": "accept" },
    { "name": "v2: one network without a name", "patch": [ ["delete", "networks/1"], ["delete", "networks/0/name"] ],
      "schema": "valid", "verdict": "accept" },
    { "name": "v2: no networks", "patch": [ ["set", "networks", []] ],
      "schema": "invalid", "verdict": "reject", "messages": [ "field 'networks' lists no networks" ] },
    { "name": "v2: too many networks",
      "patch": [ ["set", "networks/2", { "name": "n2", "adapter": { "type": "socketcan", "interface": "vcan2", "bitrate": 125000 }, "master": { "node_id": 1 }, "nodes": [] }],
                 ["set", "networks/3", { "name": "n3", "adapter": { "type": "socketcan", "interface": "vcan3", "bitrate": 125000 }, "master": { "node_id": 1 }, "nodes": [] }],
                 ["set", "networks/4", { "name": "n4", "adapter": { "type": "socketcan", "interface": "vcan4", "bitrate": 125000 }, "master": { "node_id": 1 }, "nodes": [] }],
                 ["set", "networks/5", { "name": "n5", "adapter": { "type": "socketcan", "interface": "vcan5", "bitrate": 125000 }, "master": { "node_id": 1 }, "nodes": [] }],
                 ["set", "networks/6", { "name": "n6", "adapter": { "type": "socketcan", "interface": "vcan6", "bitrate": 125000 }, "master": { "node_id": 1 }, "nodes": [] }],
                 ["set", "networks/7", { "name": "n7", "adapter": { "type": "socketcan", "interface": "vcan7", "bitrate": 125000 }, "master": { "node_id": 1 }, "nodes": [] }],
                 ["set", "networks/8", { "name": "n8", "adapter": { "type": "socketcan", "interface": "vcan8", "bitrate": 125000 }, "master": { "node_id": 1 }, "nodes": [] }],
                 ["set", "diagnostics", { "token_verifier": "SCRAM-SHA-256$4096:b3BlbnBsYy1jYW5vcGVuLQ==$SCwajLpaZodu1wAN8vyPszAhAZJB4cXO6Rk+MpacSlQ=:7p7OTxtK+R6omxv8Fdz+xdCpEf4bc82kbkxCL8w33kg=" }] ],
      "schema": "invalid", "verdict": "reject", "messages": [ "field 'networks' lists 9 networks; at most 8 are supported" ] },
    { "name": "v2: duplicate names ignoring case", "patch": [ ["set", "networks/1/name", "IO"] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "networks[0] and networks[1] are both named \"IO\" (names must differ, ignoring case)" ] },
    { "name": "v2: name not usable", "patch": [ ["set", "networks/1/name", "1st-bus"] ],
      "schema": "invalid", "verdict": "reject",
      "messages": [ "network name \"1st-bus\" must start with a letter and hold only letters, digits and '_', at most 16 characters" ] },
    { "name": "v2: interface without a usable name",
      "patch": [ ["delete", "networks/1/name"], ["set", "networks/1/adapter/interface", "can-x.1"] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "networks[1]: interface \"can-x.1\" is not usable as a network name; give the network a 'name'" ] },
    { "name": "v2: name defaults to the interface",
      "patch": [ ["delete", "networks/0/name"], ["delete", "networks/1/name"] ],
      "schema": "valid", "verdict": "accept" },
    { "name": "v2: same interface twice", "patch": [ ["set", "networks/1/adapter/interface", "vcan0"] ],
      "schema": "valid", "verdict": "reject", "messages": [ "networks[0] (io) and networks[1] (drives) both use interface vcan0" ] },
    { "name": "v2: same serial device twice",
      "patch": [ ["set", "networks/0/adapter", { "type": "slcan", "device": "/dev/ttyACM0", "interface": "slcan0", "bitrate": 125000 }],
                 ["set", "networks/1/adapter", { "type": "slcan", "device": "/dev/ttyACM0", "interface": "slcan1", "bitrate": 500000 }] ],
      "schema": "valid", "verdict": "reject", "messages": [ "networks[0] (io) and networks[1] (drives) both use serial device /dev/ttyACM0" ] },
    { "name": "v2: location clash between networks",
      "patch": [ ["set", "networks/1/nodes/0/tx_pdos/0/entries/0/iec_location", "%ID100"] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "networks[0] (io) node 2 (pingpong) TPDO 1 object 0x4001:0 and networks[1] (drives) node 2 (pingpong) TPDO 1 object 0x4001:0 both map to %ID100" ] },
    { "name": "v2: duplicate node ID inside one network",
      "patch": [ ["set", "networks/1/nodes/1", { "node_id": 2, "eds": "cpp-slave.eds" }] ],
      "schema": "valid", "verdict": "reject", "messages": [ "networks[1]: nodes: node ID 2 is used by more than one slave" ] },
    { "name": "v2: version 1 keys at the top level", "patch": [ ["set", "nodes", []] ],
      "schema": "invalid", "verdict": "reject", "messages": [ "field 'nodes' belongs in networks[].nodes in schema_version 2" ] },
    { "name": "v2: diagnostics inside a network",
      "patch": [ ["set", "networks/0/master/diagnostics", { "token_verifier": "SCRAM-SHA-256$4096:b3BlbnBsYy1jYW5vcGVuLQ==$SCwajLpaZodu1wAN8vyPszAhAZJB4cXO6Rk+MpacSlQ=:7p7OTxtK+R6omxv8Fdz+xdCpEf4bc82kbkxCL8w33kg=" }] ],
      "schema": "invalid", "verdict": "reject",
      "messages": [ "networks[0]: master: field 'diagnostics' is a top-level object in schema_version 2, not part of a network's master" ] },
    { "name": "v2: top-level diagnostics and a scan-only network",
      "patch": [ ["set", "networks/1/nodes", []],
                 ["set", "diagnostics", { "token_verifier": "SCRAM-SHA-256$4096:b3BlbnBsYy1jYW5vcGVuLQ==$SCwajLpaZodu1wAN8vyPszAhAZJB4cXO6Rk+MpacSlQ=:7p7OTxtK+R6omxv8Fdz+xdCpEf4bc82kbkxCL8w33kg=" }] ],
      "schema": "valid", "verdict": "accept" },
    { "name": "v2: empty node list without diagnostics", "patch": [ ["set", "networks/1/nodes", []] ],
      "schema": "invalid", "verdict": "reject",
      "messages": [ "networks[1]: field 'nodes' lists no slave nodes (an empty list needs a top-level 'diagnostics', for a scan-only configuration)" ] },
    { "name": "v2: interface and bitrate inside a network",
      "patch": [ ["set", "networks/1/interface", "vcan1"] ],
      "schema": "invalid", "verdict": "reject",
      "messages": [ "networks[1]: field 'interface' belongs in 'adapter' in schema_version 2" ] },
    { "name": "v2: unknown field in a network", "patch": [ ["set", "networks/1/colour", "blue"] ],
      "schema": "valid", "verdict": "accept",
      "warnings": [ "unknown field 'colour' (networks[1].colour) ignored" ] },
    { "name": "v2: node option error names the network",
      "patch": [ ["set", "networks/1/master/heartbeat_ms", 0], ["set", "networks/1/nodes/0/heartbeat_consumer", true] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "networks[1]: nodes[0]: 'heartbeat_consumer' needs a master heartbeat (master 'heartbeat_ms' above 0)" ] },
    { "name": "slave: a slave network next to two masters",
      "patch": [ ["set", "networks/2", {"name": "line", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300", "name": "speed"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}], "state_location": "%IB301", "comm_ok_location": "%IX300.0"}}] ],
      "schema": "valid", "verdict": "accept" },
    { "name": "slave: node ID null waits for LSS",
      "patch": [ ["set", "networks/2", {"name": "line", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300", "name": "speed"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}], "state_location": "%IB301", "comm_ok_location": "%IX300.0"}}], ["set", "networks/2/slave/node_id", null] ],
      "schema": "valid", "verdict": "accept" },
    { "name": "slave: %I location on an object the master cannot write",
      "patch": [ ["set", "networks/2", {"name": "line", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300", "name": "speed"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}], "state_location": "%IB301", "comm_ok_location": "%IX300.0"}}], ["set", "networks/2/slave/objects/1/iec_location", "%IW302"] ],
      "schema": "valid", "verdict": "reject",
      "plugin_messages": [ "the master reads 0x2100:1 (access" ],
      "tool_messages": [ "it needs a %Q location, not %IW302" ] },
    { "name": "slave: object not in the EDS",
      "patch": [ ["set", "networks/2", {"name": "line", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300", "name": "speed"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}], "state_location": "%IB301", "comm_ok_location": "%IX300.0"}}], ["set", "networks/2/slave/objects/0/index", "0x2050"] ],
      "schema": "valid", "verdict": "reject",
      "plugin_messages": [ "slave object 0x2050:1 (speed): not in the EDS openplc-slave.eds" ],
      "tool_messages": [ "slave object 0x2050:1 (speed) is not defined in openplc-slave.eds" ] },
    { "name": "slave: location smaller than the object",
      "patch": [ ["set", "networks/2", {"name": "line", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300", "name": "speed"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}], "state_location": "%IB301", "comm_ok_location": "%IX300.0"}}], ["set", "networks/2/slave/objects/0/iec_location", "%IB300"] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "slave object 0x2000:1 (speed): type UNSIGNED16 (16 bit) does not fit location %IB300 (8 bit)" ] },
    { "name": "slave: master fields on a slave network",
      "patch": [ ["set", "networks/2", {"name": "line", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300", "name": "speed"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}], "state_location": "%IB301", "comm_ok_location": "%IX300.0"}}], ["set", "networks/2/master", {"node_id": 1}] ],
      "schema": "invalid", "verdict": "reject",
      "messages": [ "networks[2]: field 'master' belongs to a master network; a slave network (\"role\": \"slave\") has" ] },
    { "name": "slave: slave field on a master network",
      "patch": [ ["set", "networks/0/slave", {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300", "name": "speed"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}], "state_location": "%IB301", "comm_ok_location": "%IX300.0"}] ],
      "schema": "invalid", "verdict": "reject",
      "messages": [ "networks[0]: field 'slave' belongs to a slave network" ] },
    { "name": "gateway: routes, status, EMCY and SDO bridge",
      "patch": [ ["set", "networks/2", {"name": "upper", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 20, "eds": "openplc-gateway.eds", "comm_ok_location": "%IX300.0"}}], ["set", "gateway", {"upper": "upper", "routes": [{"slave": {"index": "0x2101", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4001", "subindex": 0}, "name": "pong"}, {"slave": {"index": "0x2000", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4000", "subindex": 0}, "name": "ping"}], "status": {"index": "0x5E00"}, "emcy_forward": true, "on_upper_loss": "stop_nodes", "sdo_bridge": true}], ["delete", "networks/0/nodes/0/rx_pdos/0/entries/0/iec_location"] ],
      "schema": "valid", "verdict": "accept",
      "warnings": [ "gateway status of network \"drives\" is not published: objects 0x5E01 and 0x5E11 are not in the EDS openplc-gateway.eds" ] },
    { "name": "gateway: a routed RPDO entry with its own output location",
      "patch": [ ["set", "networks/2", {"name": "upper", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 20, "eds": "openplc-gateway.eds", "comm_ok_location": "%IX300.0"}}], ["set", "gateway", {"upper": "upper", "routes": [{"slave": {"index": "0x2101", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4001", "subindex": 0}, "name": "pong"}, {"slave": {"index": "0x2000", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4000", "subindex": 0}, "name": "ping"}], "status": {"index": "0x5E00"}, "emcy_forward": true, "on_upper_loss": "stop_nodes", "sdo_bridge": true}] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "gateway: routes[1]: " ],
      "plugin_messages": [ "writes node 2 (pingpong) RPDO entry 0x4000:0 on network \"io\", which also has %QD100" ],
      "tool_messages": [ "is written by routes[1] and by %QD100" ] },
    { "name": "gateway: upper is a master network",
      "patch": [ ["set", "networks/2", {"name": "upper", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 20, "eds": "openplc-gateway.eds", "comm_ok_location": "%IX300.0"}}], ["set", "gateway", {"upper": "upper", "routes": [{"slave": {"index": "0x2101", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4001", "subindex": 0}, "name": "pong"}, {"slave": {"index": "0x2000", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4000", "subindex": 0}, "name": "ping"}], "status": {"index": "0x5E00"}, "emcy_forward": true, "on_upper_loss": "stop_nodes", "sdo_bridge": true}], ["delete", "networks/0/nodes/0/rx_pdos/0/entries/0/iec_location"], ["set", "gateway/upper", "drives"] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "must be a slave network (\"role\": \"slave\")" ] },
    { "name": "gateway: route ends of different types",
      "patch": [ ["set", "networks/2", {"name": "upper", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 20, "eds": "openplc-gateway.eds", "comm_ok_location": "%IX300.0"}}], ["set", "gateway", {"upper": "upper", "routes": [{"slave": {"index": "0x2101", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4001", "subindex": 0}, "name": "pong"}, {"slave": {"index": "0x2000", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4000", "subindex": 0}, "name": "ping"}], "status": {"index": "0x5E00"}, "emcy_forward": true, "on_upper_loss": "stop_nodes", "sdo_bridge": true}], ["delete", "networks/0/nodes/0/rx_pdos/0/entries/0/iec_location"], ["set", "gateway/routes/0/slave/index", "0x2100"] ],
      "schema": "valid", "verdict": "reject",
      "plugin_messages": [ "is UNSIGNED32 but slave object 0x2100:1 is BOOLEAN" ],
      "tool_messages": [ "0x4001:0 (UNSIGNED32) and slave object 0x2100:1 (BOOLEAN) need the same data type" ] },
    { "name": "gateway: field end not in a configured PDO",
      "patch": [ ["set", "networks/2", {"name": "upper", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 20, "eds": "openplc-gateway.eds", "comm_ok_location": "%IX300.0"}}], ["set", "gateway", {"upper": "upper", "routes": [{"slave": {"index": "0x2101", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4001", "subindex": 0}, "name": "pong"}, {"slave": {"index": "0x2000", "subindex": 1}, "field": {"network": "io", "node": 2, "index": "0x4000", "subindex": 0}, "name": "ping"}], "status": {"index": "0x5E00"}, "emcy_forward": true, "on_upper_loss": "stop_nodes", "sdo_bridge": true}], ["delete", "networks/0/nodes/0/rx_pdos/0/entries/0/iec_location"], ["set", "gateway/routes/0/field/index", "0x1017"] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "gateway: routes[0]: " ],
      "plugin_messages": [ "has no PDO entry 0x1017:0" ],
      "tool_messages": [ "0x1017:0 is not an entry of the node's tx_pdos or rx_pdos" ] },
    { "name": "gateway: status objects missing from the slave EDS",
      "patch": [ ["set", "networks/2", {"name": "upper", "role": "slave", "adapter": {"type": "socketcan", "interface": "vcan2", "bitrate": 250000}, "slave": {"node_id": 20, "eds": "openplc-gateway.eds", "comm_ok_location": "%IX300.0"}}], ["set", "networks/2/slave/eds", "openplc-slave.eds"], ["set", "gateway", {"upper": "upper", "routes": [], "status": {"index": "0x5E00"}}] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "gateway status of network \"io\" needs object 0x5E00" ] },
    { "name": "gateway: PDO entry without iec_location and no route",
      "patch": [ ["delete", "networks/0/nodes/0/rx_pdos/0/entries/0/iec_location"] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "networks[0]: nodes[0]: rx_pdos[0]: entries[0]: ", "(only an entry a gateway route uses may leave it out)" ] },
    { "name": "simulated bus: a master and a slave network share one bus",
      "patch": [ ["set", "networks/0/adapter/interface", "sim0"], ["set", "networks/0/adapter/simulate", true], ["set", "networks/2", {"name": "line", "role": "slave", "adapter": {"type": "socketcan", "interface": "sim0", "bitrate": 125000, "simulate": true}, "slave": {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}]}}] ],
      "schema": "valid", "verdict": "accept" },
    { "name": "simulated bus: two master networks on one bus",
      "patch": [ ["set", "networks/0/adapter/interface", "sim0"], ["set", "networks/0/adapter/simulate", true], ["set", "networks/1/adapter/interface", "sim0"], ["set", "networks/1/adapter/simulate", true] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "networks[0] (io) and networks[1] (drives) are both master networks on simulated bus sim0 (a simulated bus takes one master network and one slave network)" ] },
    { "name": "simulated bus: the master's node for the slave is simulated too",
      "patch": [ ["set", "networks/0/adapter/interface", "sim0"], ["set", "networks/0/adapter/simulate", true], ["set", "networks/2", {"name": "line", "role": "slave", "adapter": {"type": "socketcan", "interface": "sim0", "bitrate": 125000, "simulate": true}, "slave": {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}]}}], ["set", "networks/2/slave/node_id", 2] ],
      "schema": "valid", "verdict": "reject",
      "messages": [ "networks[0] (io) node 2 is networks[2] (line) on simulated bus sim0; set \"simulate\": false on the node, or the simulator answers in its place" ] },
    { "name": "simulated bus: the master's node for the slave is not simulated",
      "patch": [ ["set", "networks/0/adapter/interface", "sim0"], ["set", "networks/0/adapter/simulate", true], ["set", "networks/2", {"name": "line", "role": "slave", "adapter": {"type": "socketcan", "interface": "sim0", "bitrate": 125000, "simulate": true}, "slave": {"node_id": 10, "eds": "openplc-slave.eds", "objects": [{"index": "0x2000", "subindex": 1, "iec_location": "%IW300"}, {"index": "0x2100", "subindex": 1, "iec_location": "%QW300"}]}}], ["set", "networks/2/slave/node_id", 2], ["set", "networks/0/nodes/0/simulate", false] ],
