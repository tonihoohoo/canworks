              }
            ],
            "rx_pdos": [
              {
                "entries": [
                  {
                    "index": "0x4000",
                    "subindex": 0,
                    "type": "UNSIGNED32",
                    "iec_location": "%QD100"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "message": "this config is for the removed OpenPLC plugin"
