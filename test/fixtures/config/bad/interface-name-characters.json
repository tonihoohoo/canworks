{
  "description": "A plain CAN network whose interface name has a space (L8).",
  "config": {
    "schema_version": 2,
    "networks": [
      {
        "name": "io",
        "adapter": {
          "type": "socketcan",
          "interface": "vcan0",
          "bitrate": 125000
        },
        "master": {
          "node_id": 1,
          "sync_period_us": 100000
        },
        "nodes": [
          {
            "node_id": 2,
            "name": "pingpong",
            "eds": "cpp-slave.eds",
            "heartbeat_ms": 100,
            "status_location": "%IX10.0",
            "tx_pdos": [
              {
                "entries": [
                  {
                    "index": "0x4001",
                    "subindex": 0,
                    "type": "UNSIGNED32",
                    "iec_location": "%ID100"
                  }
                ]
              }
            ],
            "rx_pdos": [
              {
                "entries": [
                  {
                    "index": "0x4000",
                    "subindex": 0,
                    "type": "UNSIGNED32",
                    "iec_location": "%QD100"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "panel",
        "protocol": "none",
        "adapter": {
          "type": "socketcan",
          "interface": "can 1",
          "bitrate": 250000
        }
      }
    ]
  }
}
