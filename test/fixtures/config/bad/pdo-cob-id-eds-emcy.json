{
  "description": "Node 2's EDS moves its EMCY to 0xC2 (0x1014 default $NODEID+0xC0) and its TPDO 1 uses 0xC2.",
  "config": {
    "schema_version": 1,
    "adapter": {
      "type": "socketcan",
      "interface": "vcan0",
      "bitrate": 125000
    },
    "master": {
      "node_id": 1,
      "sync_period_us": 100000
    },
    "nodes": [
      {
        "node_id": 2,
        "name": "pingpong",
        "eds": "emcy-moved.eds",
        "heartbeat_ms": 100,
        "status_location": "%IX10.0",
        "tx_pdos": [
          {
            "entries": [
              {
                "index": "0x4001",
                "subindex": 0,
                "type": "UNSIGNED32",
                "iec_location": "%ID100"
              }
            ],
            "cob_id": "0xC2"
          }
        ],
        "rx_pdos": [
          {
            "entries": [
              {
                "index": "0x4000",
                "subindex": 0,
                "type": "UNSIGNED32",
                "iec_location": "%QD100"
              }
            ]
          }
        ],
        "sdo": [
          {
            "index": "0x1017",
            "subindex": 0,
            "type": "UNSIGNED16",
            "value": 100
          }
        ]
      }
    ]
  },
  "eds_files": {
    "emcy-moved.eds": {
      "from": "emcy-slave.eds",
      "replace": [
        [
          "DefaultValue=$NODEID+0x80",
          "DefaultValue=$NODEID+0xC0"
        ]
      ]
    }
  },
  "message": "COB-ID 0x0C2 is node 2's EMCY (its EDS's 0x1014)"
}
