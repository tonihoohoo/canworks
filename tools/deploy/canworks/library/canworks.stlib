    {
      "name": "CO_SDO_READ_REAL",
      "kind": "functionBlock",
      "header": "class CO_SDO_READ_REAL {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    IEC_LREAL VALUE;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    CW_SDO_XFER X;\n    Array1D<IEC_BYTE, 0, 1023> BUF;\n    IEC_BOOL WAS;\n    IEC_BOOL BAD;\n    IEC_LWORD BITS;\n    IEC_INT I;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_READ_REAL();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_READ_REAL() = default;\n};\n",
      "cpp": "CO_SDO_READ_REAL::CO_SDO_READ_REAL() {\n    // Initialize variables\n}\n\nvoid CO_SDO_READ_REAL::operator()() {\n    X.EXECUTE = EXECUTE;\n    X.WRITE = false;\n    X.NETWORK = NETWORK;\n    X.NODE = NODE;\n    X.INDEX = INDEX;\n    X.SUBINDEX = SUBINDEX;\n    X.TIMEOUT = TIMEOUT;\n    X.KIND = 1;\n    X.MAX_SIZE = 8;\n    X.FETCH_MAX = 8;\n    X.LINK = LINK;\n    X.DATA = BUF;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUF = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = X.ERROR;\n    ERROR_ID = X.ERROR_ID;\n    ABORT_CODE = X.ABORT_CODE;\n    if ((X.DONE) & (!WAS)) {\n        BAD = (X.RSIZE != 4) & (X.RSIZE != 8);\n        if (!BAD) {\n            BITS = 0;\n            for (I = TO_INT(X.RSIZE) - 1; I >= 0; I += -1) {\n                BITS = (SHL(BITS, 8)) | (TO_LWORD(BUF.at(I)));\n            }\n            if (X.RSIZE == 4) {\n                VALUE = TO_LREAL(CW_DWORD_TO_REAL(TO_DWORD(BITS)));\n            } else {\n                VALUE = CW_LWORD_TO_LREAL(BITS);\n            }\n        }\n    }\n    WAS = X.DONE;\n    if ((X.DONE) & (BAD)) {\n        DONE = false;\n        ERROR = true;\n        ERROR_ID = 7;\n    }\n}\n",
