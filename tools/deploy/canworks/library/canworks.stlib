    {
      "name": "CO_NMT",
      "kind": "functionBlock",
      "header": "class CO_NMT {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_USINT COMMAND;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // In-Out\n    Array1D<IEC_WORD, 0, 88> LINK;\n    // Local variables\n    IEC_WORD ME;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_WORD CMD;\n    IEC_WORD COUNTER;\n    TON TIMER;\n    IEC_WORD RESULT;\n    IEC_UINT ERR;\n    IEC_BOOL FIN;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_NMT();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_NMT() = default;\n};\n",
      "cpp": "CO_NMT::CO_NMT() {\n    // Initialize variables\n}\n\nvoid CO_NMT::operator()() {\n    if (ME == 0) {\n        LINK.at(24) = LINK.at(24) + 1;\n        ME = LINK.at(24);\n    }\n    if ((PHASE == 3) & (!EXECUTE)) {\n        PHASE = 0;\n        DONE = false;\n        ERROR = false;\n    }\n    ERR = 0;\n    FIN = false;\n    if (((PHASE == 0) & (EXECUTE)) & (!PREV)) {\n        DONE = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        switch (COMMAND) {\n            case 1:\n                CMD = 3;\n                break;\n            case 2:\n                CMD = 4;\n                break;\n            case 128:\n                CMD = 5;\n                break;\n            case 129:\n                CMD = 6;\n                break;\n            case 130:\n                CMD = 7;\n                break;\n            default:\n                CMD = 0;\n                break;\n        }\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (((LINK.at(21)) & (0x0002)) == 0) {\n            ERR = 22;\n        } else if ((CMD == 0) | (NODE > 127)) {\n            ERR = 6;\n        } else {\n            PHASE = 1;\n        }\n    }\n    if ((PHASE == 1) | (PHASE == 2)) {\n        TIMER.IN = true;\n        TIMER.PT = SEL(TIMEOUT == 0LL, TIMEOUT, 5000000000LL);\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (TIMER.Q) {\n            ERR = 2;\n        } else if ((PHASE == 1) & (((LINK.at(22) == 0) | (LINK.at(22) == ME)))) {\n            LINK.at(22) = ME;\n            COUNTER = LINK.at(2) + 1;\n            LINK.at(4) = COUNTER;\n            LINK.at(5) = (SHL(CMD, 8)) | (TO_WORD(NETWORK));\n            LINK.at(6) = SHL(TO_WORD(NODE), 8);\n            PHASE = 2;\n        } else if ((PHASE == 2) & (LINK.at(2) == COUNTER)) {\n            RESULT = SHR(LINK.at(3), 8);\n            if (RESULT == 0) {\n                FIN = true;\n            } else if (RESULT == 5) {\n                ERR = 5;\n            } else {\n                ERR = 6;\n            }\n        }\n    }\n    if ((ERR != 0) | (FIN)) {\n        PHASE = 3;\n        DONE = FIN;\n        ERROR = ERR != 0;\n        ERROR_ID = ERR;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (LINK.at(22) == ME) {\n            LINK.at(22) = 0;\n        }\n    }\n    BUSY = (PHASE == 1) | (PHASE == 2);\n    PREV = EXECUTE;\n}\n",
