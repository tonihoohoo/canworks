      ]
    },
    {
      "name": "CW_LWORD_TO_LREAL",
      "kind": "function",
      "header": "IEC_LREAL CW_LWORD_TO_LREAL(IEC_LWORD IN);",
      "cpp": "IEC_LREAL CW_LWORD_TO_LREAL(IEC_LWORD IN) {\n    IEC_LREAL CW_LWORD_TO_LREAL_result;\n    IEC_INT E;\n    IEC_LREAL M;\n    IEC_LREAL X;\n    E = TO_INT((SHR(IN, 52)) & (0x7FF));\n    M = TO_LREAL((IN) & (0xFFFFFFFFFFFFF));\n    if (E == 2047) {\n        if (M != 0.0) {\n            X = 0.0;\n        } else {\n            X = 1.7976931348623157e+308;\n        }\n    } else if (E == 0) {\n        X = M * EXPT(2.0, static_cast<IEC_REAL>(-1074));\n    } else {\n        X = (M + 4503599627370496.0) * EXPT(2.0, E - 1075);\n    }\n    if (((IN) & (0x8000000000000000)) != 0) {\n        X = -X;\n    }\n    CW_LWORD_TO_LREAL_result = X;\n    return CW_LWORD_TO_LREAL_result;\n}\n",
