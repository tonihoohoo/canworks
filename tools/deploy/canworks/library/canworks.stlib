    {
      "name": "CO_NODE_LIVE",
      "kind": "functionBlock",
      "header": "class CO_NODE_LIVE {\npublic:\n    // Inputs\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    // Outputs\n    IEC_BOOL LIVE;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    IEC_INT BYTE_NO;\n    IEC_WORD WORD;\n    IEC_INT BIT_NO;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_NODE_LIVE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_NODE_LIVE() = default;\n};\n",
      "cpp": "CO_NODE_LIVE::CO_NODE_LIVE() {\n    // Initialize variables\n}\n\nvoid CO_NODE_LIVE::operator()() {\n    LIVE = false;\n    if ((((((LINK.at(21)) & (0x0001)) != 0) & (NETWORK < 8)) & (NODE >= 1)) & (NODE <= 127)) {\n        if (((SHR(LINK.at(21), TO_UINT(NETWORK) + 8)) & (0x0001)) != 0) {\n            BYTE_NO = TO_INT(NODE) / 8;\n            WORD = LINK.at(25 + TO_INT(NETWORK) * 8 + BYTE_NO / 2);\n            BIT_NO = TO_INT(NODE) % 8;\n            if (BYTE_NO % 2 == 0) {\n                BIT_NO = BIT_NO + 8;\n            }\n            LIVE = ((SHR(WORD, TO_UINT(BIT_NO))) & (0x0001)) != 0;\n        }\n    }\n}\n",
