    {
      "name": "J1939_NAME_SPLIT",
      "kind": "functionBlock",
      "header": "class J1939_NAME_SPLIT {\npublic:\n    // Inputs\n    IEC_LWORD NAME;\n    // Outputs\n    IEC_UDINT IDENTITY_NUMBER;\n    IEC_UINT MANUFACTURER_CODE;\n    IEC_USINT ECU_INSTANCE;\n    IEC_USINT FUNCTION_INSTANCE;\n    IEC_USINT ECU_FUNCTION;\n    IEC_USINT VEHICLE_SYSTEM;\n    IEC_USINT VEHICLE_SYSTEM_INSTANCE;\n    IEC_USINT INDUSTRY_GROUP;\n    IEC_BOOL ARBITRARY_ADDRESS_CAPABLE;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_NAME_SPLIT();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_NAME_SPLIT() = default;\n};\n",
      "cpp": "J1939_NAME_SPLIT::J1939_NAME_SPLIT() {\n    // Initialize variables\n}\n\nvoid J1939_NAME_SPLIT::operator()() {\n    IDENTITY_NUMBER = TO_UDINT((NAME) & (0x1FFFFF));\n    MANUFACTURER_CODE = TO_UINT((SHR(NAME, 21)) & (0x7FF));\n    ECU_INSTANCE = TO_USINT((SHR(NAME, 32)) & (0x7));\n    FUNCTION_INSTANCE = TO_USINT((SHR(NAME, 35)) & (0x1F));\n    ECU_FUNCTION = TO_USINT((SHR(NAME, 40)) & (0xFF));\n    VEHICLE_SYSTEM = TO_USINT((SHR(NAME, 49)) & (0x7F));\n    VEHICLE_SYSTEM_INSTANCE = TO_USINT((SHR(NAME, 56)) & (0xF));\n    INDUSTRY_GROUP = TO_USINT((SHR(NAME, 60)) & (0x7));\n    ARBITRARY_ADDRESS_CAPABLE = ((NAME) & (static_cast<IEC_LWORD>(0x8000000000000000))) != 0;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
