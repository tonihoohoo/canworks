    {
      "name": "CW_SDO_XFER",
      "kind": "functionBlock",
      "header": "class CW_SDO_XFER {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_BOOL WRITE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_TIME TIMEOUT;\n    IEC_USINT KIND;\n    IEC_USINT SIZE;\n    IEC_UINT LENGTH;\n    IEC_UDINT MAX_SIZE;\n    IEC_UINT FETCH_MAX;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    IEC_UDINT RSIZE;\n    IEC_UINT GOT;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    Array1D<IEC_BYTE, 0, 1023> DATA;\n    // Local variables\n    CW_MB_CALL MB;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_UINT OFFSET;\n    IEC_UINT WANT;\n    IEC_INT N;\n    IEC_INT K;\n    IEC_INT B;\n    IEC_UDINT MS;\n    IEC_UINT ERR;\n    IEC_BOOL FIN;\n    IEC_USINT OP;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CW_SDO_XFER();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CW_SDO_XFER() = default;\n};\n",
      "cpp": "CW_SDO_XFER::CW_SDO_XFER()\n    : MAX_SIZE(1024), FETCH_MAX(1024)\n{\n    // Initialize variables\n}\n\nvoid CW_SDO_XFER::operator()() {\n    if ((PHASE == 4) & (!EXECUTE)) {\n        PHASE = 0;\n        DONE = false;\n        ERROR = false;\n    }\n    ERR = 0;\n    FIN = false;\n    if (((PHASE == 0) & (EXECUTE)) & (!PREV)) {\n        DONE = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        ABORT_CODE = 0;\n        RSIZE = 0;\n        GOT = 0;\n        OFFSET = 0;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (((LINK.at(89)) & (0x0007)) == 0) {\n            ERR = 22;\n        } else if (((NODE < 1) | (NODE > 127)) | (((WRITE) & (LENGTH > 1024)))) {\n            ERR = 6;\n        } else if ((WRITE) & (LENGTH > 128)) {\n            PHASE = 1;\n        } else {\n            PHASE = 2;\n        }\n    }\n    if ((PHASE >= 1) & (PHASE <= 3)) {\n        MB.RUN = true;\n        MB.SEND = false;\n        MB.LINK = LINK;\n        MB();\n        MB.ENO = true;\n        LINK = MB.LINK;\n        B = MB.BASE;\n        if (MB.LOST) {\n            ERR = 20;\n        } else if ((MB.ANSWERED) & (MB.ERR != 0)) {\n            ERR = MB.ERR;\n            if (PHASE == 2) {\n                ABORT_CODE = TO_UDINT(LINK.at(B + 76)) * 65536 + TO_UDINT(LINK.at(B + 77));\n            }\n        } else if ((MB.ANSWERED) & (PHASE == 1)) {\n            OFFSET = OFFSET + 128;\n            if (OFFSET >= LENGTH) {\n                PHASE = 2;\n            }\n        } else if (((MB.ANSWERED) & (PHASE == 2)) & (WRITE)) {\n            FIN = true;\n        } else if (MB.ANSWERED) {\n            if (PHASE == 2) {\n                RSIZE = TO_UDINT(LINK.at(B + 74)) * 65536 + TO_UDINT(LINK.at(B + 75));\n                WANT = FETCH_MAX;\n                if (WANT > 1024) {\n                    WANT = 1024;\n                }\n                if (RSIZE < TO_UDINT(WANT)) {\n                    WANT = TO_UINT(RSIZE);\n                }\n            }\n            if ((PHASE == 2) & (RSIZE > MAX_SIZE)) {\n                ERR = 7;\n            } else {\n                N = TO_INT(WANT - GOT);\n                if (N > 128) {\n                    N = 128;\n                }\n                for (K = 0; K <= N - 1; K++) {\n                    if ((K % 2) == 0) {\n                        DATA.at(TO_INT(GOT) + K) = TO_BYTE(SHR(LINK.at(B + 80 + K / 2), 8));\n                    } else {\n                        DATA.at(TO_INT(GOT) + K) = TO_BYTE(LINK.at(B + 80 + K / 2));\n                    }\n                }\n                GOT = GOT + TO_UINT(N);\n                if (GOT >= WANT) {\n                    FIN = true;\n                } else {\n                    PHASE = 3;\n                }\n            }\n        }\n        if ((((ERR == 0) & (!FIN)) & (MB.OWNED)) & (!MB.WAITING)) {\n            if (PHASE == 1) {\n                N = TO_INT(LENGTH - OFFSET);\n                if (N > 128) {\n                    N = 128;\n                }\n                for (K = 0; K <= 63; K++) {\n                    LINK.at(B + 8 + K) = 0;\n                }\n                for (K = 0; K <= N - 1; K++) {\n                    if ((K % 2) == 0) {\n                        LINK.at(B + 8 + K / 2) = SHL(TO_WORD(DATA.at(TO_INT(OFFSET) + K)), 8);\n                    } else {\n                        LINK.at(B + 8 + K / 2) = (LINK.at(B + 8 + K / 2)) | (TO_WORD(DATA.at(TO_INT(OFFSET) + K)));\n                    }\n                }\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = 1;\n                MB.NET = 0;\n                MB.A0 = TO_WORD(OFFSET);\n                MB.A1 = TO_WORD(N);\n                MB.A2 = 0;\n                MB.A3 = 0;\n                MB.A4 = 0;\n                MB.A5 = 0;\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            } else if (PHASE == 2) {\n                if ((WRITE) & (LENGTH <= 128)) {\n                    for (K = 0; K <= 63; K++) {\n                        LINK.at(B + 8 + K) = 0;\n                    }\n                    for (K = 0; K <= TO_INT(LENGTH) - 1; K++) {\n                        if ((K % 2) == 0) {\n                            LINK.at(B + 8 + K / 2) = SHL(TO_WORD(DATA.at(K)), 8);\n                        } else {\n                            LINK.at(B + 8 + K / 2) = (LINK.at(B + 8 + K / 2)) | (TO_WORD(DATA.at(K)));\n                        }\n                    }\n                }\n                MS = TO_UDINT(TIME_TO_MS(TIMEOUT));\n                if (MS > 65535) {\n                    MS = 65535;\n                }\n                OP = SEL(WRITE, static_cast<IEC_USINT>(3), static_cast<IEC_USINT>(4));\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = OP;\n                MB.NET = NETWORK;\n                MB.A0 = (SHL(TO_WORD(NODE), 8)) | (TO_WORD(SUBINDEX));\n                MB.A1 = TO_WORD(INDEX);\n                MB.A2 = (SHL(TO_WORD(KIND), 8)) | (TO_WORD(SIZE));\n                MB.A3 = TO_WORD(MS);\n                MB.A4 = TO_WORD(LENGTH);\n                MB.A5 = 0;\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            } else {\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = 2;\n                MB.NET = 0;\n                MB.A0 = TO_WORD(GOT);\n                MB.A1 = 0;\n                MB.A2 = 0;\n                MB.A3 = 0;\n                MB.A4 = 0;\n                MB.A5 = 0;\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            }\n        }\n    }\n    if ((ERR != 0) | (FIN)) {\n        PHASE = 4;\n        DONE = FIN;\n        ERROR = ERR != 0;\n        ERROR_ID = ERR;\n        MB.RUN = false;\n        MB.LINK = LINK;\n        MB();\n        MB.ENO = true;\n        LINK = MB.LINK;\n    }\n    BUSY = (PHASE >= 1) & (PHASE <= 3);\n    PREV = EXECUTE;\n}\n",
