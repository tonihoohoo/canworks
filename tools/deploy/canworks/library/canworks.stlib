    {
      "name": "J1939_DM_CLEAR",
      "kind": "functionBlock",
      "header": "class J1939_DM_CLEAR {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT DESTINATION;\n    IEC_BOOL PREVIOUS_ONLY;\n    IEC_TIME TIMEOUT;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    CW_REQUEST X;\n    IEC_BOOL PREV;\n    IEC_UINT REFUSED;\n    IEC_UDINT MS;\n    Array1D<IEC_BYTE, 0, 1784> BUF;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_DM_CLEAR();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_DM_CLEAR() = default;\n};\n",
      "cpp": "J1939_DM_CLEAR::J1939_DM_CLEAR() {\n    // Initialize variables\n}\n\nvoid J1939_DM_CLEAR::operator()() {\n    MS = TO_UDINT(TIME_TO_MS(TIMEOUT));\n    if (MS > 65535) {\n        MS = 65535;\n    }\n    if (((EXECUTE) & (!PREV)) & (!X.BUSY)) {\n        REFUSED = 0;\n        if (DESTINATION == 254) {\n            REFUSED = 3;\n        }\n    } else if (!EXECUTE) {\n        REFUSED = 0;\n    }\n    PREV = EXECUTE;\n    X.EXECUTE = (EXECUTE) & (REFUSED == 0);\n    X.OP = 14;\n    X.NET = NETWORK;\n    X.A0 = TO_WORD(DESTINATION);\n    X.A1 = SEL(PREVIOUS_ONLY, static_cast<IEC_WORD>(0), static_cast<IEC_WORD>(1));\n    X.A2 = TO_WORD(MS);\n    X.A3 = 0;\n    X.A4 = 0;\n    X.A5 = 0;\n    X.LENGTH = 0;\n    X.FETCH_MAX = 0;\n    X.LINK = LINK;\n    X.DATA = BUF;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUF = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = (X.ERROR) | (REFUSED != 0);\n    ERROR_ID = SEL(REFUSED != 0, X.ERROR_ID, REFUSED);\n}\n",
