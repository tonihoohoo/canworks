    {
      "name": "J1939_RECEIVE",
      "kind": "functionBlock",
      "header": "class J1939_RECEIVE {\npublic:\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_USINT NETWORK;\n    IEC_UDINT PGN;\n    IEC_BOOL ANY;\n    IEC_USINT SOURCE;\n    IEC_BOOL FILTER_SOURCE;\n    IEC_BOOL ALL_DESTINATIONS;\n    IEC_UINT DEPTH;\n    // In-Out\n    Array1D<IEC_BYTE, 0, 1784> RX_DATA;\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL ACTIVE;\n    IEC_BOOL NEW;\n    IEC_UDINT RX_PGN;\n    IEC_USINT RX_SOURCE;\n    IEC_USINT RX_DESTINATION;\n    IEC_USINT RX_PRIORITY;\n    IEC_UINT RX_LENGTH;\n    IEC_ULINT TIMESTAMP;\n    IEC_UINT QUEUED;\n    IEC_BOOL OVERFLOW;\n    IEC_UDINT DROPPED;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    CW_RX RX;\n    CW_REQUEST FETCH;\n    IEC_BOOL PREV;\n    IEC_BOOL WAS_ACTIVE;\n    IEC_BOOL FETCHING;\n    IEC_WORD LAST_DROP;\n    IEC_USINT SRC;\n    IEC_USINT FLAGS;\n    IEC_UDINT O_PGN;\n    IEC_USINT O_SOURCE;\n    IEC_USINT O_FLAGS;\n    IEC_UINT O_DEPTH;\n    IEC_BOOL CHANGED;\n    IEC_INT R;\n    IEC_INT I;\n    IEC_UINT FERR;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_RECEIVE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_RECEIVE() = default;\n};\n",
      "cpp": "J1939_RECEIVE::J1939_RECEIVE() {\n    // Initialize variables\n}\n\nvoid J1939_RECEIVE::operator()() {\n    NEW = false;\n    FERR = 0;\n    if ((ENABLE) & (!PREV)) {\n        QUEUED = 0;\n        OVERFLOW = false;\n        DROPPED = 0;\n    }\n    PREV = ENABLE;\n    SRC = SEL(FILTER_SOURCE, static_cast<IEC_USINT>(255), SOURCE);\n    FLAGS = (SEL(ANY, static_cast<IEC_USINT>(0), static_cast<IEC_USINT>(1))) | (SEL(ALL_DESTINATIONS, static_cast<IEC_USINT>(0), static_cast<IEC_USINT>(2)));\n    CHANGED = (RX.ACTIVE) & (((((PGN != O_PGN) | (SRC != O_SOURCE)) | (FLAGS != O_FLAGS)) | (DEPTH != O_DEPTH)));\n    if (!RX.ACTIVE) {\n        O_PGN = PGN;\n        O_SOURCE = SRC;\n        O_FLAGS = FLAGS;\n        O_DEPTH = DEPTH;\n    }\n    if (FETCHING) {\n        FETCH.EXECUTE = true;\n        FETCH.OP = 10;\n        FETCH.NET = NETWORK;\n        FETCH.A0 = TO_WORD(RX.SLOT);\n        FETCH.A1 = 0;\n        FETCH.A2 = 0;\n        FETCH.A3 = 0;\n        FETCH.A4 = 0;\n        FETCH.A5 = 0;\n        FETCH.LENGTH = 0;\n        FETCH.RLEN_AT = 0;\n        FETCH.FETCH_MAX = 1785;\n        FETCH.LINK = LINK;\n        FETCH.DATA = RX_DATA;\n        FETCH();\n        FETCH.ENO = true;\n        LINK = FETCH.LINK;\n        RX_DATA = FETCH.DATA;\n        if (FETCH.DONE) {\n            FETCHING = false;\n            NEW = true;\n            RX_LENGTH = FETCH.GOT;\n        } else if (FETCH.ERROR) {\n            FETCHING = false;\n            FERR = FETCH.ERROR_ID;\n        }\n        if (!FETCHING) {\n            FETCH.EXECUTE = false;\n            FETCH.LINK = LINK;\n            FETCH.DATA = RX_DATA;\n            FETCH();\n            FETCH.ENO = true;\n            LINK = FETCH.LINK;\n            RX_DATA = FETCH.DATA;\n        }\n    }\n    RX.ENABLE = ENABLE;\n    RX.CHANGED = CHANGED;\n    RX.NEXT = (!FETCHING) & (!NEW);\n    RX.KIND = 2;\n    RX.NETWORK = NETWORK;\n    RX.FLAGS = FLAGS;\n    RX.DEPTH = DEPTH;\n    RX.ID = PGN;\n    RX.MASK = TO_UDINT(SRC);\n    RX.RETRY = 0x00100302;\n    RX.LINK = LINK;\n    RX();\n    RX.ENO = true;\n    LINK = RX.LINK;\n    if ((RX.ACTIVE) & (!WAS_ACTIVE)) {\n        LAST_DROP = 0;\n    }\n    WAS_ACTIVE = RX.ACTIVE;\n    if (RX.NEW) {\n        R = RX.REC;\n        QUEUED = TO_UINT(LINK.at(R + 1));\n        DROPPED = DROPPED + TO_UDINT(((LINK.at(R + 2) - LAST_DROP)) & (0xFFFF));\n        LAST_DROP = LINK.at(R + 2);\n        OVERFLOW = ((LINK.at(R)) & (0x0004)) != 0;\n        TIMESTAMP = (((SHL(TO_ULINT(LINK.at(R + 3)), 48)) | (SHL(TO_ULINT(LINK.at(R + 4)), 32))) | (SHL(TO_ULINT(LINK.at(R + 5)), 16))) | (TO_ULINT(LINK.at(R + 6)));\n        RX_PGN = TO_UDINT(LINK.at(R + 7)) * 65536 + TO_UDINT(LINK.at(R + 8));\n        RX_SOURCE = TO_USINT(SHR(LINK.at(R + 9), 8));\n        RX_DESTINATION = TO_USINT((LINK.at(R + 9)) & (0x00FF));\n        RX_PRIORITY = TO_USINT(LINK.at(R + 10));\n        RX_LENGTH = TO_UINT(LINK.at(R + 11));\n        if (((LINK.at(R)) & (0x0001)) != 0) {\n            FETCHING = true;\n            FETCH.EXECUTE = true;\n            FETCH.OP = 10;\n            FETCH.NET = NETWORK;\n            FETCH.A0 = TO_WORD(RX.SLOT);\n            FETCH.A1 = 0;\n            FETCH.A2 = 0;\n            FETCH.A3 = 0;\n            FETCH.A4 = 0;\n            FETCH.A5 = 0;\n            FETCH.LENGTH = 0;\n            FETCH.RLEN_AT = 0;\n            FETCH.FETCH_MAX = 1785;\n            FETCH.LINK = LINK;\n            FETCH.DATA = RX_DATA;\n            FETCH();\n            FETCH.ENO = true;\n            LINK = FETCH.LINK;\n            RX_DATA = FETCH.DATA;\n        } else {\n            NEW = true;\n            for (I = 0; I <= 3; I++) {\n                RX_DATA.at(2 * I) = TO_BYTE(SHR(LINK.at(R + 12 + I), 8));\n                RX_DATA.at(2 * I + 1) = TO_BYTE(LINK.at(R + 12 + I));\n            }\n        }\n    }\n    if ((!RX.ACTIVE) & (FETCHING)) {\n        FETCHING = false;\n        FETCH.EXECUTE = false;\n        FETCH.LINK = LINK;\n        FETCH.DATA = RX_DATA;\n        FETCH();\n        FETCH.ENO = true;\n        LINK = FETCH.LINK;\n        RX_DATA = FETCH.DATA;\n    }\n    ACTIVE = RX.ACTIVE;\n    ERROR = (RX.ERROR) | (FERR != 0);\n    ERROR_ID = SEL(FERR != 0, RX.ERROR_ID, FERR);\n}\n",
