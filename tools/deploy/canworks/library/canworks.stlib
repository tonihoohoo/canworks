    {
      "name": "J1939_SEND",
      "kind": "functionBlock",
      "header": "class J1939_SEND {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_UDINT PGN;\n    IEC_USINT DESTINATION;\n    IEC_USINT PRIORITY;\n    IEC_UINT LENGTH;\n    IEC_TIME TIMEOUT;\n    // In-Out\n    Array1D<IEC_BYTE, 0, 1784> DATA;\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    CW_REQUEST X;\n    IEC_BOOL PREV;\n    IEC_UINT REFUSED;\n    IEC_UDINT MS;\n    IEC_USINT PRIO;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_SEND();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_SEND() = default;\n};\n",
      "cpp": "J1939_SEND::J1939_SEND() {\n    // Initialize variables\n}\n\nvoid J1939_SEND::operator()() {\n    MS = TO_UDINT(TIME_TO_MS(TIMEOUT));\n    if (MS > 65535) {\n        MS = 65535;\n    }\n    if (((EXECUTE) & (!PREV)) & (!X.BUSY)) {\n        REFUSED = 0;\n        if ((LENGTH > 1785) | (PRIORITY > 7)) {\n            REFUSED = 3;\n        }\n    } else if (!EXECUTE) {\n        REFUSED = 0;\n    }\n    PREV = EXECUTE;\n    PRIO = PRIORITY;\n    if (PRIO == 0) {\n        PRIO = 6;\n    }\n    X.EXECUTE = (EXECUTE) & (REFUSED == 0);\n    X.OP = 11;\n    X.NET = NETWORK;\n    X.A0 = TO_WORD(SHR(PGN, 16));\n    X.A1 = TO_WORD(PGN);\n    X.A2 = (SHL(TO_WORD(DESTINATION), 8)) | (TO_WORD(PRIO));\n    X.A3 = TO_WORD(LENGTH);\n    X.A4 = TO_WORD(MS);\n    X.A5 = 0;\n    X.LENGTH = LENGTH;\n    X.FETCH_MAX = 0;\n    X.LINK = LINK;\n    X.DATA = DATA;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    DATA = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = (X.ERROR) | (REFUSED != 0);\n    ERROR_ID = SEL(REFUSED != 0, X.ERROR_ID, REFUSED);\n}\n",
