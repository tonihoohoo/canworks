    {
      "name": "J1939_DTC_SPLIT",
      "kind": "functionBlock",
      "header": "class J1939_DTC_SPLIT {\npublic:\n    // Inputs\n    IEC_UDINT DTC;\n    // Outputs\n    IEC_UDINT SPN;\n    IEC_USINT FMI;\n    IEC_USINT OC;\n    IEC_BOOL CM;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_DTC_SPLIT();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_DTC_SPLIT() = default;\n};\n",
      "cpp": "J1939_DTC_SPLIT::J1939_DTC_SPLIT() {\n    // Initialize variables\n}\n\nvoid J1939_DTC_SPLIT::operator()() {\n    SPN = (DTC) & (0x7FFFF);\n    FMI = TO_USINT((SHR(DTC, 19)) & (0x1F));\n    OC = TO_USINT((SHR(DTC, 24)) & (0x7F));\n    CM = ((DTC) & (0x80000000)) != 0;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "J1939_ECU_INFO",
      "kind": "functionBlock",
      "header": "class J1939_ECU_INFO {\npublic:\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_USINT NETWORK;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL VALID;\n    IEC_USINT STATE;\n    IEC_USINT ADDRESS;\n    IEC_LWORD NAME;\n    IEC_UINT ECU_COUNT;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    IEC_INT P;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_ECU_INFO();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_ECU_INFO() = default;\n};\n",
      "cpp": "J1939_ECU_INFO::J1939_ECU_INFO() {\n    // Initialize variables\n}\n\nvoid J1939_ECU_INFO::operator()() {\n    ERROR_ID = 0;\n    VALID = false;\n    if (!ENABLE) {\n        ERROR = false;\n        return;\n    }\n    if (((LINK.at(21)) & (0x0001)) == 0) {\n        ERROR_ID = 20;\n    } else if ((((LINK.at(89)) & (0x0020)) == 0) | (NETWORK > 7)) {\n        ERROR_ID = 22;\n    } else {\n        P = 840 + 18 * TO_INT(NETWORK);\n        if (LINK.at(P + 17) == 0) {\n            ERROR_ID = 2;\n        } else if (SHR(LINK.at(P + 11), 8) == 0xFF) {\n            ERROR_ID = TO_UINT((LINK.at(P + 11)) & (0x00FF));\n        }\n    }\n    ERROR = ERROR_ID != 0;\n    if (ERROR) {\n        STATE = 3;\n        ADDRESS = 254;\n        return;\n    }\n    VALID = true;\n    STATE = TO_USINT(SHR(LINK.at(P + 11), 8));\n    ADDRESS = TO_USINT((LINK.at(P + 11)) & (0x00FF));\n    NAME = (((SHL(TO_LWORD(LINK.at(P + 12)), 48)) | (SHL(TO_LWORD(LINK.at(P + 13)), 32))) | (SHL(TO_LWORD(LINK.at(P + 14)), 16))) | (TO_LWORD(LINK.at(P + 15)));\n    ECU_COUNT = TO_UINT(LINK.at(P + 16));\n}\n",
      "deps": [
