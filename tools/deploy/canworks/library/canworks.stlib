          "library": "iec-std-functions",
          "name": "LEN"
        },
        {
          "library": "iec-std-functions",
          "name": "MID"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        }
      ]
    },
    {
      "name": "CAN_GET_BITS",
      "kind": "function",
      "header": "IEC_LINT CAN_GET_BITS(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT START_BIT, IEC_USINT BIT_LENGTH, IEC_BOOL MOTOROLA, IEC_BOOL SIGNED);",
      "cpp": "IEC_LINT CAN_GET_BITS(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT START_BIT, IEC_USINT BIT_LENGTH, IEC_BOOL MOTOROLA, IEC_BOOL SIGNED) {\n    IEC_LINT CAN_GET_BITS_result;\n    IEC_INT I;\n    IEC_INT POS;\n    IEC_LWORD BITV;\n    IEC_LWORD V;\n    V = 0;\n    POS = TO_INT(START_BIT);\n    for (I = 0; I <= TO_INT(BIT_LENGTH) - 1; I++) {\n        if ((POS >= 0) & (POS < 64)) {\n            BITV = TO_LWORD((SHR(DATA.at(POS / 8), TO_UINT(POS % 8))) & (0x01));\n        } else {\n            BITV = 0;\n        }\n        if (MOTOROLA) {\n            V = (SHL(V, 1)) | (BITV);\n            if (POS % 8 == 0) {\n                POS = POS + 15;\n            } else {\n                POS = POS - 1;\n            }\n        } else {\n            V = (V) | (SHL(BITV, TO_UINT(I)));\n            POS = POS + 1;\n        }\n    }\n    if (((SIGNED) & (BIT_LENGTH > 0)) & (BIT_LENGTH < 64)) {\n        if (((SHR(V, TO_UINT(BIT_LENGTH) - 1)) & (0x01)) == 1) {\n            V = (V) | (SHL(static_cast<IEC_LWORD>(0xFFFFFFFFFFFFFFFF), TO_UINT(BIT_LENGTH)));\n        }\n    }\n    CAN_GET_BITS_result = TO_LINT(V);\n    return CAN_GET_BITS_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CAN_GET_UINT16",
      "kind": "function",
      "header": "IEC_UINT CAN_GET_UINT16(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA);",
      "cpp": "IEC_UINT CAN_GET_UINT16(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA) {\n    IEC_UINT CAN_GET_UINT16_result;\n    IEC_INT I;\n    IEC_WORD V;\n    V = 0;\n    if (TO_INT(OFFSET) + 2 <= 8) {\n        for (I = 0; I <= 1; I++) {\n            if (MOTOROLA) {\n                V = (SHL(V, 8)) | (TO_WORD(DATA.at(TO_INT(OFFSET) + I)));\n            } else {\n                V = (V) | (SHL(TO_WORD(DATA.at(TO_INT(OFFSET) + I)), TO_UINT(8 * I)));\n            }\n        }\n    }\n    CAN_GET_UINT16_result = TO_UINT(V);\n    return CAN_GET_UINT16_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "oscat-basic",
          "name": "OFFSET"
        }
      ]
    },
    {
      "name": "CAN_GET_UINT32",
      "kind": "function",
      "header": "IEC_UDINT CAN_GET_UINT32(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA);",
      "cpp": "IEC_UDINT CAN_GET_UINT32(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA) {\n    IEC_UDINT CAN_GET_UINT32_result;\n    IEC_INT I;\n    IEC_DWORD V;\n    V = 0;\n    if (TO_INT(OFFSET) + 4 <= 8) {\n        for (I = 0; I <= 3; I++) {\n            if (MOTOROLA) {\n                V = (SHL(V, 8)) | (TO_DWORD(DATA.at(TO_INT(OFFSET) + I)));\n            } else {\n                V = (V) | (SHL(TO_DWORD(DATA.at(TO_INT(OFFSET) + I)), TO_UINT(8 * I)));\n            }\n        }\n    }\n    CAN_GET_UINT32_result = TO_UDINT(V);\n    return CAN_GET_UINT32_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "oscat-basic",
          "name": "OFFSET"
        }
      ]
    },
    {
      "name": "CAN_J1939_ID",
      "kind": "function",
      "header": "IEC_UDINT CAN_J1939_ID(IEC_USINT PRIORITY, IEC_UDINT PGN, IEC_USINT SOURCE, IEC_USINT DESTINATION);",
      "cpp": "IEC_UDINT CAN_J1939_ID(IEC_USINT PRIORITY, IEC_UDINT PGN, IEC_USINT SOURCE, IEC_USINT DESTINATION) {\n    IEC_UDINT CAN_J1939_ID_result;\n    IEC_UDINT P;\n    P = (PGN) & (0x3FFFF);\n    if (((SHR(P, 8)) & (0xFF)) < 240) {\n        P = (((P) & (0x3FF00))) | (TO_UDINT(DESTINATION));\n    }\n    CAN_J1939_ID_result = ((SHL((TO_UDINT(PRIORITY)) & (0x7), 26)) | (SHL(P, 8))) | (TO_UDINT(SOURCE));\n    return CAN_J1939_ID_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CAN_J1939_PGN",
      "kind": "function",
      "header": "IEC_UDINT CAN_J1939_PGN(IEC_UDINT ID);",
      "cpp": "IEC_UDINT CAN_J1939_PGN(IEC_UDINT ID) {\n    IEC_UDINT CAN_J1939_PGN_result;\n    IEC_UDINT P;\n    P = (SHR(ID, 8)) & (0x3FFFF);\n    if (((SHR(P, 8)) & (0xFF)) < 240) {\n        P = (P) & (0x3FF00);\n    }\n    CAN_J1939_PGN_result = P;\n    return CAN_J1939_PGN_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CAN_J1939_SOURCE",
      "kind": "function",
