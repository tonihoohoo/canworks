    {
      "name": "CW_LINK_SERVICE",
      "kind": "functionBlock",
      "header": "class CW_LINK_SERVICE {\npublic:\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    IEC_INT M;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CW_LINK_SERVICE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CW_LINK_SERVICE() = default;\n};\n",
      "cpp": "CW_LINK_SERVICE::CW_LINK_SERVICE() {\n    // Initialize variables\n}\n\nvoid CW_LINK_SERVICE::operator()() {\n    LINK.at(90) = LINK.at(90) + 1;\n    LINK.at(93) = LINK.at(92);\n    LINK.at(92) = 0;\n    if (((LINK.at(21)) & (0x0001)) == 0) {\n        for (M = 0; M <= 3; M++) {\n            LINK.at(144 + 144 * M + 1) = 0;\n            LINK.at(94 + M) = 0;\n        }\n        LINK.at(102) = 0;\n        LINK.at(103) = 0;\n        LINK.at(104) = 0;\n        LINK.at(105) = 0;\n        return;\n    }\n    for (M = 0; M <= 3; M++) {\n        if ((LINK.at(94 + M) != 0) & ((((LINK.at(90) - LINK.at(98 + M))) & (0xFFFF)) > 100)) {\n            LINK.at(94 + M) = 0;\n        }\n    }\n    if ((((LINK.at(89)) & (0x0010)) != 0) & (LINK.at(720) != LINK.at(105))) {\n        LINK.at(105) = LINK.at(720);\n        LINK.at(102) = LINK.at(720);\n        LINK.at(103) = LINK.at(721);\n        LINK.at(104) = LINK.at(722);\n    }\n}\n",
      "deps": []
    },
    {
      "name": "CW_MB_CALL",
      "kind": "functionBlock",
      "header": "class CW_MB_CALL {\npublic:\n    // Inputs\n    IEC_BOOL RUN;\n    IEC_BOOL SEND;\n    IEC_USINT OP;\n    IEC_USINT NET;\n    IEC_WORD A0;\n    IEC_WORD A1;\n    IEC_WORD A2;\n    IEC_WORD A3;\n    IEC_WORD A4;\n    IEC_WORD A5;\n    // Outputs\n    IEC_BOOL OWNED;\n    IEC_INT BASE;\n    IEC_BOOL WAITING;\n    IEC_BOOL ANSWERED;\n    IEC_UINT ERR;\n    IEC_BOOL LOST;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    IEC_WORD ME;\n    IEC_WORD TICKET;\n    IEC_INT M;\n    IEC_INT I;\n    IEC_INT N;\n    IEC_WORD COUNTER;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CW_MB_CALL();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CW_MB_CALL() = default;\n};\n",
      "cpp": "CW_MB_CALL::CW_MB_CALL() {\n    // Initialize variables\n}\n\nvoid CW_MB_CALL::operator()() {\n    if (ME == 0) {\n        LINK.at(24) = LINK.at(24) + 1;\n        ME = LINK.at(24);\n    }\n    ANSWERED = false;\n    LOST = ((LINK.at(21)) & (0x0001)) == 0;\n    if ((OWNED) & (LINK.at(94 + M) != ME)) {\n        LOST = true;\n        OWNED = false;\n    }\n    if ((!RUN) | (LOST)) {\n        if ((OWNED) & (LINK.at(94 + M) == ME)) {\n            LINK.at(94 + M) = 0;\n        }\n        OWNED = false;\n        WAITING = false;\n        TICKET = 0;\n        return;\n    }\n    if (!OWNED) {\n        if (TICKET == 0) {\n            LINK.at(91) = LINK.at(91) + 1;\n            if (LINK.at(91) == 0) {\n                LINK.at(91) = 1;\n            }\n            TICKET = LINK.at(91);\n        }\n        N = TO_INT((LINK.at(89)) & (0x0007));\n        if (N > 4) {\n            N = 4;\n        }\n        if (((LINK.at(93) == 0) | (TICKET == LINK.at(93))) | ((((TICKET - LINK.at(93))) & (0x8000)) != 0)) {\n            for (I = 0; I <= N - 1; I++) {\n                if ((!OWNED) & (LINK.at(94 + I) == 0)) {\n                    M = I;\n                    OWNED = true;\n                }\n            }\n        }\n        if (OWNED) {\n            LINK.at(94 + M) = ME;\n            BASE = 144 + 144 * M;\n            WAITING = false;\n            TICKET = 0;\n        } else if ((LINK.at(92) == 0) | ((((TICKET - LINK.at(92))) & (0x8000)) != 0)) {\n            LINK.at(92) = TICKET;\n        }\n    }\n    if (!OWNED) {\n        return;\n    }\n    LINK.at(98 + M) = LINK.at(90);\n    if ((SEND) & (!WAITING)) {\n        COUNTER = LINK.at(BASE) + 1;\n        if (COUNTER == LINK.at(BASE + 72)) {\n            COUNTER = COUNTER + 1;\n        }\n        LINK.at(BASE) = COUNTER;\n        LINK.at(BASE + 1) = (SHL(TO_WORD(OP), 8)) | (TO_WORD(NET));\n        LINK.at(BASE + 2) = A0;\n        LINK.at(BASE + 3) = A1;\n        LINK.at(BASE + 4) = A2;\n        LINK.at(BASE + 5) = A3;\n        LINK.at(BASE + 6) = A4;\n        LINK.at(BASE + 7) = A5;\n        WAITING = true;\n    } else if (((WAITING) & (LINK.at(BASE + 72) == COUNTER)) & (SHR(LINK.at(BASE + 73), 8) >= 2)) {\n        WAITING = false;\n        ANSWERED = true;\n        ERR = TO_UINT((LINK.at(BASE + 73)) & (0x00FF));\n    }\n}\n",
      "deps": [
