      "name": "CO_SDO_READ_STRING",
      "kind": "functionBlock",
      "header": "class CO_SDO_READ_STRING {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    IEC_STRING VALUE;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    CW_SDO_XFER X;\n    Array1D<IEC_BYTE, 0, 1023> BUF;\n    IEC_BOOL WAS;\n    IEC_BOOL BAD;\n    IEC_INT NCHARS;\n    IEC_INT I;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_READ_STRING();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_READ_STRING() = default;\n};\n",
      "cpp": "CO_SDO_READ_STRING::CO_SDO_READ_STRING() {\n    // Initialize variables\n}\n\nvoid CO_SDO_READ_STRING::operator()() {\n    X.EXECUTE = EXECUTE;\n    X.WRITE = false;\n    X.NETWORK = NETWORK;\n    X.NODE = NODE;\n    X.INDEX = INDEX;\n    X.SUBINDEX = SUBINDEX;\n    X.TIMEOUT = TIMEOUT;\n    X.KIND = 2;\n    X.MAX_SIZE = 0xFFFFFFFF;\n    X.FETCH_MAX = 255;\n    X.LINK = LINK;\n    X.DATA = BUF;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUF = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = X.ERROR;\n    ERROR_ID = X.ERROR_ID;\n    ABORT_CODE = X.ABORT_CODE;\n    if ((X.DONE) & (!WAS)) {\n        NCHARS = TO_INT(X.GOT);\n        for (I = TO_INT(X.GOT) - 1; I >= 0; I += -1) {\n            if (BUF.at(I) == 0) {\n                NCHARS = I;\n            }\n        }\n        BAD = NCHARS > 254;\n        if (!BAD) {\n            VALUE = \"\";\n            for (I = 0; I <= NCHARS - 1; I++) {\n                VALUE = CONCAT(VALUE, CW_CHAR(BUF.at(I)));\n            }\n        }\n    }\n    WAS = X.DONE;\n    if ((X.DONE) & (BAD)) {\n        DONE = false;\n        ERROR = true;\n        ERROR_ID = 7;\n    }\n}\n",
      "deps": [
        {
          "library": "canworks",
          "name": "CW_CHAR"
        },
        {
          "library": "canworks",
          "name": "CW_SDO_XFER"
        },
        {
          "library": "iec-std-functions",
          "name": "CONCAT"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        }
      ]
    },
    {
      "name": "CO_SDO_WRITE_BYTES",
      "kind": "functionBlock",
      "header": "class CO_SDO_WRITE_BYTES {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_TIME TIMEOUT;\n    IEC_UINT SIZE;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    // In-Out\n    Array1D<IEC_BYTE, 0, 1023> BUFFER;\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    CW_SDO_XFER X;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_WRITE_BYTES();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_WRITE_BYTES() = default;\n};\n",
      "cpp": "CO_SDO_WRITE_BYTES::CO_SDO_WRITE_BYTES() {\n    // Initialize variables\n}\n\nvoid CO_SDO_WRITE_BYTES::operator()() {\n    X.EXECUTE = EXECUTE;\n    X.WRITE = true;\n    X.NETWORK = NETWORK;\n    X.NODE = NODE;\n    X.INDEX = INDEX;\n    X.SUBINDEX = SUBINDEX;\n    X.TIMEOUT = TIMEOUT;\n    X.KIND = 3;\n    X.LENGTH = SIZE;\n    X.LINK = LINK;\n    X.DATA = BUFFER;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUFFER = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = X.ERROR;\n    ERROR_ID = X.ERROR_ID;\n    ABORT_CODE = X.ABORT_CODE;\n}\n",
      "deps": [
