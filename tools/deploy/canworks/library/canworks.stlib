        }
      ]
    },
    {
      "name": "CO_SDO_WRITE_REAL",
      "kind": "functionBlock",
      "header": "class CO_SDO_WRITE_REAL {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_TIME TIMEOUT;\n    IEC_LREAL VALUE;\n    IEC_USINT SIZE;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    CW_SDO_XFER X;\n    Array1D<IEC_BYTE, 0, 1023> BUF;\n    IEC_BOOL PREV;\n    IEC_LWORD BITS;\n    IEC_INT I;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_WRITE_REAL();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_WRITE_REAL() = default;\n};\n",
      "cpp": "CO_SDO_WRITE_REAL::CO_SDO_WRITE_REAL() {\n    // Initialize variables\n}\n\nvoid CO_SDO_WRITE_REAL::operator()() {\n    if (((EXECUTE) & (!PREV)) & (!X.BUSY)) {\n        BITS = CW_LREAL_TO_LWORD(VALUE);\n        for (I = 0; I <= 7; I++) {\n            BUF.at(I) = TO_BYTE(SHR(BITS, 8 * I));\n        }\n    }\n    PREV = EXECUTE;\n    X.EXECUTE = EXECUTE;\n    X.WRITE = true;\n    X.NETWORK = NETWORK;\n    X.NODE = NODE;\n    X.INDEX = INDEX;\n    X.SUBINDEX = SUBINDEX;\n    X.TIMEOUT = TIMEOUT;\n    X.KIND = 1;\n    X.SIZE = SIZE;\n    X.LENGTH = 8;\n    X.LINK = LINK;\n    X.DATA = BUF;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUF = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = X.ERROR;\n    ERROR_ID = X.ERROR_ID;\n    ABORT_CODE = X.ABORT_CODE;\n}\n",
      "deps": [
        {
          "library": "canworks",
          "name": "CW_LREAL_TO_LWORD"
        },
        {
          "library": "canworks",
          "name": "CW_SDO_XFER"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        }
      ]
    },
    {
      "name": "CO_SDO_WRITE_STRING",
      "kind": "functionBlock",
      "header": "class CO_SDO_WRITE_STRING {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_TIME TIMEOUT;\n    IEC_STRING VALUE;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    CW_SDO_XFER X;\n    Array1D<IEC_BYTE, 0, 1023> BUF;\n    IEC_BOOL PREV;\n    IEC_INT NCHARS;\n    IEC_INT I;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_WRITE_STRING();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_WRITE_STRING() = default;\n};\n",
      "cpp": "CO_SDO_WRITE_STRING::CO_SDO_WRITE_STRING() {\n    // Initialize variables\n}\n\nvoid CO_SDO_WRITE_STRING::operator()() {\n    if (((EXECUTE) & (!PREV)) & (!X.BUSY)) {\n        NCHARS = LEN(VALUE);\n        if (NCHARS > 254) {\n            NCHARS = 254;\n        }\n        for (I = 1; I <= NCHARS; I++) {\n            BUF.at(I - 1) = CW_CHAR_CODE(MID(VALUE, 1, I));\n        }\n    }\n    PREV = EXECUTE;\n    X.EXECUTE = EXECUTE;\n    X.WRITE = true;\n    X.NETWORK = NETWORK;\n    X.NODE = NODE;\n    X.INDEX = INDEX;\n    X.SUBINDEX = SUBINDEX;\n    X.TIMEOUT = TIMEOUT;\n    X.KIND = 2;\n    X.LENGTH = TO_UINT(NCHARS);\n    X.LINK = LINK;\n    X.DATA = BUF;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUF = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = X.ERROR;\n    ERROR_ID = X.ERROR_ID;\n    ABORT_CODE = X.ABORT_CODE;\n}\n",
      "deps": [
        {
          "library": "canworks",
          "name": "CW_CHAR_CODE"
        },
        {
          "library": "canworks",
          "name": "CW_SDO_XFER"
