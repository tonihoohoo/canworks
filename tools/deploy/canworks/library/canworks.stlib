    {
      "name": "J1939_DM_READ",
      "kind": "functionBlock",
      "header": "class J1939_DM_READ {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT SOURCE;\n    IEC_BOOL PREVIOUS;\n    IEC_TIME TIMEOUT;\n    // In-Out\n    Array1D<IEC_UDINT, 0, 31> DTCS;\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_BYTE LAMPS;\n    IEC_BYTE FLASH;\n    IEC_UINT COUNT;\n    IEC_TIME AGE;\n    // Local variables\n    CW_REQUEST X;\n    IEC_BOOL PREV;\n    IEC_UINT REFUSED;\n    IEC_UDINT MS;\n    Array1D<IEC_BYTE, 0, 1784> BUF;\n    IEC_BOOL WAS;\n    IEC_INT I;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_DM_READ();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_DM_READ() = default;\n};\n",
      "cpp": "J1939_DM_READ::J1939_DM_READ() {\n    // Initialize variables\n}\n\nvoid J1939_DM_READ::operator()() {\n    MS = TO_UDINT(TIME_TO_MS(TIMEOUT));\n    if (MS > 65535) {\n        MS = 65535;\n    }\n    if (((EXECUTE) & (!PREV)) & (!X.BUSY)) {\n        REFUSED = 0;\n        if (SOURCE > 253) {\n            REFUSED = 3;\n        }\n    } else if (!EXECUTE) {\n        REFUSED = 0;\n    }\n    PREV = EXECUTE;\n    X.EXECUTE = (EXECUTE) & (REFUSED == 0);\n    X.OP = 13;\n    X.NET = NETWORK;\n    X.A0 = TO_WORD(SOURCE);\n    X.A1 = SEL(PREVIOUS, static_cast<IEC_WORD>(0), static_cast<IEC_WORD>(1));\n    X.A2 = TO_WORD(MS);\n    X.A3 = 0;\n    X.A4 = 0;\n    X.A5 = 0;\n    X.LENGTH = 0;\n    X.FETCH_MAX = 128;\n    X.LINK = LINK;\n    X.DATA = BUF;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUF = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = (X.ERROR) | (REFUSED != 0);\n    ERROR_ID = SEL(REFUSED != 0, X.ERROR_ID, REFUSED);\n    if ((X.DONE) & (!WAS)) {\n        LAMPS = TO_BYTE(SHR(X.R0, 8));\n        FLASH = TO_BYTE(X.R0);\n        COUNT = TO_UINT(X.R1);\n        AGE = TO_TIME(TIME_FROM_MS(TO_UDINT(X.R2) * 65536 + TO_UDINT(X.R3)));\n        for (I = 0; I <= 31; I++) {\n            DTCS.at(I) = (((SHL(TO_UDINT(BUF.at(4 * I)), 24)) | (SHL(TO_UDINT(BUF.at(4 * I + 1)), 16))) | (SHL(TO_UDINT(BUF.at(4 * I + 2)), 8))) | (TO_UDINT(BUF.at(4 * I + 3)));\n        }\n    }\n    WAS = X.DONE;\n}\n",
