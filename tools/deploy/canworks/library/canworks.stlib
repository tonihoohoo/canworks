      "name": "CAN_RECEIVE",
      "kind": "functionBlock",
      "header": "class CAN_RECEIVE {\npublic:\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_USINT NETWORK;\n    IEC_UDINT ID;\n    IEC_UDINT MASK;\n    IEC_BOOL ANY;\n    IEC_BOOL EXTENDED;\n    IEC_UINT DEPTH;\n    // In-Out\n    Array1D<IEC_BYTE, 0, 7> RX_DATA;\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL ACTIVE;\n    IEC_BOOL NEW;\n    IEC_UDINT RX_ID;\n    IEC_BOOL RX_EXTENDED;\n    IEC_BOOL RX_RTR;\n    IEC_USINT RX_DLC;\n    IEC_ULINT TIMESTAMP;\n    IEC_UINT QUEUED;\n    IEC_BOOL OVERFLOW;\n    IEC_UDINT DROPPED;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    CW_RX RX;\n    IEC_BOOL PREV;\n    IEC_BOOL WAS_ACTIVE;\n    IEC_WORD LAST_DROP;\n    IEC_UDINT ID_MASK;\n    IEC_INT R;\n    IEC_INT I;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CAN_RECEIVE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CAN_RECEIVE() = default;\n};\n",
      "cpp": "CAN_RECEIVE::CAN_RECEIVE() {\n    // Initialize variables\n}\n\nvoid CAN_RECEIVE::operator()() {\n    if ((ENABLE) & (!PREV)) {\n        QUEUED = 0;\n        OVERFLOW = false;\n        DROPPED = 0;\n    }\n    PREV = ENABLE;\n    if (ANY) {\n        ID_MASK = 0;\n    } else if (MASK != 0) {\n        ID_MASK = MASK;\n    } else if (EXTENDED) {\n        ID_MASK = 0x1FFFFFFF;\n    } else {\n        ID_MASK = 0x7FF;\n    }\n    RX.ENABLE = ENABLE;\n    RX.CHANGED = false;\n    RX.NEXT = true;\n    RX.KIND = 1;\n    RX.NETWORK = NETWORK;\n    RX.FLAGS = SEL(EXTENDED, static_cast<IEC_USINT>(0), static_cast<IEC_USINT>(1));\n    RX.DEPTH = DEPTH;\n    RX.ID = ID;\n    RX.MASK = ID_MASK;\n    RX.RETRY = 0x00100102;\n    RX.LINK = LINK;\n    RX();\n    RX.ENO = true;\n    LINK = RX.LINK;\n    if ((RX.ACTIVE) & (!WAS_ACTIVE)) {\n        LAST_DROP = 0;\n    }\n    WAS_ACTIVE = RX.ACTIVE;\n    NEW = RX.NEW;\n    if (NEW) {\n        R = RX.REC;\n        QUEUED = TO_UINT(LINK.at(R + 1));\n        DROPPED = DROPPED + TO_UDINT(((LINK.at(R + 2) - LAST_DROP)) & (0xFFFF));\n        LAST_DROP = LINK.at(R + 2);\n        OVERFLOW = ((LINK.at(R)) & (0x0004)) != 0;\n        TIMESTAMP = (((SHL(TO_ULINT(LINK.at(R + 3)), 48)) | (SHL(TO_ULINT(LINK.at(R + 4)), 32))) | (SHL(TO_ULINT(LINK.at(R + 5)), 16))) | (TO_ULINT(LINK.at(R + 6)));\n        RX_ID = TO_UDINT(LINK.at(R + 7)) * 65536 + TO_UDINT(LINK.at(R + 8));\n        RX_EXTENDED = ((LINK.at(R + 9)) & (0x0100)) != 0;\n        RX_RTR = ((LINK.at(R + 9)) & (0x0200)) != 0;\n        RX_DLC = TO_USINT((LINK.at(R + 9)) & (0x00FF));\n        for (I = 0; I <= 3; I++) {\n            RX_DATA.at(2 * I) = TO_BYTE(SHR(LINK.at(R + 10 + I), 8));\n            RX_DATA.at(2 * I + 1) = TO_BYTE(LINK.at(R + 10 + I));\n        }\n    }\n    ACTIVE = RX.ACTIVE;\n    ERROR = RX.ERROR;\n    ERROR_ID = RX.ERROR_ID;\n}\n",
