      "name": "CO_SDO_READ_BYTES",
      "kind": "functionBlock",
      "header": "class CO_SDO_READ_BYTES {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    IEC_UINT SIZE;\n    // In-Out\n    Array1D<IEC_BYTE, 0, 1023> BUFFER;\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    CW_SDO_XFER X;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_READ_BYTES();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_READ_BYTES() = default;\n};\n",
      "cpp": "CO_SDO_READ_BYTES::CO_SDO_READ_BYTES() {\n    // Initialize variables\n}\n\nvoid CO_SDO_READ_BYTES::operator()() {\n    X.EXECUTE = EXECUTE;\n    X.WRITE = false;\n    X.NETWORK = NETWORK;\n    X.NODE = NODE;\n    X.INDEX = INDEX;\n    X.SUBINDEX = SUBINDEX;\n    X.TIMEOUT = TIMEOUT;\n    X.KIND = 3;\n    X.MAX_SIZE = 1024;\n    X.FETCH_MAX = 1024;\n    X.LINK = LINK;\n    X.DATA = BUFFER;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUFFER = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = X.ERROR;\n    ERROR_ID = X.ERROR_ID;\n    ABORT_CODE = X.ABORT_CODE;\n    if (X.RSIZE > 65535) {\n        SIZE = 65535;\n    } else {\n        SIZE = TO_UINT(X.RSIZE);\n    }\n}\n",
