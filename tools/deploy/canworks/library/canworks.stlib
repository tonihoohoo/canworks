    {
      "name": "CW_REQUEST",
      "kind": "functionBlock",
      "header": "class CW_REQUEST {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT OP;\n    IEC_USINT NET;\n    IEC_WORD A0;\n    IEC_WORD A1;\n    IEC_WORD A2;\n    IEC_WORD A3;\n    IEC_WORD A4;\n    IEC_WORD A5;\n    IEC_UINT LENGTH;\n    IEC_INT RLEN_AT;\n    IEC_UINT FETCH_MAX;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_WORD R0;\n    IEC_WORD R1;\n    IEC_WORD R2;\n    IEC_WORD R3;\n    IEC_WORD R4;\n    IEC_WORD R5;\n    IEC_UINT GOT;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    Array1D<IEC_BYTE, 0, 1784> DATA;\n    // Local variables\n    CW_MB_CALL MB;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_UINT OFFSET;\n    IEC_UINT WANT;\n    IEC_INT N;\n    IEC_INT K;\n    IEC_INT B;\n    IEC_UINT ERR;\n    IEC_BOOL FIN;\n    IEC_WORD RLEN;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CW_REQUEST();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CW_REQUEST() = default;\n};\n",
      "cpp": "CW_REQUEST::CW_REQUEST()\n    : RLEN_AT(6)\n{\n    // Initialize variables\n}\n\nvoid CW_REQUEST::operator()() {\n    if ((PHASE == 4) & (!EXECUTE)) {\n        PHASE = 0;\n        DONE = false;\n        ERROR = false;\n    }\n    ERR = 0;\n    FIN = false;\n    if (((PHASE == 0) & (EXECUTE)) & (!PREV)) {\n        DONE = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        GOT = 0;\n        OFFSET = 0;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (((LINK.at(89)) & (0x0007)) == 0) {\n            ERR = 22;\n        } else if (LENGTH > 128) {\n            PHASE = 1;\n        } else {\n            PHASE = 2;\n        }\n    }\n    if ((PHASE >= 1) & (PHASE <= 3)) {\n        MB.RUN = true;\n        MB.SEND = false;\n        MB.LINK = LINK;\n        MB();\n        MB.ENO = true;\n        LINK = MB.LINK;\n        B = MB.BASE;\n        if (MB.LOST) {\n            ERR = 20;\n        } else if ((MB.ANSWERED) & (MB.ERR != 0)) {\n            ERR = MB.ERR;\n            if (PHASE == 2) {\n                R0 = LINK.at(B + 74);\n                R1 = LINK.at(B + 75);\n                R2 = LINK.at(B + 76);\n                R3 = LINK.at(B + 77);\n                R4 = LINK.at(B + 78);\n                R5 = LINK.at(B + 79);\n            }\n        } else if ((MB.ANSWERED) & (PHASE == 1)) {\n            OFFSET = OFFSET + 128;\n            if (OFFSET >= LENGTH) {\n                PHASE = 2;\n            }\n        } else if (MB.ANSWERED) {\n            if (PHASE == 2) {\n                R0 = LINK.at(B + 74);\n                R1 = LINK.at(B + 75);\n                R2 = LINK.at(B + 76);\n                R3 = LINK.at(B + 77);\n                R4 = LINK.at(B + 78);\n                R5 = LINK.at(B + 79);\n                WANT = FETCH_MAX;\n                if ((RLEN_AT >= 0) & (RLEN_AT <= 5)) {\n                    RLEN = LINK.at(B + 74 + RLEN_AT);\n                    if (TO_UINT(RLEN) < WANT) {\n                        WANT = TO_UINT(RLEN);\n                    }\n                } else if (WANT > 128) {\n                    WANT = 128;\n                }\n                if (WANT > 1785) {\n                    WANT = 1785;\n                }\n            }\n            N = TO_INT(WANT - GOT);\n            if (N > 128) {\n                N = 128;\n            }\n            for (K = 0; K <= N - 1; K++) {\n                if ((K % 2) == 0) {\n                    DATA.at(TO_INT(GOT) + K) = TO_BYTE(SHR(LINK.at(B + 80 + K / 2), 8));\n                } else {\n                    DATA.at(TO_INT(GOT) + K) = TO_BYTE(LINK.at(B + 80 + K / 2));\n                }\n            }\n            GOT = GOT + TO_UINT(N);\n            if (GOT >= WANT) {\n                FIN = true;\n            } else {\n                PHASE = 3;\n            }\n        }\n        if ((((ERR == 0) & (!FIN)) & (MB.OWNED)) & (!MB.WAITING)) {\n            if ((PHASE == 1) | (((PHASE == 2) & (LENGTH <= 128)))) {\n                N = TO_INT(LENGTH - OFFSET);\n                if (N > 128) {\n                    N = 128;\n                }\n                for (K = 0; K <= 63; K++) {\n                    LINK.at(B + 8 + K) = 0;\n                }\n                for (K = 0; K <= N - 1; K++) {\n                    if ((K % 2) == 0) {\n                        LINK.at(B + 8 + K / 2) = SHL(TO_WORD(DATA.at(TO_INT(OFFSET) + K)), 8);\n                    } else {\n                        LINK.at(B + 8 + K / 2) = (LINK.at(B + 8 + K / 2)) | (TO_WORD(DATA.at(TO_INT(OFFSET) + K)));\n                    }\n                }\n            }\n            if (PHASE == 1) {\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = 1;\n                MB.NET = 0;\n                MB.A0 = TO_WORD(OFFSET);\n                MB.A1 = TO_WORD(N);\n                MB.A2 = 0;\n                MB.A3 = 0;\n                MB.A4 = 0;\n                MB.A5 = 0;\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            } else if (PHASE == 2) {\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = OP;\n                MB.NET = NET;\n                MB.A0 = A0;\n                MB.A1 = A1;\n                MB.A2 = A2;\n                MB.A3 = A3;\n                MB.A4 = A4;\n                MB.A5 = A5;\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            } else {\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = 2;\n                MB.NET = 0;\n                MB.A0 = TO_WORD(GOT);\n                MB.A1 = 0;\n                MB.A2 = 0;\n                MB.A3 = 0;\n                MB.A4 = 0;\n                MB.A5 = 0;\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            }\n        }\n    }\n    if ((ERR != 0) | (FIN)) {\n        PHASE = 4;\n        DONE = FIN;\n        ERROR = ERR != 0;\n        ERROR_ID = ERR;\n        MB.RUN = false;\n        MB.LINK = LINK;\n        MB();\n        MB.ENO = true;\n        LINK = MB.LINK;\n    }\n    BUSY = (PHASE >= 1) & (PHASE <= 3);\n    PREV = EXECUTE;\n}\n",
