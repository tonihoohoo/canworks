    {
      "name": "CW_RX",
      "kind": "functionBlock",
      "header": "class CW_RX {\npublic:\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_BOOL CHANGED;\n    IEC_BOOL NEXT;\n    IEC_USINT KIND;\n    IEC_USINT NETWORK;\n    IEC_USINT FLAGS;\n    IEC_UINT DEPTH;\n    IEC_UDINT ID;\n    IEC_UDINT MASK;\n    IEC_DWORD RETRY;\n    // Outputs\n    IEC_BOOL ACTIVE;\n    IEC_BOOL NEW;\n    IEC_INT REC;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_INT SLOT;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    CW_MB_CALL MB;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_WORD GEN;\n    IEC_WORD TICK0;\n    IEC_WORD SEQ;\n    IEC_INT POS;\n    IEC_INT PW;\n    IEC_WORD BIT;\n    IEC_WORD SHOWN;\n    IEC_WORD HDR;\n    IEC_INT SIZE;\n    IEC_BOOL FRESH;\n    IEC_BOOL FOUND;\n    IEC_UINT ERR;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CW_RX();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CW_RX() = default;\n};\n",
      "cpp": "CW_RX::CW_RX() {\n    // Initialize variables\n}\n\nvoid CW_RX::operator()() {\n    NEW = false;\n    ERR = 0;\n    if ((ENABLE) & (!PREV)) {\n        ERROR = false;\n        ERROR_ID = 0;\n    }\n    if ((((LINK.at(21)) & (0x0001)) == 0) & (PHASE != 0)) {\n        MB.RUN = false;\n        MB.LINK = LINK;\n        MB();\n        MB.ENO = true;\n        LINK = MB.LINK;\n        PHASE = 0;\n        if (ENABLE) {\n            ERR = 20;\n        }\n    }\n    if (PHASE == 2) {\n        FRESH = (((LINK.at(724) - TICK0)) & (0x8000)) == 0;\n        SHOWN = (SHR(LINK.at(725 + SLOT / 2), 8 * (1 - SLOT % 2))) & (0x00FF);\n        if ((FRESH) & (SHOWN != GEN)) {\n            PHASE = 0;\n            ERR = 8;\n        } else if ((!ENABLE) | (CHANGED)) {\n            PHASE = 3;\n        }\n    }\n    if ((PHASE == 2) | (PHASE == 3)) {\n        PW = 104 - SLOT / 16;\n        BIT = SHL(static_cast<IEC_WORD>(1), SLOT % 16);\n    }\n    if (PHASE == 3) {\n        LINK.at(PW) = (LINK.at(PW)) & (~BIT);\n    }\n    if ((((PHASE == 0) & (ENABLE)) & (ERR == 0)) & (NOT((ERROR) & (((SHR(RETRY, TO_INT(ERROR_ID))) & (0x00000001)) == 0)))) {\n        ERROR = false;\n        ERROR_ID = 0;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if ((((LINK.at(89)) & (0x0007)) == 0) | (((LINK.at(89)) & (0x0010)) == 0)) {\n            ERR = 22;\n        } else {\n            PHASE = 1;\n        }\n    }\n    if ((PHASE == 1) | (PHASE == 3)) {\n        MB.RUN = true;\n        MB.SEND = false;\n        MB.LINK = LINK;\n        MB();\n        MB.ENO = true;\n        LINK = MB.LINK;\n        if (MB.LOST) {\n            PHASE = 0;\n            ERR = SEL(ENABLE, static_cast<IEC_UINT>(0), static_cast<IEC_UINT>(20));\n        } else if ((MB.ANSWERED) & (PHASE == 1)) {\n            if (MB.ERR != 0) {\n                ERR = MB.ERR;\n                PHASE = 0;\n            } else {\n                SLOT = TO_INT(LINK.at(MB.BASE + 74));\n                GEN = LINK.at(MB.BASE + 75);\n                TICK0 = LINK.at(MB.BASE + 76);\n                SEQ = 0;\n                POS = 0;\n                PHASE = 2;\n            }\n            MB.RUN = false;\n            MB.LINK = LINK;\n            MB();\n            MB.ENO = true;\n            LINK = MB.LINK;\n        } else if (MB.ANSWERED) {\n            PHASE = 0;\n            MB.RUN = false;\n            MB.LINK = LINK;\n            MB();\n            MB.ENO = true;\n            LINK = MB.LINK;\n        } else if ((MB.OWNED) & (!MB.WAITING)) {\n            if (PHASE == 1) {\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = 8;\n                MB.NET = NETWORK;\n                MB.A0 = (SHL(TO_WORD(KIND), 8)) | (TO_WORD(FLAGS));\n                MB.A1 = TO_WORD(DEPTH);\n                MB.A2 = TO_WORD(SHR(ID, 16));\n                MB.A3 = TO_WORD(ID);\n                MB.A4 = TO_WORD(SHR(MASK, 16));\n                MB.A5 = TO_WORD(MASK);\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            } else {\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = 9;\n                MB.NET = NETWORK;\n                MB.A0 = TO_WORD(SLOT);\n                MB.A1 = 0;\n                MB.A2 = 0;\n                MB.A3 = 0;\n                MB.A4 = 0;\n                MB.A5 = 0;\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            }\n        }\n    }\n    if ((PHASE == 2) & (NEXT)) {\n        PW = 104 - SLOT / 16;\n        BIT = SHL(static_cast<IEC_WORD>(1), SLOT % 16);\n        if (LINK.at(720) != SEQ) {\n            SEQ = LINK.at(720);\n            POS = 741;\n        }\n        FRESH = (((LINK.at(724) - TICK0)) & (0x8000)) == 0;\n        if (((FRESH) & (((LINK.at(722 - SLOT / 16)) & (BIT)) != 0)) & (((LINK.at(PW)) & (BIT)) != 0)) {\n            FOUND = false;\n            while (((!FOUND) & (POS < 741 + TO_INT(LINK.at(723)))) & (POS < 840)) {\n                HDR = LINK.at(POS);\n                SIZE = 7;\n                switch (TO_INT((SHR(HDR, 4)) & (0x000F))) {\n                    case 1:\n                        SIZE = 14;\n                        break;\n                    case 2:\n                        SIZE = 16;\n                        break;\n                    case 3:\n                        SIZE = 12;\n                        break;\n                }\n                if (TO_INT(SHR(HDR, 8)) == SLOT) {\n                    FOUND = true;\n                    REC = POS;\n                    NEW = true;\n                }\n                POS = POS + SIZE;\n            }\n            if (!FOUND) {\n                LINK.at(PW) = (LINK.at(PW)) & (~BIT);\n            }\n        }\n    }\n    if (ERR != 0) {\n        ERROR = true;\n        ERROR_ID = ERR;\n    }\n    ACTIVE = PHASE == 2;\n    PREV = ENABLE;\n}\n",
