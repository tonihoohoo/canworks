      "cpp": "IEC_USINT CAN_J1939_SOURCE(IEC_UDINT ID) {\n    IEC_USINT CAN_J1939_SOURCE_result;\n    CAN_J1939_SOURCE_result = TO_USINT((ID) & (0xFF));\n    return CAN_J1939_SOURCE_result;\n}\n",
      "deps": []
    },
    {
      "name": "CAN_SET_BITS",
      "kind": "function",
      "header": "IEC_BOOL CAN_SET_BITS(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT START_BIT, IEC_USINT BIT_LENGTH, IEC_BOOL MOTOROLA, IEC_LINT VALUE);",
      "cpp": "IEC_BOOL CAN_SET_BITS(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT START_BIT, IEC_USINT BIT_LENGTH, IEC_BOOL MOTOROLA, IEC_LINT VALUE) {\n    IEC_BOOL CAN_SET_BITS_result;\n    IEC_INT I;\n    IEC_INT POS;\n    IEC_INT SHIFT;\n    IEC_LWORD V;\n    IEC_BYTE B;\n    POS = TO_INT(START_BIT);\n    for (I = 0; I <= TO_INT(BIT_LENGTH) - 1; I++) {\n        if ((POS < 0) | (POS > 63)) {\n            CAN_SET_BITS_result = false;\n            return CAN_SET_BITS_result;\n        }\n        if (MOTOROLA) {\n            if (POS % 8 == 0) {\n                POS = POS + 15;\n            } else {\n                POS = POS - 1;\n            }\n        } else {\n            POS = POS + 1;\n        }\n    }\n    V = TO_LWORD(VALUE);\n    POS = TO_INT(START_BIT);\n    for (I = 0; I <= TO_INT(BIT_LENGTH) - 1; I++) {\n        if (MOTOROLA) {\n            SHIFT = TO_INT(BIT_LENGTH) - 1 - I;\n        } else {\n            SHIFT = I;\n        }\n        B = SHL(static_cast<IEC_BYTE>(1), TO_UINT(POS % 8));\n        if (((SHR(V, TO_UINT(SHIFT))) & (0x01)) == 1) {\n            DATA.at(POS / 8) = (DATA.at(POS / 8)) | (B);\n        } else {\n            DATA.at(POS / 8) = (DATA.at(POS / 8)) & (~B);\n        }\n        if (MOTOROLA) {\n            if (POS % 8 == 0) {\n                POS = POS + 15;\n            } else {\n                POS = POS - 1;\n            }\n        } else {\n            POS = POS + 1;\n        }\n    }\n    CAN_SET_BITS_result = true;\n    return CAN_SET_BITS_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CAN_SET_UINT16",
      "kind": "function",
      "header": "IEC_BOOL CAN_SET_UINT16(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA, IEC_UINT VALUE);",
      "cpp": "IEC_BOOL CAN_SET_UINT16(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA, IEC_UINT VALUE) {\n    IEC_BOOL CAN_SET_UINT16_result;\n    IEC_INT I;\n    IEC_WORD V;\n    if (TO_INT(OFFSET) + 2 > 8) {\n        CAN_SET_UINT16_result = false;\n        return CAN_SET_UINT16_result;\n    }\n    V = TO_WORD(VALUE);\n    for (I = 0; I <= 1; I++) {\n        if (MOTOROLA) {\n            DATA.at(TO_INT(OFFSET) + 1 - I) = TO_BYTE(SHR(V, TO_UINT(8 * I)));\n        } else {\n            DATA.at(TO_INT(OFFSET) + I) = TO_BYTE(SHR(V, TO_UINT(8 * I)));\n        }\n    }\n    CAN_SET_UINT16_result = true;\n    return CAN_SET_UINT16_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        },
        {
          "library": "oscat-basic",
          "name": "OFFSET"
        }
      ]
    },
    {
      "name": "CAN_SET_UINT32",
      "kind": "function",
      "header": "IEC_BOOL CAN_SET_UINT32(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA, IEC_UDINT VALUE);",
      "cpp": "IEC_BOOL CAN_SET_UINT32(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA, IEC_UDINT VALUE) {\n    IEC_BOOL CAN_SET_UINT32_result;\n    IEC_INT I;\n    IEC_DWORD V;\n    if (TO_INT(OFFSET) + 4 > 8) {\n        CAN_SET_UINT32_result = false;\n        return CAN_SET_UINT32_result;\n    }\n    V = TO_DWORD(VALUE);\n    for (I = 0; I <= 3; I++) {\n        if (MOTOROLA) {\n            DATA.at(TO_INT(OFFSET) + 3 - I) = TO_BYTE(SHR(V, TO_UINT(8 * I)));\n        } else {\n            DATA.at(TO_INT(OFFSET) + I) = TO_BYTE(SHR(V, TO_UINT(8 * I)));\n        }\n    }\n    CAN_SET_UINT32_result = true;\n    return CAN_SET_UINT32_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        },
        {
          "library": "oscat-basic",
          "name": "OFFSET"
        }
      ]
    },
    {
      "name": "CW_DWORD_TO_REAL",
      "kind": "function",
      "header": "IEC_REAL CW_DWORD_TO_REAL(IEC_DWORD IN);",
      "cpp": "IEC_REAL CW_DWORD_TO_REAL(IEC_DWORD IN) {\n    IEC_REAL CW_DWORD_TO_REAL_result;\n    IEC_INT E;\n    IEC_LREAL M;\n    IEC_LREAL X;\n    E = TO_INT((SHR(IN, 23)) & (0xFF));\n    M = TO_LREAL((IN) & (0x7FFFFF));\n    if (E == 255) {\n        if (M != 0.0) {\n            X = 0.0;\n        } else {\n            X = 3.4028234663852886e+38;\n        }\n    } else if (E == 0) {\n        X = M * EXPT(2.0, static_cast<IEC_REAL>(-149));\n    } else {\n        X = (M + 8388608.0) * EXPT(2.0, E - 150);\n    }\n    if (((IN) & (0x80000000)) != 0) {\n        X = -X;\n    }\n    CW_DWORD_TO_REAL_result = TO_REAL(X);\n    return CW_DWORD_TO_REAL_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "EXPT"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CW_REAL_TO_DWORD",
      "kind": "function",
      "header": "IEC_DWORD CW_REAL_TO_DWORD(IEC_REAL IN);",
      "cpp": "IEC_DWORD CW_REAL_TO_DWORD(IEC_REAL IN) {\n    IEC_DWORD CW_REAL_TO_DWORD_result;\n    IEC_LREAL A;\n    IEC_INT E;\n    IEC_DWORD SIGN;\n    A = TO_LREAL(IN);\n    SIGN = 0;\n    if (A < 0.0) {\n        SIGN = 0x80000000;\n        A = -A;\n    }\n    if (A != A) {\n        CW_REAL_TO_DWORD_result = 0x7FC00000;\n        return CW_REAL_TO_DWORD_result;\n    }\n    if (A == 0.0) {\n        CW_REAL_TO_DWORD_result = SIGN;\n        return CW_REAL_TO_DWORD_result;\n    }\n    if (A > 3.4028234663852886e+38) {\n        CW_REAL_TO_DWORD_result = (SIGN) | (0x7F800000);\n        return CW_REAL_TO_DWORD_result;\n    }\n    E = TO_INT(TRUNC(LN(A) / LN(2.0)));\n    while (A / EXPT(2.0, E) >= 2.0) {\n        E = E + 1;\n    }\n    while (A / EXPT(2.0, E) < 1.0) {\n        E = E - 1;\n    }\n    if (E < -126) {\n        CW_REAL_TO_DWORD_result = (SIGN) | (TO_DWORD(A * EXPT(2.0, static_cast<IEC_REAL>(149))));\n    } else {\n        CW_REAL_TO_DWORD_result = ((SIGN) | (SHL(TO_DWORD(E + 127), 23))) | (TO_DWORD((A / EXPT(2.0, E) - 1.0) * 8388608.0));\n    }\n    return CW_REAL_TO_DWORD_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "EXPT"
        },
        {
          "library": "iec-std-functions",
          "name": "LN"
        },
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "TRUNC"
        }
      ]
    },
    {
      "name": "CW_LWORD_TO_LREAL",
      "kind": "function",
      "header": "IEC_LREAL CW_LWORD_TO_LREAL(IEC_LWORD IN);",
      "cpp": "IEC_LREAL CW_LWORD_TO_LREAL(IEC_LWORD IN) {\n    IEC_LREAL CW_LWORD_TO_LREAL_result;\n    IEC_INT E;\n    IEC_LREAL M;\n    IEC_LREAL X;\n    E = TO_INT((SHR(IN, 52)) & (0x7FF));\n    M = TO_LREAL((IN) & (0xFFFFFFFFFFFFF));\n    if (E == 2047) {\n        if (M != 0.0) {\n            X = 0.0;\n        } else {\n            X = 1.7976931348623157e+308;\n        }\n    } else if (E == 0) {\n        X = M * EXPT(2.0, static_cast<IEC_REAL>(-1074));\n    } else {\n        X = (M + 4503599627370496.0) * EXPT(2.0, E - 1075);\n    }\n    if (((IN) & (0x8000000000000000)) != 0) {\n        X = -X;\n    }\n    CW_LWORD_TO_LREAL_result = X;\n    return CW_LWORD_TO_LREAL_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "EXPT"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CW_LREAL_TO_LWORD",
      "kind": "function",
      "header": "IEC_LWORD CW_LREAL_TO_LWORD(IEC_LREAL IN);",
      "cpp": "IEC_LWORD CW_LREAL_TO_LWORD(IEC_LREAL IN) {\n    IEC_LWORD CW_LREAL_TO_LWORD_result;\n    IEC_LREAL A;\n    IEC_INT E;\n    IEC_LWORD SIGN;\n    A = IN;\n    SIGN = 0;\n    if (A < 0.0) {\n        SIGN = 0x8000000000000000;\n        A = -A;\n    }\n    if (A != A) {\n        CW_LREAL_TO_LWORD_result = 0x7FF8000000000000;\n        return CW_LREAL_TO_LWORD_result;\n    }\n    if (A == 0.0) {\n        CW_LREAL_TO_LWORD_result = SIGN;\n        return CW_LREAL_TO_LWORD_result;\n    }\n    if (A > 1.7976931348623157e+308) {\n        CW_LREAL_TO_LWORD_result = (SIGN) | (0x7FF0000000000000);\n        return CW_LREAL_TO_LWORD_result;\n    }\n    E = TO_INT(TRUNC(LN(A) / LN(2.0)));\n    while (A / EXPT(2.0, E) >= 2.0) {\n        E = E + 1;\n    }\n    while (A / EXPT(2.0, E) < 1.0) {\n        E = E - 1;\n    }\n    if (E < -1022) {\n        CW_LREAL_TO_LWORD_result = (SIGN) | (TO_LWORD(A * EXPT(2.0, static_cast<IEC_REAL>(537)) * EXPT(2.0, static_cast<IEC_REAL>(537))));\n    } else {\n        CW_LREAL_TO_LWORD_result = ((SIGN) | (SHL(TO_LWORD(E + 1023), 52))) | (TO_LWORD((A / EXPT(2.0, E) - 1.0) * 4503599627370496.0));\n    }\n    return CW_LREAL_TO_LWORD_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "EXPT"
        },
        {
          "library": "iec-std-functions",
          "name": "LN"
        },
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "TRUNC"
        }
      ]
    },
    {
      "name": "J1939_DTC_MAKE",
      "kind": "function",
      "header": "IEC_UDINT J1939_DTC_MAKE(IEC_UDINT SPN, IEC_USINT FMI, IEC_USINT OC);",
      "cpp": "IEC_UDINT J1939_DTC_MAKE(IEC_UDINT SPN, IEC_USINT FMI, IEC_USINT OC) {\n    IEC_UDINT J1939_DTC_MAKE_result;\n    J1939_DTC_MAKE_result = ((((SPN) & (0x7FFFF))) | (SHL((TO_UDINT(FMI)) & (0x1F), 19))) | (SHL((TO_UDINT(OC)) & (0x7F), 24));\n    return J1939_DTC_MAKE_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        }
      ]
    },
    {
      "name": "J1939_GET_BITS",
      "kind": "function",
      "header": "IEC_LINT J1939_GET_BITS(Array1D<IEC_BYTE, 0, 1784>& DATA, IEC_UINT START_BIT, IEC_USINT BIT_LENGTH, IEC_BOOL SIGNED);",
      "cpp": "IEC_LINT J1939_GET_BITS(Array1D<IEC_BYTE, 0, 1784>& DATA, IEC_UINT START_BIT, IEC_USINT BIT_LENGTH, IEC_BOOL SIGNED) {\n    IEC_LINT J1939_GET_BITS_result;\n    IEC_DINT I;\n    IEC_DINT POS;\n    IEC_LWORD BITV;\n    IEC_LWORD V;\n    V = 0;\n    POS = TO_DINT(START_BIT);\n    for (I = 0; I <= TO_DINT(BIT_LENGTH) - 1; I++) {\n        if ((I < 64) & (POS < 14280)) {\n            BITV = TO_LWORD((SHR(DATA.at(POS / 8), TO_UINT(POS % 8))) & (0x01));\n            V = (V) | (SHL(BITV, TO_UINT(I)));\n        }\n        POS = POS + 1;\n    }\n    if (((SIGNED) & (BIT_LENGTH > 0)) & (BIT_LENGTH < 64)) {\n        if (((SHR(V, TO_UINT(BIT_LENGTH) - 1)) & (0x01)) == 1) {\n            V = (V) | (SHL(static_cast<IEC_LWORD>(0xFFFFFFFFFFFFFFFF), TO_UINT(BIT_LENGTH)));\n        }\n    }\n    J1939_GET_BITS_result = TO_LINT(V);\n    return J1939_GET_BITS_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "J1939_NAME_MAKE",
      "kind": "function",
      "header": "IEC_LWORD J1939_NAME_MAKE(IEC_UDINT IDENTITY_NUMBER, IEC_UINT MANUFACTURER_CODE, IEC_USINT ECU_INSTANCE, IEC_USINT FUNCTION_INSTANCE, IEC_USINT ECU_FUNCTION, IEC_USINT VEHICLE_SYSTEM, IEC_USINT VEHICLE_SYSTEM_INSTANCE, IEC_USINT INDUSTRY_GROUP, IEC_BOOL ARBITRARY_ADDRESS_CAPABLE);",
      "cpp": "IEC_LWORD J1939_NAME_MAKE(IEC_UDINT IDENTITY_NUMBER, IEC_UINT MANUFACTURER_CODE, IEC_USINT ECU_INSTANCE, IEC_USINT FUNCTION_INSTANCE, IEC_USINT ECU_FUNCTION, IEC_USINT VEHICLE_SYSTEM, IEC_USINT VEHICLE_SYSTEM_INSTANCE, IEC_USINT INDUSTRY_GROUP, IEC_BOOL ARBITRARY_ADDRESS_CAPABLE) {\n    IEC_LWORD J1939_NAME_MAKE_result;\n    IEC_LWORD N;\n    N = (TO_LWORD(IDENTITY_NUMBER)) & (0x1FFFFF);\n    N = (N) | (SHL((TO_LWORD(MANUFACTURER_CODE)) & (0x7FF), 21));\n    N = (N) | (SHL((TO_LWORD(ECU_INSTANCE)) & (0x7), 32));\n    N = (N) | (SHL((TO_LWORD(FUNCTION_INSTANCE)) & (0x1F), 35));\n    N = (N) | (SHL((TO_LWORD(ECU_FUNCTION)) & (0xFF), 40));\n    N = (N) | (SHL((TO_LWORD(VEHICLE_SYSTEM)) & (0x7F), 49));\n    N = (N) | (SHL((TO_LWORD(VEHICLE_SYSTEM_INSTANCE)) & (0xF), 56));\n    N = (N) | (SHL((TO_LWORD(INDUSTRY_GROUP)) & (0x7), 60));\n    if (ARBITRARY_ADDRESS_CAPABLE) {\n        N = (N) | (static_cast<IEC_LWORD>(0x8000000000000000));\n    }\n    J1939_NAME_MAKE_result = N;\n    return J1939_NAME_MAKE_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        }
      ]
    },
    {
      "name": "J1939_SET_BITS",
      "kind": "function",
      "header": "IEC_BOOL J1939_SET_BITS(Array1D<IEC_BYTE, 0, 1784>& DATA, IEC_UINT START_BIT, IEC_USINT BIT_LENGTH, IEC_LINT VALUE);",
      "cpp": "IEC_BOOL J1939_SET_BITS(Array1D<IEC_BYTE, 0, 1784>& DATA, IEC_UINT START_BIT, IEC_USINT BIT_LENGTH, IEC_LINT VALUE) {\n    IEC_BOOL J1939_SET_BITS_result;\n    IEC_DINT I;\n    IEC_DINT POS;\n    IEC_LWORD V;\n    IEC_BYTE B;\n    if (((BIT_LENGTH == 0) | (BIT_LENGTH > 64)) | (TO_DINT(START_BIT) + TO_DINT(BIT_LENGTH) > 14280)) {\n        J1939_SET_BITS_result = false;\n        return J1939_SET_BITS_result;\n    }\n    V = TO_LWORD(VALUE);\n    POS = TO_DINT(START_BIT);\n    for (I = 0; I <= TO_DINT(BIT_LENGTH) - 1; I++) {\n        B = SHL(static_cast<IEC_BYTE>(1), TO_UINT(POS % 8));\n        if (((SHR(V, TO_UINT(I))) & (0x01)) == 1) {\n            DATA.at(POS / 8) = (DATA.at(POS / 8)) | (B);\n        } else {\n            DATA.at(POS / 8) = (DATA.at(POS / 8)) & (~B);\n        }\n        POS = POS + 1;\n    }\n    J1939_SET_BITS_result = true;\n    return J1939_SET_BITS_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    }
  ],
  "dependencies": [
    {
      "name": "additional-function-blocks",
      "version": "1.0.0"
    },
    {
      "name": "iec-standard-fb",
      "version": "1.0.0"
    },
    {
      "name": "iec-std-functions",
      "version": "1.0.0"
    },
    {
      "name": "oscat-basic",
      "version": "335.0.0"
    },
    {
      "name": "plcopen-softmotion",
      "version": "0.1.0"
    }
  ],
  "sources": [
    {
      "fileName": "CAN_GET_BITS.st",
      "source": "(*\n * CAN_GET_BITS: a signal's raw value from a frame's data (spec\n * can-plc-frames, \"ST helper functions\"). Bit numbering as DBC files use it:\n * little-endian (Intel, MOTOROLA FALSE) signals start at their least\n * significant bit, big-endian (Motorola) signals at their most significant\n * bit, bit 0 being the least significant bit of byte 0. BIT_LENGTH 1..64; SIGNED sign-extends.\n * Bits outside the 8 bytes read as 0.\n *)\nFUNCTION CAN_GET_BITS : LINT\nVAR_IN_OUT\n  DATA : ARRAY[0..7] OF BYTE;\nEND_VAR\nVAR_INPUT\n  START_BIT : USINT;\n  BIT_LENGTH : USINT;\n  MOTOROLA : BOOL;\n  SIGNED : BOOL;\nEND_VAR\nVAR\n  i : INT;\n  pos : INT;\n  bitv : LWORD;\n  v : LWORD;\nEND_VAR\n  v := 0;\n  pos := USINT_TO_INT(START_BIT);\n  FOR i := 0 TO USINT_TO_INT(BIT_LENGTH) - 1 DO\n    IF pos >= 0 AND pos < 64 THEN\n      bitv := BYTE_TO_LWORD(SHR(DATA[pos / 8], INT_TO_UINT(pos MOD 8)) AND 16#01);\n    ELSE\n      bitv := 0;\n    END_IF;\n    IF MOTOROLA THEN\n      v := SHL(v, 1) OR bitv;\n      IF pos MOD 8 = 0 THEN\n        pos := pos + 15;\n      ELSE\n        pos := pos - 1;\n      END_IF;\n    ELSE\n      v := v OR SHL(bitv, INT_TO_UINT(i));\n      pos := pos + 1;\n    END_IF;\n  END_FOR;\n  IF SIGNED AND BIT_LENGTH > 0 AND BIT_LENGTH < 64 THEN\n    IF (SHR(v, USINT_TO_UINT(BIT_LENGTH) - 1) AND 16#01) = 1 THEN\n      v := v OR SHL(LWORD#16#FFFFFFFFFFFFFFFF, USINT_TO_UINT(BIT_LENGTH));\n    END_IF;\n  END_IF;\n  CAN_GET_BITS := LWORD_TO_LINT(v);\nEND_FUNCTION\n"
    },
    {
      "fileName": "CAN_GET_UINT16.st",
      "source": "(*\n * CAN_GET_UINT16: the 16-bit unsigned value in DATA[OFFSET..OFFSET+1],\n * least significant byte first, or most significant first with MOTOROLA.\n * 0 when the bytes do not fit in the frame.\n *)\nFUNCTION CAN_GET_UINT16 : UINT\nVAR_IN_OUT\n  DATA : ARRAY[0..7] OF BYTE;\nEND_VAR\nVAR_INPUT\n  OFFSET : USINT;\n  MOTOROLA : BOOL;\nEND_VAR\nVAR\n  i : INT;\n  v : WORD;\nEND_VAR\n  v := 0;\n  IF USINT_TO_INT(OFFSET) + 2 <= 8 THEN\n    FOR i := 0 TO 1 DO\n      IF MOTOROLA THEN\n        v := SHL(v, 8) OR BYTE_TO_WORD(DATA[USINT_TO_INT(OFFSET) + i]);\n      ELSE\n        v := v OR SHL(BYTE_TO_WORD(DATA[USINT_TO_INT(OFFSET) + i]), INT_TO_UINT(8 * i));\n      END_IF;\n    END_FOR;\n  END_IF;\n  CAN_GET_UINT16 := WORD_TO_UINT(v);\nEND_FUNCTION\n"
    },
    {
      "fileName": "CAN_GET_UINT32.st",
      "source": "(*\n * CAN_GET_UINT32: the 32-bit unsigned value in DATA[OFFSET..OFFSET+3],\n * least significant byte first, or most significant first with MOTOROLA.\n * 0 when the bytes do not fit in the frame.\n *)\nFUNCTION CAN_GET_UINT32 : UDINT\nVAR_IN_OUT\n  DATA : ARRAY[0..7] OF BYTE;\nEND_VAR\nVAR_INPUT\n  OFFSET : USINT;\n  MOTOROLA : BOOL;\nEND_VAR\nVAR\n  i : INT;\n  v : DWORD;\nEND_VAR\n  v := 0;\n  IF USINT_TO_INT(OFFSET) + 4 <= 8 THEN\n    FOR i := 0 TO 3 DO\n      IF MOTOROLA THEN\n        v := SHL(v, 8) OR BYTE_TO_DWORD(DATA[USINT_TO_INT(OFFSET) + i]);\n      ELSE\n        v := v OR SHL(BYTE_TO_DWORD(DATA[USINT_TO_INT(OFFSET) + i]), INT_TO_UINT(8 * i));\n      END_IF;\n    END_FOR;\n  END_IF;\n  CAN_GET_UINT32 := DWORD_TO_UDINT(v);\nEND_FUNCTION\n"
    },
    {
      "fileName": "CAN_J1939_ID.st",
      "source": "(*\n * CAN_J1939_ID: the 29-bit identifier of a J1939 frame (send it with\n * EXTENDED := TRUE). For a PDU1 PGN (PF below 240) DESTINATION goes into the\n * PS byte; for a PDU2 PGN it is ignored.\n *)\nFUNCTION CAN_J1939_ID : UDINT\nVAR_INPUT\n  PRIORITY : USINT;\n  PGN : UDINT;\n  SOURCE : USINT;\n  DESTINATION : USINT;\nEND_VAR\nVAR\n  p : UDINT;\nEND_VAR\n  p := PGN AND 16#3FFFF;\n  IF (SHR(p, 8) AND 16#FF) < 240 THEN\n    p := (p AND 16#3FF00) OR USINT_TO_UDINT(DESTINATION);\n  END_IF;\n  CAN_J1939_ID := SHL(USINT_TO_UDINT(PRIORITY) AND 16#7, 26) OR SHL(p, 8) OR USINT_TO_UDINT(SOURCE);\nEND_FUNCTION\n"
    },
    {
      "fileName": "CAN_J1939_PGN.st",
      "source": "(*\n * CAN_J1939_PGN: the PGN of a 29-bit J1939 identifier; for a PDU1 PGN (PF\n * below 240) the destination byte is cleared.\n *)\nFUNCTION CAN_J1939_PGN : UDINT\nVAR_INPUT\n  ID : UDINT;\nEND_VAR\nVAR\n  p : UDINT;\nEND_VAR\n  p := SHR(ID, 8) AND 16#3FFFF;\n  IF (SHR(p, 8) AND 16#FF) < 240 THEN\n    p := p AND 16#3FF00;\n  END_IF;\n  CAN_J1939_PGN := p;\nEND_FUNCTION\n"
    },
    {
      "fileName": "CAN_J1939_SOURCE.st",
      "source": "(* CAN_J1939_SOURCE: the source address byte of a 29-bit J1939 identifier. *)\nFUNCTION CAN_J1939_SOURCE : USINT\nVAR_INPUT\n  ID : UDINT;\nEND_VAR\n  CAN_J1939_SOURCE := UDINT_TO_USINT(ID AND 16#FF);\nEND_FUNCTION\n"
    },
    {
      "fileName": "CAN_SET_BITS.st",
      "source": "(*\n * CAN_SET_BITS: writes a signal's raw value into a frame's data, with the bit\n * numbering of CAN_GET_BITS; the other bits stay as they are. Returns TRUE,\n * or FALSE (and writes nothing) when a bit would fall outside the 8 bytes.\n *)\nFUNCTION CAN_SET_BITS : BOOL\nVAR_IN_OUT\n  DATA : ARRAY[0..7] OF BYTE;\nEND_VAR\nVAR_INPUT\n  START_BIT : USINT;\n  BIT_LENGTH : USINT;\n  MOTOROLA : BOOL;\n  VALUE : LINT;\nEND_VAR\nVAR\n  i : INT;\n  pos : INT;\n  shift : INT;\n  v : LWORD;\n  b : BYTE;\nEND_VAR\n  (* First pass: every bit inside the frame? *)\n  pos := USINT_TO_INT(START_BIT);\n  FOR i := 0 TO USINT_TO_INT(BIT_LENGTH) - 1 DO\n    IF pos < 0 OR pos > 63 THEN\n      CAN_SET_BITS := FALSE;\n      RETURN;\n    END_IF;\n    IF MOTOROLA THEN\n      IF pos MOD 8 = 0 THEN\n        pos := pos + 15;\n      ELSE\n        pos := pos - 1;\n      END_IF;\n    ELSE\n      pos := pos + 1;\n    END_IF;\n  END_FOR;\n  v := LINT_TO_LWORD(VALUE);\n  pos := USINT_TO_INT(START_BIT);\n  FOR i := 0 TO USINT_TO_INT(BIT_LENGTH) - 1 DO\n    IF MOTOROLA THEN\n      shift := USINT_TO_INT(BIT_LENGTH) - 1 - i;\n    ELSE\n      shift := i;\n    END_IF;\n    b := SHL(BYTE#1, INT_TO_UINT(pos MOD 8));\n    IF (SHR(v, INT_TO_UINT(shift)) AND 16#01) = 1 THEN\n      DATA[pos / 8] := DATA[pos / 8] OR b;\n    ELSE\n      DATA[pos / 8] := DATA[pos / 8] AND NOT b;\n    END_IF;\n    IF MOTOROLA THEN\n      IF pos MOD 8 = 0 THEN\n        pos := pos + 15;\n      ELSE\n        pos := pos - 1;\n      END_IF;\n    ELSE\n      pos := pos + 1;\n    END_IF;\n  END_FOR;\n  CAN_SET_BITS := TRUE;\nEND_FUNCTION\n"
    },
    {
      "fileName": "CAN_SET_UINT16.st",
      "source": "(*\n * CAN_SET_UINT16: writes VALUE into DATA[OFFSET..OFFSET+1] with the byte\n * order of CAN_GET_UINT16. FALSE (nothing written) when the bytes do not fit.\n *)\nFUNCTION CAN_SET_UINT16 : BOOL\nVAR_IN_OUT\n  DATA : ARRAY[0..7] OF BYTE;\nEND_VAR\nVAR_INPUT\n  OFFSET : USINT;\n  MOTOROLA : BOOL;\n  VALUE : UINT;\nEND_VAR\nVAR\n  i : INT;\n  v : WORD;\nEND_VAR\n  IF USINT_TO_INT(OFFSET) + 2 > 8 THEN\n    CAN_SET_UINT16 := FALSE;\n    RETURN;\n  END_IF;\n  v := UINT_TO_WORD(VALUE);\n  FOR i := 0 TO 1 DO\n    IF MOTOROLA THEN\n      DATA[USINT_TO_INT(OFFSET) + 1 - i] := WORD_TO_BYTE(SHR(v, INT_TO_UINT(8 * i)));\n    ELSE\n      DATA[USINT_TO_INT(OFFSET) + i] := WORD_TO_BYTE(SHR(v, INT_TO_UINT(8 * i)));\n    END_IF;\n  END_FOR;\n  CAN_SET_UINT16 := TRUE;\nEND_FUNCTION\n"
    },
    {
      "fileName": "CAN_SET_UINT32.st",
      "source": "(*\n * CAN_SET_UINT32: writes VALUE into DATA[OFFSET..OFFSET+3] with the byte\n * order of CAN_GET_UINT32. FALSE (nothing written) when the bytes do not fit.\n *)\nFUNCTION CAN_SET_UINT32 : BOOL\nVAR_IN_OUT\n  DATA : ARRAY[0..7] OF BYTE;\nEND_VAR\nVAR_INPUT\n  OFFSET : USINT;\n  MOTOROLA : BOOL;\n  VALUE : UDINT;\nEND_VAR\nVAR\n  i : INT;\n  v : DWORD;\nEND_VAR\n  IF USINT_TO_INT(OFFSET) + 4 > 8 THEN\n    CAN_SET_UINT32 := FALSE;\n    RETURN;\n  END_IF;\n  v := UDINT_TO_DWORD(VALUE);\n  FOR i := 0 TO 3 DO\n    IF MOTOROLA THEN\n      DATA[USINT_TO_INT(OFFSET) + 3 - i] := DWORD_TO_BYTE(SHR(v, INT_TO_UINT(8 * i)));\n    ELSE\n      DATA[USINT_TO_INT(OFFSET) + i] := DWORD_TO_BYTE(SHR(v, INT_TO_UINT(8 * i)));\n    END_IF;\n  END_FOR;\n  CAN_SET_UINT32 := TRUE;\nEND_FUNCTION\n"
    },
    {
      "fileName": "CO_NMT.st",
      "source": "(*\n * CO_NMT: sends the NMT command COMMAND (CiA 301 codes: 1 START, 2 STOP,\n * 128 ENTER PRE-OPERATIONAL, 129 RESET NODE, 130 RESET COMMUNICATION) to\n * node NODE (0: every node) of CANopen master network NETWORK, through the\n * bridge's control block. A rising edge of EXECUTE starts it; BUSY until the\n * bridge has handled it, then DONE or ERROR with ERROR_ID (docs/plc-nmt.md):\n * 2 no answer within TIMEOUT (T#0s: 5 s), 5 refused (the bus is down or 16\n * commands wait), 6 invalid input, 20 the bridge is not reachable, 22 the\n * config has no control block. Instances share the control block: one waits\n * while another uses it.\n *)\n(*\n * LINK is the generated `canworks.link` (ARRAY[0..88] OF WORD): the\n * bridge's blocks as canworks_in and canworks_out copy them from and to the\n * Modbus registers every scan, one word per register (high byte = the\n * bridge's even byte). Words: 0-3 status block, 4-6 control block, 7-13 SDO\n * request, 14-20 SDO response, 21 flags (bit 0 the bridge answers with this\n * program's map, 1 a control block, 2 SDO registers, 8 + n a live list for\n * network n), 22 control block owner, 23 SDO owner, 24 last instance number,\n * 25 + 8n .. 32 + 8n the live list of network n (n 0..7).\n *)\nFUNCTION_BLOCK CO_NMT\nVAR_INPUT\n  EXECUTE : BOOL;\n  NETWORK : USINT;\n  NODE : USINT;\n  COMMAND : USINT;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  BUSY : BOOL;\n  DONE : BOOL;\n  ERROR : BOOL;\n  ERROR_ID : UINT;\nEND_VAR\nVAR_IN_OUT\n  LINK : ARRAY[0..88] OF WORD;\nEND_VAR\nVAR\n  me : WORD;\n  prev : BOOL;\n  phase : USINT;           (* 0 idle, 1 waiting for the control block, 2 sent, 3 ended *)\n  cmd : WORD;\n  counter : WORD;\n  timer : TON;\n  result : WORD;\n  err : UINT;\n  fin : BOOL;\nEND_VAR\n  IF me = 0 THEN\n    LINK[24] := LINK[24] + 1;\n    me := LINK[24];\n  END_IF;\n  IF phase = 3 AND NOT EXECUTE THEN\n    phase := 0;\n    DONE := FALSE;\n    ERROR := FALSE;\n  END_IF;\n  err := 0;\n  fin := FALSE;\n  IF phase = 0 AND EXECUTE AND NOT prev THEN\n    DONE := FALSE;\n    ERROR := FALSE;\n    ERROR_ID := 0;\n    timer(IN := FALSE);\n    CASE COMMAND OF\n      1: cmd := 3;\n      2: cmd := 4;\n      128: cmd := 5;\n      129: cmd := 6;\n      130: cmd := 7;\n    ELSE\n      cmd := 0;\n    END_CASE;\n    IF (LINK[21] AND 16#0001) = 0 THEN\n      err := 20;\n    ELSIF (LINK[21] AND 16#0002) = 0 THEN\n      err := 22;\n    ELSIF cmd = 0 OR NODE > 127 THEN\n      err := 6;\n    ELSE\n      phase := 1;\n    END_IF;\n  END_IF;\n  IF phase = 1 OR phase = 2 THEN\n    timer(IN := TRUE, PT := SEL(TIMEOUT = T#0s, TIMEOUT, T#5s));\n    IF (LINK[21] AND 16#0001) = 0 THEN\n      err := 20;\n    ELSIF timer.Q THEN\n      err := 2;\n    ELSIF phase = 1 AND (LINK[22] = 0 OR LINK[22] = me) THEN\n      LINK[22] := me;\n      counter := LINK[2] + 1;\n      LINK[4] := counter;\n      LINK[5] := SHL(cmd, 8) OR USINT_TO_WORD(NETWORK);\n      LINK[6] := SHL(USINT_TO_WORD(NODE), 8);\n      phase := 2;\n    ELSIF phase = 2 AND LINK[2] = counter THEN\n      result := SHR(LINK[3], 8);\n      IF result = 0 THEN\n        fin := TRUE;\n      ELSIF result = 5 THEN\n        err := 5;\n      ELSE\n        err := 6;\n      END_IF;\n    END_IF;\n  END_IF;\n  IF err <> 0 OR fin THEN\n    phase := 3;\n    DONE := fin;\n    ERROR := err <> 0;\n    ERROR_ID := err;\n    timer(IN := FALSE);\n    IF LINK[22] = me THEN\n      LINK[22] := 0;\n    END_IF;\n  END_IF;\n  BUSY := phase = 1 OR phase = 2;\n  prev := EXECUTE;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CO_NODE_LIVE.st",
      "source": "(*\n * CO_NODE_LIVE: TRUE while node NODE of CANopen master network NETWORK is\n * OPERATIONAL, from the bridge's live list of that network. FALSE without a\n * live list for the network or while the bridge is not reachable.\n *)\n(*\n * LINK is the generated `canworks.link` (ARRAY[0..88] OF WORD): the\n * bridge's blocks as canworks_in and canworks_out copy them from and to the\n * Modbus registers every scan, one word per register (high byte = the\n * bridge's even byte). Words: 0-3 status block, 4-6 control block, 7-13 SDO\n * request, 14-20 SDO response, 21 flags (bit 0 the bridge answers with this\n * program's map, 1 a control block, 2 SDO registers, 8 + n a live list for\n * network n), 22 control block owner, 23 SDO owner, 24 last instance number,\n * 25 + 8n .. 32 + 8n the live list of network n (n 0..7).\n *)\nFUNCTION_BLOCK CO_NODE_LIVE\nVAR_INPUT\n  NETWORK : USINT;\n  NODE : USINT;\nEND_VAR\nVAR_OUTPUT\n  LIVE : BOOL;\nEND_VAR\nVAR_IN_OUT\n  LINK : ARRAY[0..88] OF WORD;\nEND_VAR\nVAR\n  byte_no : INT;\n  word : WORD;\n  bit_no : INT;\nEND_VAR\n  LIVE := FALSE;\n  IF (LINK[21] AND 16#0001) <> 0 AND NETWORK < 8 AND NODE >= 1 AND NODE <= 127 THEN\n    IF (SHR(LINK[21], USINT_TO_UINT(NETWORK) + 8) AND 16#0001) <> 0 THEN\n      byte_no := USINT_TO_INT(NODE) / 8;\n      word := LINK[25 + USINT_TO_INT(NETWORK) * 8 + byte_no / 2];\n      bit_no := USINT_TO_INT(NODE) MOD 8;\n      IF byte_no MOD 2 = 0 THEN\n        bit_no := bit_no + 8;\n      END_IF;\n      LIVE := (SHR(word, INT_TO_UINT(bit_no)) AND 16#0001) <> 0;\n    END_IF;\n  END_IF;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CO_SDO_READ.st",
      "source": "(*\n * CO_SDO_READ: reads object INDEX:SUBINDEX (up to 4 bytes) of node NODE\n * (1..127) of CANopen master network NETWORK into DATA, through the bridge's\n * SDO registers.\n * A rising edge of EXECUTE starts it; BUSY until the bridge has an answer,\n * then DONE or ERROR with ERROR_ID (docs/plc-sdo.md): 1 the node aborted\n * (ABORT_CODE), 2 no answer within TIMEOUT (T#0s: 5 s), 6 invalid input,\n * 20 the bridge is not reachable, 21 SDO writes are not allowed by the\n * config (ABORT_CODE 16#08000020), 22 the config has no SDO registers.\n * Instances share the SDO registers: one waits while another uses them.\n *)\n(*\n * LINK is the generated `canworks.link` (ARRAY[0..88] OF WORD): the\n * bridge's blocks as canworks_in and canworks_out copy them from and to the\n * Modbus registers every scan, one word per register (high byte = the\n * bridge's even byte). Words: 0-3 status block, 4-6 control block, 7-13 SDO\n * request, 14-20 SDO response, 21 flags (bit 0 the bridge answers with this\n * program's map, 1 a control block, 2 SDO registers, 8 + n a live list for\n * network n), 22 control block owner, 23 SDO owner, 24 last instance number,\n * 25 + 8n .. 32 + 8n the live list of network n (n 0..7).\n *)\nFUNCTION_BLOCK CO_SDO_READ\nVAR_INPUT\n  EXECUTE : BOOL;\n  NETWORK : USINT;\n  NODE : USINT;\n  INDEX : UINT;\n  SUBINDEX : USINT;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  BUSY : BOOL;\n  DONE : BOOL;\n  ERROR : BOOL;\n  ERROR_ID : UINT;\n  ABORT_CODE : UDINT;\n  DATA : UDINT;\nEND_VAR\nVAR_IN_OUT\n  LINK : ARRAY[0..88] OF WORD;\nEND_VAR\nVAR\n  me : WORD;\n  prev : BOOL;\n  phase : USINT;           (* 0 idle, 1 waiting for the SDO registers, 2 sent, 3 ended *)\n  counter : WORD;\n  timer : TON;\n  state : WORD;\n  err : UINT;\n  fin : BOOL;\nEND_VAR\n  IF me = 0 THEN\n    LINK[24] := LINK[24] + 1;\n    me := LINK[24];\n  END_IF;\n  IF phase = 3 AND NOT EXECUTE THEN\n    phase := 0;\n    DONE := FALSE;\n    ERROR := FALSE;\n  END_IF;\n  err := 0;\n  fin := FALSE;\n  IF phase = 0 AND EXECUTE AND NOT prev THEN\n    DONE := FALSE;\n    ERROR := FALSE;\n    ERROR_ID := 0;\n    ABORT_CODE := 0;\n    DATA := 0;\n    timer(IN := FALSE);\n    IF (LINK[21] AND 16#0001) = 0 THEN\n      err := 20;\n    ELSIF (LINK[21] AND 16#0004) = 0 THEN\n      err := 22;\n    ELSIF NODE < 1 OR NODE > 127 THEN\n      err := 6;\n    ELSE\n      phase := 1;\n    END_IF;\n  END_IF;\n  IF phase = 1 OR phase = 2 THEN\n    timer(IN := TRUE, PT := SEL(TIMEOUT = T#0s, TIMEOUT, T#5s));\n    IF (LINK[21] AND 16#0001) = 0 THEN\n      err := 20;\n    ELSIF timer.Q THEN\n      err := 2;\n      ABORT_CODE := 16#05040000;\n    ELSIF phase = 1 AND (LINK[23] = 0 OR LINK[23] = me) THEN\n      LINK[23] := me;\n      counter := LINK[14] + 1;\n      LINK[7] := counter;\n      LINK[8] := SHL(WORD#1, 8) OR USINT_TO_WORD(NETWORK);\n      LINK[9] := SHL(USINT_TO_WORD(NODE), 8) OR USINT_TO_WORD(SUBINDEX);\n      LINK[10] := UINT_TO_WORD(INDEX);\n      LINK[11] := 0;\n      LINK[12] := 0;\n      LINK[13] := 0;\n      phase := 2;\n    ELSIF phase = 2 AND LINK[14] = counter THEN\n      state := SHR(LINK[15], 8);\n      IF state = 2 THEN\n        DATA := DWORD_TO_UDINT(SHL(WORD_TO_DWORD(LINK[18]), 16) OR WORD_TO_DWORD(LINK[19]));\n        fin := TRUE;\n      ELSIF state = 3 THEN\n        ABORT_CODE := DWORD_TO_UDINT(SHL(WORD_TO_DWORD(LINK[16]), 16) OR WORD_TO_DWORD(LINK[17]));\n        IF ABORT_CODE = 16#08000020 THEN\n          err := 21;\n        ELSE\n          err := 1;\n        END_IF;\n      END_IF;\n    END_IF;\n  END_IF;\n  IF err <> 0 OR fin THEN\n    phase := 3;\n    DONE := fin;\n    ERROR := err <> 0;\n    ERROR_ID := err;\n    timer(IN := FALSE);\n    IF LINK[23] = me THEN\n      LINK[23] := 0;\n    END_IF;\n  END_IF;\n  BUSY := phase = 1 OR phase = 2;\n  prev := EXECUTE;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CO_SDO_WRITE.st",
      "source": "(*\n * CO_SDO_WRITE: writes DATA (SIZE 1 to 4 bytes, least significant first as\n * CANopen sends it) to object INDEX:SUBINDEX of node NODE (1..127) of\n * CANopen master network NETWORK, through the bridge's SDO registers; the\n * config needs \"sdo_bridge_write\": true.\n * A rising edge of EXECUTE starts it; BUSY until the bridge has an answer,\n * then DONE or ERROR with ERROR_ID (docs/plc-sdo.md): 1 the node aborted\n * (ABORT_CODE), 2 no answer within TIMEOUT (T#0s: 5 s), 6 invalid input,\n * 20 the bridge is not reachable, 21 SDO writes are not allowed by the\n * config (ABORT_CODE 16#08000020), 22 the config has no SDO registers.\n * Instances share the SDO registers: one waits while another uses them.\n *)\n(*\n * LINK is the generated `canworks.link` (ARRAY[0..88] OF WORD): the\n * bridge's blocks as canworks_in and canworks_out copy them from and to the\n * Modbus registers every scan, one word per register (high byte = the\n * bridge's even byte). Words: 0-3 status block, 4-6 control block, 7-13 SDO\n * request, 14-20 SDO response, 21 flags (bit 0 the bridge answers with this\n * program's map, 1 a control block, 2 SDO registers, 8 + n a live list for\n * network n), 22 control block owner, 23 SDO owner, 24 last instance number,\n * 25 + 8n .. 32 + 8n the live list of network n (n 0..7).\n *)\nFUNCTION_BLOCK CO_SDO_WRITE\nVAR_INPUT\n  EXECUTE : BOOL;\n  NETWORK : USINT;\n  NODE : USINT;\n  INDEX : UINT;\n  SUBINDEX : USINT;\n  DATA : UDINT;\n  SIZE : USINT;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  BUSY : BOOL;\n  DONE : BOOL;\n  ERROR : BOOL;\n  ERROR_ID : UINT;\n  ABORT_CODE : UDINT;\nEND_VAR\nVAR_IN_OUT\n  LINK : ARRAY[0..88] OF WORD;\nEND_VAR\nVAR\n  me : WORD;\n  prev : BOOL;\n  phase : USINT;           (* 0 idle, 1 waiting for the SDO registers, 2 sent, 3 ended *)\n  counter : WORD;\n  timer : TON;\n  state : WORD;\n  err : UINT;\n  fin : BOOL;\nEND_VAR\n  IF me = 0 THEN\n    LINK[24] := LINK[24] + 1;\n    me := LINK[24];\n  END_IF;\n  IF phase = 3 AND NOT EXECUTE THEN\n    phase := 0;\n    DONE := FALSE;\n    ERROR := FALSE;\n  END_IF;\n  err := 0;\n  fin := FALSE;\n  IF phase = 0 AND EXECUTE AND NOT prev THEN\n    DONE := FALSE;\n    ERROR := FALSE;\n    ERROR_ID := 0;\n    ABORT_CODE := 0;\n    timer(IN := FALSE);\n    IF (LINK[21] AND 16#0001) = 0 THEN\n      err := 20;\n    ELSIF (LINK[21] AND 16#0004) = 0 THEN\n      err := 22;\n    ELSIF NODE < 1 OR NODE > 127 OR SIZE < 1 OR SIZE > 4 THEN\n      err := 6;\n    ELSE\n      phase := 1;\n    END_IF;\n  END_IF;\n  IF phase = 1 OR phase = 2 THEN\n    timer(IN := TRUE, PT := SEL(TIMEOUT = T#0s, TIMEOUT, T#5s));\n    IF (LINK[21] AND 16#0001) = 0 THEN\n      err := 20;\n    ELSIF timer.Q THEN\n      err := 2;\n      ABORT_CODE := 16#05040000;\n    ELSIF phase = 1 AND (LINK[23] = 0 OR LINK[23] = me) THEN\n      LINK[23] := me;\n      counter := LINK[14] + 1;\n      LINK[7] := counter;\n      LINK[8] := SHL(WORD#2, 8) OR USINT_TO_WORD(NETWORK);\n      LINK[9] := SHL(USINT_TO_WORD(NODE), 8) OR USINT_TO_WORD(SUBINDEX);\n      LINK[10] := UINT_TO_WORD(INDEX);\n      LINK[11] := SHL(USINT_TO_WORD(SIZE), 8);\n      LINK[12] := DWORD_TO_WORD(SHR(UDINT_TO_DWORD(DATA), 16));\n      LINK[13] := DWORD_TO_WORD(UDINT_TO_DWORD(DATA));\n      phase := 2;\n    ELSIF phase = 2 AND LINK[14] = counter THEN\n      state := SHR(LINK[15], 8);\n      IF state = 2 THEN\n        fin := TRUE;\n      ELSIF state = 3 THEN\n        ABORT_CODE := DWORD_TO_UDINT(SHL(WORD_TO_DWORD(LINK[16]), 16) OR WORD_TO_DWORD(LINK[17]));\n        IF ABORT_CODE = 16#08000020 THEN\n          err := 21;\n        ELSE\n          err := 1;\n        END_IF;\n      END_IF;\n    END_IF;\n  END_IF;\n  IF err <> 0 OR fin THEN\n    phase := 3;\n    DONE := fin;\n    ERROR := err <> 0;\n    ERROR_ID := err;\n    timer(IN := FALSE);\n    IF LINK[23] = me THEN\n      LINK[23] := 0;\n    END_IF;\n  END_IF;\n  BUSY := phase = 1 OR phase = 2;\n  prev := EXECUTE;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CW_REAL.st",
      "source": "FUNCTION CW_DWORD_TO_REAL : REAL\n(* The REAL whose IEEE 754 bit pattern is IN (a 32-bit value read from two\n   Modbus registers). Infinities come back as +/-3.4E38, NaN as 0.0. *)\nVAR_INPUT\n  IN : DWORD;\nEND_VAR\nVAR\n  e : INT;\n  m : LREAL;\n  x : LREAL;\nEND_VAR\ne := DWORD_TO_INT(SHR(IN, 23) AND 16#FF);\nm := DWORD_TO_LREAL(IN AND 16#7FFFFF);\nIF e = 255 THEN\n  IF m <> 0.0 THEN\n    x := 0.0;\n  ELSE\n    x := 3.4028234663852886E38;\n  END_IF;\nELSIF e = 0 THEN\n  x := m * EXPT(2.0, -149);\nELSE\n  x := (m + 8388608.0) * EXPT(2.0, e - 150);\nEND_IF;\nIF (IN AND 16#80000000) <> 0 THEN\n  x := -x;\nEND_IF;\nCW_DWORD_TO_REAL := LREAL_TO_REAL(x);\nEND_FUNCTION\n\nFUNCTION CW_REAL_TO_DWORD : DWORD\n(* The IEEE 754 bit pattern of IN, to send a REAL in two Modbus registers. *)\nVAR_INPUT\n  IN : REAL;\nEND_VAR\nVAR\n  a : LREAL;\n  e : INT;\n  sign : DWORD;\nEND_VAR\na := REAL_TO_LREAL(IN);\nsign := 0;\nIF a < 0.0 THEN\n  sign := 16#80000000;\n  a := -a;\nEND_IF;\nIF a <> a THEN\n  CW_REAL_TO_DWORD := 16#7FC00000;\n  RETURN;\nEND_IF;\nIF a = 0.0 THEN\n  CW_REAL_TO_DWORD := sign;\n  RETURN;\nEND_IF;\nIF a > 3.4028234663852886E38 THEN\n  CW_REAL_TO_DWORD := sign OR 16#7F800000;\n  RETURN;\nEND_IF;\ne := LREAL_TO_INT(TRUNC(LN(a) / LN(2.0)));\nWHILE a / EXPT(2.0, e) >= 2.0 DO\n  e := e + 1;\nEND_WHILE;\nWHILE a / EXPT(2.0, e) < 1.0 DO\n  e := e - 1;\nEND_WHILE;\nIF e < -126 THEN\n  CW_REAL_TO_DWORD := sign OR LREAL_TO_DWORD(a * EXPT(2.0, 149));\nELSE\n  CW_REAL_TO_DWORD := sign OR SHL(INT_TO_DWORD(e + 127), 23) OR LREAL_TO_DWORD((a / EXPT(2.0, e) - 1.0) * 8388608.0);\nEND_IF;\nEND_FUNCTION\n\nFUNCTION CW_LWORD_TO_LREAL : LREAL\n(* The LREAL whose IEEE 754 bit pattern is IN (a 64-bit value read from four\n   Modbus registers). Infinities come back as +/-1.79E308, NaN as 0.0. *)\nVAR_INPUT\n  IN : LWORD;\nEND_VAR\nVAR\n  e : INT;\n  m : LREAL;\n  x : LREAL;\nEND_VAR\ne := LWORD_TO_INT(SHR(IN, 52) AND 16#7FF);\nm := LWORD_TO_LREAL(IN AND 16#FFFFFFFFFFFFF);\nIF e = 2047 THEN\n  IF m <> 0.0 THEN\n    x := 0.0;\n  ELSE\n    x := 1.7976931348623157E308;\n  END_IF;\nELSIF e = 0 THEN\n  x := m * EXPT(2.0, -1074);\nELSE\n  x := (m + 4503599627370496.0) * EXPT(2.0, e - 1075);\nEND_IF;\nIF (IN AND 16#8000000000000000) <> 0 THEN\n  x := -x;\nEND_IF;\nCW_LWORD_TO_LREAL := x;\nEND_FUNCTION\n\nFUNCTION CW_LREAL_TO_LWORD : LWORD\n(* The IEEE 754 bit pattern of IN, to send an LREAL in four Modbus registers. *)\nVAR_INPUT\n  IN : LREAL;\nEND_VAR\nVAR\n  a : LREAL;\n  e : INT;\n  sign : LWORD;\nEND_VAR\na := IN;\nsign := 0;\nIF a < 0.0 THEN\n  sign := 16#8000000000000000;\n  a := -a;\nEND_IF;\nIF a <> a THEN\n  CW_LREAL_TO_LWORD := 16#7FF8000000000000;\n  RETURN;\nEND_IF;\nIF a = 0.0 THEN\n  CW_LREAL_TO_LWORD := sign;\n  RETURN;\nEND_IF;\nIF a > 1.7976931348623157E308 THEN\n  CW_LREAL_TO_LWORD := sign OR 16#7FF0000000000000;\n  RETURN;\nEND_IF;\ne := LREAL_TO_INT(TRUNC(LN(a) / LN(2.0)));\nWHILE a / EXPT(2.0, e) >= 2.0 DO\n  e := e + 1;\nEND_WHILE;\nWHILE a / EXPT(2.0, e) < 1.0 DO\n  e := e - 1;\nEND_WHILE;\nIF e < -1022 THEN\n  CW_LREAL_TO_LWORD := sign OR LREAL_TO_LWORD(a * EXPT(2.0, 537) * EXPT(2.0, 537));\nELSE\n  CW_LREAL_TO_LWORD := sign OR SHL(INT_TO_LWORD(e + 1023), 52) OR LREAL_TO_LWORD((a / EXPT(2.0, e) - 1.0) * 4503599627370496.0);\nEND_IF;\nEND_FUNCTION\n"
    },
    {
      "fileName": "J1939_DTC_MAKE.st",
      "source": "(*\n * J1939_DTC_MAKE: a trouble code as the J1939 blocks give it (spec\n * j1939-plc-diagnostics): SPN + FMI * 2^19 + OC * 2^24, the conversion\n * method bit clear. Each part is cut to its width (SPN 19 bits, FMI 5, OC 7).\n *)\nFUNCTION J1939_DTC_MAKE : UDINT\nVAR_INPUT\n  SPN : UDINT;\n  FMI : USINT;\n  OC : USINT;\nEND_VAR\n  J1939_DTC_MAKE := (SPN AND 16#7FFFF) OR SHL(USINT_TO_UDINT(FMI) AND 16#1F, 19)\n                    OR SHL(USINT_TO_UDINT(OC) AND 16#7F, 24);\nEND_FUNCTION\n"
    },
    {
      "fileName": "J1939_DTC_SPLIT.st",
      "source": "(*\n * J1939_DTC_SPLIT: the parts of a trouble code as the J1939 blocks and the\n * diagnostics.rx locations give it (spec j1939-plc-diagnostics):\n * DTC = SPN + FMI * 2^19 + OC * 2^24 + CM * 2^31.\n *)\nFUNCTION_BLOCK J1939_DTC_SPLIT\nVAR_INPUT\n  DTC : UDINT;\nEND_VAR\nVAR_OUTPUT\n  SPN : UDINT;\n  FMI : USINT;\n  OC : USINT;\n  CM : BOOL;\nEND_VAR\n  SPN := DTC AND 16#7FFFF;\n  FMI := UDINT_TO_USINT(SHR(DTC, 19) AND 16#1F);\n  OC := UDINT_TO_USINT(SHR(DTC, 24) AND 16#7F);\n  CM := (DTC AND 16#80000000) <> 0;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "J1939_GET_BITS.st",
      "source": "(*\n * J1939_GET_BITS: a signal's raw value from a J1939 message of any length\n * (spec j1939-plc-blocks, \"J1939 ST functions\"). J1939 sends signals\n * little-endian: START_BIT is the least significant bit, bit 0 being the\n * least significant bit of byte 0. BIT_LENGTH 1..64; SIGNED sign-extends.\n * Bits outside the 1785 bytes read as 0.\n *)\nFUNCTION J1939_GET_BITS : LINT\nVAR_IN_OUT\n  DATA : ARRAY[0..1784] OF BYTE;\nEND_VAR\nVAR_INPUT\n  START_BIT : UINT;\n  BIT_LENGTH : USINT;\n  SIGNED : BOOL;\nEND_VAR\nVAR\n  i : DINT;\n  pos : DINT;\n  bitv : LWORD;\n  v : LWORD;\nEND_VAR\n  v := 0;\n  pos := UINT_TO_DINT(START_BIT);\n  FOR i := 0 TO USINT_TO_DINT(BIT_LENGTH) - 1 DO\n    IF i < 64 AND pos < 14280 THEN\n      bitv := BYTE_TO_LWORD(SHR(DATA[pos / 8], DINT_TO_UINT(pos MOD 8)) AND 16#01);\n      v := v OR SHL(bitv, DINT_TO_UINT(i));\n    END_IF;\n    pos := pos + 1;\n  END_FOR;\n  IF SIGNED AND BIT_LENGTH > 0 AND BIT_LENGTH < 64 THEN\n    IF (SHR(v, USINT_TO_UINT(BIT_LENGTH) - 1) AND 16#01) = 1 THEN\n      v := v OR SHL(LWORD#16#FFFFFFFFFFFFFFFF, USINT_TO_UINT(BIT_LENGTH));\n    END_IF;\n  END_IF;\n  J1939_GET_BITS := LWORD_TO_LINT(v);\nEND_FUNCTION\n"
    },
    {
      "fileName": "J1939_NAME_MAKE.st",
      "source": "(*\n * J1939_NAME_MAKE: a 64-bit J1939 NAME from its fields (spec\n * j1939-plc-blocks), packed as the config's ecu.name and the PC tools pack\n * it. Each field is cut to its width.\n *)\nFUNCTION J1939_NAME_MAKE : LWORD\nVAR_INPUT\n  IDENTITY_NUMBER : UDINT;\n  MANUFACTURER_CODE : UINT;\n  ECU_INSTANCE : USINT;\n  FUNCTION_INSTANCE : USINT;\n  ECU_FUNCTION : USINT;\n  VEHICLE_SYSTEM : USINT;\n  VEHICLE_SYSTEM_INSTANCE : USINT;\n  INDUSTRY_GROUP : USINT;\n  ARBITRARY_ADDRESS_CAPABLE : BOOL;\nEND_VAR\nVAR\n  n : LWORD;\nEND_VAR\n  n := UDINT_TO_LWORD(IDENTITY_NUMBER) AND 16#1FFFFF;\n  n := n OR SHL(UINT_TO_LWORD(MANUFACTURER_CODE) AND 16#7FF, 21);\n  n := n OR SHL(USINT_TO_LWORD(ECU_INSTANCE) AND 16#7, 32);\n  n := n OR SHL(USINT_TO_LWORD(FUNCTION_INSTANCE) AND 16#1F, 35);\n  n := n OR SHL(USINT_TO_LWORD(ECU_FUNCTION) AND 16#FF, 40);\n  n := n OR SHL(USINT_TO_LWORD(VEHICLE_SYSTEM) AND 16#7F, 49);\n  n := n OR SHL(USINT_TO_LWORD(VEHICLE_SYSTEM_INSTANCE) AND 16#F, 56);\n  n := n OR SHL(USINT_TO_LWORD(INDUSTRY_GROUP) AND 16#7, 60);\n  IF ARBITRARY_ADDRESS_CAPABLE THEN\n    n := n OR LWORD#16#8000000000000000;\n  END_IF;\n  J1939_NAME_MAKE := n;\nEND_FUNCTION\n"
    },
    {
      "fileName": "J1939_NAME_SPLIT.st",
      "source": "(*\n * J1939_NAME_SPLIT: the fields of a 64-bit J1939 NAME (spec\n * j1939-plc-blocks), the reverse of J1939_NAME_MAKE.\n *)\nFUNCTION_BLOCK J1939_NAME_SPLIT\nVAR_INPUT\n  NAME : LWORD;\nEND_VAR\nVAR_OUTPUT\n  IDENTITY_NUMBER : UDINT;\n  MANUFACTURER_CODE : UINT;\n  ECU_INSTANCE : USINT;\n  FUNCTION_INSTANCE : USINT;\n  ECU_FUNCTION : USINT;\n  VEHICLE_SYSTEM : USINT;\n  VEHICLE_SYSTEM_INSTANCE : USINT;\n  INDUSTRY_GROUP : USINT;\n  ARBITRARY_ADDRESS_CAPABLE : BOOL;\nEND_VAR\n  IDENTITY_NUMBER := LWORD_TO_UDINT(NAME AND 16#1FFFFF);\n  MANUFACTURER_CODE := LWORD_TO_UINT(SHR(NAME, 21) AND 16#7FF);\n  ECU_INSTANCE := LWORD_TO_USINT(SHR(NAME, 32) AND 16#7);\n  FUNCTION_INSTANCE := LWORD_TO_USINT(SHR(NAME, 35) AND 16#1F);\n  ECU_FUNCTION := LWORD_TO_USINT(SHR(NAME, 40) AND 16#FF);\n  VEHICLE_SYSTEM := LWORD_TO_USINT(SHR(NAME, 49) AND 16#7F);\n  VEHICLE_SYSTEM_INSTANCE := LWORD_TO_USINT(SHR(NAME, 56) AND 16#F);\n  INDUSTRY_GROUP := LWORD_TO_USINT(SHR(NAME, 60) AND 16#7);\n  ARBITRARY_ADDRESS_CAPABLE := (NAME AND LWORD#16#8000000000000000) <> 0;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "J1939_SET_BITS.st",
      "source": "(*\n * J1939_SET_BITS: writes a signal's raw value into a J1939 message of any\n * length, little-endian with the bit numbering of J1939_GET_BITS; the other\n * bits stay as they are. Returns TRUE, or FALSE (and writes nothing) when a\n * bit would fall outside the 1785 bytes or BIT_LENGTH is not 1..64.\n *)\nFUNCTION J1939_SET_BITS : BOOL\nVAR_IN_OUT\n  DATA : ARRAY[0..1784] OF BYTE;\nEND_VAR\nVAR_INPUT\n  START_BIT : UINT;\n  BIT_LENGTH : USINT;\n  VALUE : LINT;\nEND_VAR\nVAR\n  i : DINT;\n  pos : DINT;\n  v : LWORD;\n  b : BYTE;\nEND_VAR\n  IF BIT_LENGTH = 0 OR BIT_LENGTH > 64 OR UINT_TO_DINT(START_BIT) + USINT_TO_DINT(BIT_LENGTH) > 14280 THEN\n    J1939_SET_BITS := FALSE;\n    RETURN;\n  END_IF;\n  v := LINT_TO_LWORD(VALUE);\n  pos := UINT_TO_DINT(START_BIT);\n  FOR i := 0 TO USINT_TO_DINT(BIT_LENGTH) - 1 DO\n    b := SHL(BYTE#1, DINT_TO_UINT(pos MOD 8));\n    IF (SHR(v, DINT_TO_UINT(i)) AND 16#01) = 1 THEN\n      DATA[pos / 8] := DATA[pos / 8] OR b;\n    ELSE\n      DATA[pos / 8] := DATA[pos / 8] AND NOT b;\n    END_IF;\n    pos := pos + 1;\n  END_FOR;\n  J1939_SET_BITS := TRUE;\nEND_FUNCTION\n"
    }
  ]
}