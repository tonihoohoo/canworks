    {
      "name": "CO_RECV_EMCY",
      "kind": "functionBlock",
      "header": "class CO_RECV_EMCY {\npublic:\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_BOOL SKIP_OLD;\n    // In-Out\n    Array1D<IEC_BYTE, 0, 4> MSEF;\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL ACTIVE;\n    IEC_BOOL NEW;\n    IEC_USINT EMCY_NODE;\n    IEC_WORD ERROR_CODE;\n    IEC_BYTE ERROR_REGISTER;\n    IEC_ULINT TIMESTAMP;\n    IEC_UINT QUEUED;\n    IEC_BOOL OVERFLOW;\n    IEC_UDINT LOST;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    CW_RX RX;\n    IEC_BOOL PREV;\n    IEC_BOOL WAS_ACTIVE;\n    IEC_WORD LAST_DROP;\n    IEC_UDINT LOST_NOW;\n    IEC_BOOL RESTART;\n    IEC_INT R;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_RECV_EMCY();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_RECV_EMCY() = default;\n};\n",
      "cpp": "CO_RECV_EMCY::CO_RECV_EMCY() {\n    // Initialize variables\n}\n\nvoid CO_RECV_EMCY::operator()() {\n    NEW = false;\n    RESTART = false;\n    if ((ENABLE) & (!PREV)) {\n        QUEUED = 0;\n        OVERFLOW = false;\n        LOST = 0;\n    } else if ((!ENABLE) & (PREV)) {\n        QUEUED = 0;\n        OVERFLOW = false;\n    }\n    PREV = ENABLE;\n    RX.ENABLE = ENABLE;\n    RX.CHANGED = false;\n    RX.NEXT = true;\n    RX.KIND = 3;\n    RX.NETWORK = NETWORK;\n    RX.FLAGS = SEL(SKIP_OLD, static_cast<IEC_USINT>(0), static_cast<IEC_USINT>(1));\n    RX.DEPTH = 0;\n    RX.ID = 0;\n    RX.MASK = TO_UDINT(NODE);\n    RX.RETRY = 0x00100110;\n    RX.LINK = LINK;\n    RX();\n    RX.ENO = true;\n    LINK = RX.LINK;\n    if ((RX.ACTIVE) & (!WAS_ACTIVE)) {\n        LAST_DROP = 0;\n    }\n    WAS_ACTIVE = RX.ACTIVE;\n    if (RX.NEW) {\n        R = RX.REC;\n        QUEUED = TO_UINT(LINK.at(R + 1));\n        LOST_NOW = TO_UDINT(((LINK.at(R + 2) - LAST_DROP)) & (0xFFFF));\n        LAST_DROP = LINK.at(R + 2);\n        LOST = LOST + LOST_NOW;\n        if (LOST_NOW != 0) {\n            OVERFLOW = true;\n        }\n        if (((LINK.at(R)) & (0x0002)) != 0) {\n            RESTART = true;\n        } else {\n            NEW = true;\n            TIMESTAMP = (((SHL(TO_ULINT(LINK.at(R + 3)), 48)) | (SHL(TO_ULINT(LINK.at(R + 4)), 32))) | (SHL(TO_ULINT(LINK.at(R + 5)), 16))) | (TO_ULINT(LINK.at(R + 6)));\n            EMCY_NODE = TO_USINT(SHR(LINK.at(R + 7), 8));\n            ERROR_REGISTER = TO_BYTE(LINK.at(R + 7));\n            ERROR_CODE = LINK.at(R + 8);\n            MSEF.at(0) = TO_BYTE(SHR(LINK.at(R + 9), 8));\n            MSEF.at(1) = TO_BYTE(LINK.at(R + 9));\n            MSEF.at(2) = TO_BYTE(SHR(LINK.at(R + 10), 8));\n            MSEF.at(3) = TO_BYTE(LINK.at(R + 10));\n            MSEF.at(4) = TO_BYTE(SHR(LINK.at(R + 11), 8));\n        }\n    }\n    ACTIVE = RX.ACTIVE;\n    ERROR = (RX.ERROR) | (RESTART);\n    ERROR_ID = SEL(RESTART, RX.ERROR_ID, static_cast<IEC_UINT>(8));\n}\n",
