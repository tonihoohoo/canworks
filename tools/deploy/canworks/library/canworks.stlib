    {
      "name": "CAN_SEND_CYCLIC",
      "kind": "functionBlock",
      "header": "class CAN_SEND_CYCLIC {\npublic:\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_USINT NETWORK;\n    IEC_UDINT ID;\n    IEC_BOOL EXTENDED;\n    IEC_USINT DLC;\n    IEC_TIME PERIOD;\n    // In-Out\n    Array1D<IEC_BYTE, 0, 7> DATA;\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL ACTIVE;\n    IEC_UDINT COUNT;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    CW_MB_CALL MB;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_INT JOB;\n    IEC_WORD GEN;\n    IEC_WORD TICK0;\n    Array1D<IEC_BYTE, 0, 7> SENT;\n    IEC_USINT SENT_DLC;\n    IEC_UDINT SENT_MS;\n    IEC_UDINT MS;\n    IEC_BOOL CHANGED;\n    IEC_INT T;\n    IEC_INT I;\n    IEC_UINT ERR;\n    IEC_BOOL FRESH;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CAN_SEND_CYCLIC();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CAN_SEND_CYCLIC() = default;\n};\n",
      "cpp": "CAN_SEND_CYCLIC::CAN_SEND_CYCLIC() {\n    // Initialize variables\n}\n\nvoid CAN_SEND_CYCLIC::operator()() {\n    ERR = 0;\n    MS = TO_UDINT(TIME_TO_MS(PERIOD));\n    if (MS > 65535) {\n        MS = 65535;\n    }\n    if ((ENABLE) & (!PREV)) {\n        COUNT = 0;\n        ERROR = false;\n        ERROR_ID = 0;\n    }\n    if ((((LINK.at(21)) & (0x0001)) == 0) & (PHASE != 0)) {\n        MB.RUN = false;\n        MB.LINK = LINK;\n        MB();\n        MB.ENO = true;\n        LINK = MB.LINK;\n        PHASE = 0;\n        if (ENABLE) {\n            ERR = 20;\n        }\n    }\n    if ((PHASE == 2) | (PHASE == 3)) {\n        LINK.at(128 + JOB) = LINK.at(128 + JOB) + 1;\n        T = 985 + 4 * JOB;\n        FRESH = (((LINK.at(984) - TICK0)) & (0x8000)) == 0;\n        if ((FRESH) & (LINK.at(T + 1) != GEN)) {\n            MB.RUN = false;\n            MB.LINK = LINK;\n            MB();\n            MB.ENO = true;\n            LINK = MB.LINK;\n            PHASE = 0;\n            ERR = 8;\n        } else if (FRESH) {\n            COUNT = TO_UDINT(LINK.at(T + 2)) * 65536 + TO_UDINT(LINK.at(T + 3));\n            if (SHR(LINK.at(T), 8) == 2) {\n                ERROR = true;\n                ERROR_ID = TO_UINT((LINK.at(T)) & (0x00FF));\n            } else if ((ERROR) & (ERROR_ID == 7)) {\n                ERROR = false;\n                ERROR_ID = 0;\n            }\n        }\n    }\n    if ((((PHASE == 2) | (PHASE == 3))) & (!ENABLE)) {\n        PHASE = 4;\n    }\n    CHANGED = (DLC != SENT_DLC) | (MS != SENT_MS);\n    for (I = 0; I <= 7; I++) {\n        if (DATA.at(I) != SENT.at(I)) {\n            CHANGED = true;\n        }\n    }\n    if ((PHASE == 2) & (CHANGED)) {\n        PHASE = 3;\n    }\n    if ((((PHASE == 0) & (ENABLE)) & (ERR == 0)) & (NOT(((((ERROR) & (ERROR_ID != 1)) & (ERROR_ID != 7)) & (ERROR_ID != 8)) & (ERROR_ID != 20)))) {\n        ERROR = false;\n        ERROR_ID = 0;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if ((((LINK.at(89)) & (0x0007)) == 0) | (((LINK.at(89)) & (0x1F00)) == 0)) {\n            ERR = 22;\n        } else if (DLC > 8) {\n            ERR = 3;\n        } else {\n            PHASE = 1;\n        }\n    }\n    if (((PHASE == 1) | (PHASE == 3)) | (PHASE == 4)) {\n        MB.RUN = true;\n        MB.SEND = false;\n        MB.LINK = LINK;\n        MB();\n        MB.ENO = true;\n        LINK = MB.LINK;\n        if (MB.LOST) {\n            PHASE = 0;\n            ERR = SEL(ENABLE, static_cast<IEC_UINT>(0), static_cast<IEC_UINT>(20));\n        } else if (MB.ANSWERED) {\n            if (PHASE == 4) {\n                PHASE = 0;\n            } else if (MB.ERR != 0) {\n                ERR = MB.ERR;\n                if ((PHASE == 1) | (MB.ERR == 8)) {\n                    PHASE = 0;\n                } else {\n                    PHASE = 2;\n                }\n            } else {\n                if (PHASE == 1) {\n                    JOB = TO_INT(LINK.at(MB.BASE + 74));\n                    GEN = LINK.at(MB.BASE + 75);\n                    TICK0 = LINK.at(MB.BASE + 76);\n                    COUNT = 0;\n                }\n                PHASE = 2;\n            }\n            MB.RUN = false;\n            MB.LINK = LINK;\n            MB();\n            MB.ENO = true;\n            LINK = MB.LINK;\n        } else if ((MB.OWNED) & (!MB.WAITING)) {\n            if (PHASE == 4) {\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = 7;\n                MB.NET = NETWORK;\n                MB.A0 = TO_WORD(JOB);\n                MB.A1 = 0;\n                MB.A2 = 0;\n                MB.A3 = 0;\n                MB.A4 = 0;\n                MB.A5 = 0;\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            } else {\n                for (I = 0; I <= 3; I++) {\n                    LINK.at(MB.BASE + 8 + I) = (SHL(TO_WORD(DATA.at(2 * I)), 8)) | (TO_WORD(DATA.at(2 * I + 1)));\n                    SENT.at(2 * I) = DATA.at(2 * I);\n                    SENT.at(2 * I + 1) = DATA.at(2 * I + 1);\n                }\n                SENT_DLC = DLC;\n                SENT_MS = MS;\n                MB.RUN = true;\n                MB.SEND = true;\n                MB.OP = 6;\n                MB.NET = NETWORK;\n                MB.A0 = SEL(PHASE == 1, TO_WORD(JOB), static_cast<IEC_WORD>(0xFFFF));\n                MB.A1 = TO_WORD(SHR(ID, 16));\n                MB.A2 = TO_WORD(ID);\n                MB.A3 = (SHL(SEL(EXTENDED, static_cast<IEC_WORD>(0), static_cast<IEC_WORD>(1)), 8)) | (TO_WORD(DLC));\n                MB.A4 = TO_WORD(MS);\n                MB.A5 = 0;\n                MB.LINK = LINK;\n                MB();\n                MB.ENO = true;\n                LINK = MB.LINK;\n            }\n        }\n    }\n    if (ERR != 0) {\n        ERROR = true;\n        ERROR_ID = ERR;\n    }\n    ACTIVE = (PHASE == 2) | (PHASE == 3);\n    PREV = ENABLE;\n}\n",
