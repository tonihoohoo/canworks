    {
      "name": "CAN_SEND",
      "kind": "functionBlock",
      "header": "class CAN_SEND {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_UDINT ID;\n    IEC_BOOL EXTENDED;\n    IEC_BOOL RTR;\n    IEC_USINT DLC;\n    IEC_TIME TIMEOUT;\n    // In-Out\n    Array1D<IEC_BYTE, 0, 7> DATA;\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    CW_REQUEST X;\n    Array1D<IEC_BYTE, 0, 1784> BUF;\n    IEC_BOOL PREV;\n    IEC_UINT REFUSED;\n    IEC_WORD FLAGS;\n    IEC_UDINT MS;\n    IEC_INT I;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CAN_SEND();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CAN_SEND() = default;\n};\n",
      "cpp": "CAN_SEND::CAN_SEND() {\n    // Initialize variables\n}\n\nvoid CAN_SEND::operator()() {\n    if (((EXECUTE) & (!PREV)) & (!X.BUSY)) {\n        REFUSED = 0;\n        if (DLC > 8) {\n            REFUSED = 3;\n        }\n        for (I = 0; I <= 7; I++) {\n            BUF.at(I) = DATA.at(I);\n        }\n    } else if (!EXECUTE) {\n        REFUSED = 0;\n    }\n    PREV = EXECUTE;\n    FLAGS = (SEL(EXTENDED, static_cast<IEC_WORD>(0), static_cast<IEC_WORD>(1))) | (SEL(RTR, static_cast<IEC_WORD>(0), static_cast<IEC_WORD>(2)));\n    MS = TO_UDINT(TIME_TO_MS(TIMEOUT));\n    if (MS > 65535) {\n        MS = 65535;\n    }\n    X.EXECUTE = (EXECUTE) & (REFUSED == 0);\n    X.OP = 5;\n    X.NET = NETWORK;\n    X.A0 = TO_WORD(SHR(ID, 16));\n    X.A1 = TO_WORD(ID);\n    X.A2 = (SHL(FLAGS, 8)) | (TO_WORD(DLC));\n    X.A3 = TO_WORD(MS);\n    X.A4 = 0;\n    X.A5 = 0;\n    X.LENGTH = 8;\n    X.FETCH_MAX = 0;\n    X.LINK = LINK;\n    X.DATA = BUF;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUF = X.DATA;\n    BUSY = X.BUSY;\n    DONE = X.DONE;\n    ERROR = (X.ERROR) | (REFUSED != 0);\n    ERROR_ID = SEL(REFUSED != 0, X.ERROR_ID, REFUSED);\n}\n",
