    {
      "name": "CO_NODE_LIVE",
      "kind": "functionBlock",
      "header": "class CO_NODE_LIVE {\npublic:\n    // Inputs\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    // Outputs\n    IEC_BOOL LIVE;\n    // In-Out\n    Array1D<IEC_WORD, 0, 88> LINK;\n    // Local variables\n    IEC_INT BYTE_NO;\n    IEC_WORD WORD;\n    IEC_INT BIT_NO;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_NODE_LIVE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_NODE_LIVE() = default;\n};\n",
      "cpp": "CO_NODE_LIVE::CO_NODE_LIVE() {\n    // Initialize variables\n}\n\nvoid CO_NODE_LIVE::operator()() {\n    LIVE = false;\n    if ((((((LINK.at(21)) & (0x0001)) != 0) & (NETWORK < 8)) & (NODE >= 1)) & (NODE <= 127)) {\n        if (((SHR(LINK.at(21), TO_UINT(NETWORK) + 8)) & (0x0001)) != 0) {\n            BYTE_NO = TO_INT(NODE) / 8;\n            WORD = LINK.at(25 + TO_INT(NETWORK) * 8 + BYTE_NO / 2);\n            BIT_NO = TO_INT(NODE) % 8;\n            if (BYTE_NO % 2 == 0) {\n                BIT_NO = BIT_NO + 8;\n            }\n            LIVE = ((SHR(WORD, TO_UINT(BIT_NO))) & (0x0001)) != 0;\n        }\n    }\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CO_SDO_READ",
      "kind": "functionBlock",
      "header": "class CO_SDO_READ {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    IEC_UDINT DATA;\n    // In-Out\n    Array1D<IEC_WORD, 0, 88> LINK;\n    // Local variables\n    IEC_WORD ME;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_WORD COUNTER;\n    TON TIMER;\n    IEC_WORD STATE;\n    IEC_UINT ERR;\n    IEC_BOOL FIN;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_READ();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_READ() = default;\n};\n",
      "cpp": "CO_SDO_READ::CO_SDO_READ() {\n    // Initialize variables\n}\n\nvoid CO_SDO_READ::operator()() {\n    if (ME == 0) {\n        LINK.at(24) = LINK.at(24) + 1;\n        ME = LINK.at(24);\n    }\n    if ((PHASE == 3) & (!EXECUTE)) {\n        PHASE = 0;\n        DONE = false;\n        ERROR = false;\n    }\n    ERR = 0;\n    FIN = false;\n    if (((PHASE == 0) & (EXECUTE)) & (!PREV)) {\n        DONE = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        ABORT_CODE = 0;\n        DATA = 0;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (((LINK.at(21)) & (0x0004)) == 0) {\n            ERR = 22;\n        } else if ((NODE < 1) | (NODE > 127)) {\n            ERR = 6;\n        } else {\n            PHASE = 1;\n        }\n    }\n    if ((PHASE == 1) | (PHASE == 2)) {\n        TIMER.IN = true;\n        TIMER.PT = SEL(TIMEOUT == 0LL, TIMEOUT, 5000000000LL);\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (TIMER.Q) {\n            ERR = 2;\n            ABORT_CODE = 0x05040000;\n        } else if ((PHASE == 1) & (((LINK.at(23) == 0) | (LINK.at(23) == ME)))) {\n            LINK.at(23) = ME;\n            COUNTER = LINK.at(14) + 1;\n            LINK.at(7) = COUNTER;\n            LINK.at(8) = (SHL(static_cast<IEC_WORD>(1), 8)) | (TO_WORD(NETWORK));\n            LINK.at(9) = (SHL(TO_WORD(NODE), 8)) | (TO_WORD(SUBINDEX));\n            LINK.at(10) = TO_WORD(INDEX);\n            LINK.at(11) = 0;\n            LINK.at(12) = 0;\n            LINK.at(13) = 0;\n            PHASE = 2;\n        } else if ((PHASE == 2) & (LINK.at(14) == COUNTER)) {\n            STATE = SHR(LINK.at(15), 8);\n            if (STATE == 2) {\n                DATA = TO_UDINT((SHL(TO_DWORD(LINK.at(18)), 16)) | (TO_DWORD(LINK.at(19))));\n                FIN = true;\n            } else if (STATE == 3) {\n                ABORT_CODE = TO_UDINT((SHL(TO_DWORD(LINK.at(16)), 16)) | (TO_DWORD(LINK.at(17))));\n                if (ABORT_CODE == 0x08000020) {\n                    ERR = 21;\n                } else {\n                    ERR = 1;\n                }\n            }\n        }\n    }\n    if ((ERR != 0) | (FIN)) {\n        PHASE = 3;\n        DONE = FIN;\n        ERROR = ERR != 0;\n        ERROR_ID = ERR;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (LINK.at(23) == ME) {\n            LINK.at(23) = 0;\n        }\n    }\n    BUSY = (PHASE == 1) | (PHASE == 2);\n    PREV = EXECUTE;\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "TON"
        },
        {
          "library": "iec-std-functions",
          "name": "SEL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        }
      ]
    },
    {
      "name": "CO_SDO_WRITE",
      "kind": "functionBlock",
      "header": "class CO_SDO_WRITE {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_UDINT DATA;\n    IEC_USINT SIZE;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    // In-Out\n    Array1D<IEC_WORD, 0, 88> LINK;\n    // Local variables\n    IEC_WORD ME;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_WORD COUNTER;\n    TON TIMER;\n    IEC_WORD STATE;\n    IEC_UINT ERR;\n    IEC_BOOL FIN;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_WRITE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_WRITE() = default;\n};\n",
      "cpp": "CO_SDO_WRITE::CO_SDO_WRITE() {\n    // Initialize variables\n}\n\nvoid CO_SDO_WRITE::operator()() {\n    if (ME == 0) {\n        LINK.at(24) = LINK.at(24) + 1;\n        ME = LINK.at(24);\n    }\n    if ((PHASE == 3) & (!EXECUTE)) {\n        PHASE = 0;\n        DONE = false;\n        ERROR = false;\n    }\n    ERR = 0;\n    FIN = false;\n    if (((PHASE == 0) & (EXECUTE)) & (!PREV)) {\n        DONE = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        ABORT_CODE = 0;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (((LINK.at(21)) & (0x0004)) == 0) {\n            ERR = 22;\n        } else if ((((NODE < 1) | (NODE > 127)) | (SIZE < 1)) | (SIZE > 4)) {\n            ERR = 6;\n        } else {\n            PHASE = 1;\n        }\n    }\n    if ((PHASE == 1) | (PHASE == 2)) {\n        TIMER.IN = true;\n        TIMER.PT = SEL(TIMEOUT == 0LL, TIMEOUT, 5000000000LL);\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (TIMER.Q) {\n            ERR = 2;\n            ABORT_CODE = 0x05040000;\n        } else if ((PHASE == 1) & (((LINK.at(23) == 0) | (LINK.at(23) == ME)))) {\n            LINK.at(23) = ME;\n            COUNTER = LINK.at(14) + 1;\n            LINK.at(7) = COUNTER;\n            LINK.at(8) = (SHL(static_cast<IEC_WORD>(2), 8)) | (TO_WORD(NETWORK));\n            LINK.at(9) = (SHL(TO_WORD(NODE), 8)) | (TO_WORD(SUBINDEX));\n            LINK.at(10) = TO_WORD(INDEX);\n            LINK.at(11) = SHL(TO_WORD(SIZE), 8);\n            LINK.at(12) = TO_WORD(SHR(TO_DWORD(DATA), 16));\n            LINK.at(13) = TO_WORD(TO_DWORD(DATA));\n            PHASE = 2;\n        } else if ((PHASE == 2) & (LINK.at(14) == COUNTER)) {\n            STATE = SHR(LINK.at(15), 8);\n            if (STATE == 2) {\n                FIN = true;\n            } else if (STATE == 3) {\n                ABORT_CODE = TO_UDINT((SHL(TO_DWORD(LINK.at(16)), 16)) | (TO_DWORD(LINK.at(17))));\n                if (ABORT_CODE == 0x08000020) {\n                    ERR = 21;\n                } else {\n                    ERR = 1;\n                }\n            }\n        }\n    }\n    if ((ERR != 0) | (FIN)) {\n        PHASE = 3;\n        DONE = FIN;\n        ERROR = ERR != 0;\n        ERROR_ID = ERR;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (LINK.at(23) == ME) {\n            LINK.at(23) = 0;\n        }\n    }\n    BUSY = (PHASE == 1) | (PHASE == 2);\n    PREV = EXECUTE;\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "TON"
        },
        {
          "library": "iec-std-functions",
          "name": "SEL"
        },
        {
