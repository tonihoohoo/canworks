    {
      "name": "J1939_FIND_ECU",
      "kind": "functionBlock",
      "header": "class J1939_FIND_ECU {\npublic:\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_USINT NETWORK;\n    IEC_LWORD NAME;\n    IEC_LWORD MASK;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_BOOL VALID;\n    IEC_BOOL FOUND;\n    IEC_USINT ADDRESS;\n    IEC_LWORD FOUND_NAME;\n    IEC_UINT COUNT;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    CW_REQUEST X;\n    Array1D<IEC_BYTE, 0, 1784> BUF;\n    IEC_BOOL RUN;\n    IEC_INT I;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_FIND_ECU();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_FIND_ECU() = default;\n};\n",
      "cpp": "J1939_FIND_ECU::J1939_FIND_ECU() {\n    // Initialize variables\n}\n\nvoid J1939_FIND_ECU::operator()() {\n    if (!ENABLE) {\n        VALID = false;\n        FOUND = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        RUN = false;\n        X.EXECUTE = false;\n        X.LINK = LINK;\n        X.DATA = BUF;\n        X();\n        X.ENO = true;\n        LINK = X.LINK;\n        BUF = X.DATA;\n        return;\n    }\n    if (!X.BUSY) {\n        for (I = 0; I <= 7; I++) {\n            BUF.at(I) = TO_BYTE(SHR(NAME, 56 - 8 * I));\n            BUF.at(8 + I) = TO_BYTE(SHR(MASK, 56 - 8 * I));\n        }\n    }\n    RUN = NOT((X.DONE) | (X.ERROR));\n    X.EXECUTE = RUN;\n    X.OP = 15;\n    X.NET = NETWORK;\n    X.A0 = 0;\n    X.A1 = 0;\n    X.A2 = 0;\n    X.A3 = 0;\n    X.A4 = 0;\n    X.A5 = 0;\n    X.LENGTH = 16;\n    X.FETCH_MAX = 8;\n    X.LINK = LINK;\n    X.DATA = BUF;\n    X();\n    X.ENO = true;\n    LINK = X.LINK;\n    BUF = X.DATA;\n    if (X.DONE) {\n        VALID = true;\n        FOUND = X.R0 != 0;\n        ADDRESS = SEL(FOUND, static_cast<IEC_USINT>(254), TO_USINT(X.R1));\n        COUNT = TO_UINT(X.R2);\n        FOUND_NAME = 0;\n        for (I = 0; I <= 7; I++) {\n            FOUND_NAME = (SHL(FOUND_NAME, 8)) | (TO_LWORD(BUF.at(I)));\n        }\n        ERROR = false;\n        ERROR_ID = 0;\n    } else if (X.ERROR) {\n        VALID = false;\n        ERROR = true;\n        ERROR_ID = X.ERROR_ID;\n    }\n}\n",
