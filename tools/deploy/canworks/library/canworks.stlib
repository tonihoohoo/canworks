  "chunks": [
    {
      "name": "CO_NMT",
      "kind": "functionBlock",
      "header": "class CO_NMT {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_USINT COMMAND;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // In-Out\n    Array1D<IEC_WORD, 0, 88> LINK;\n    // Local variables\n    IEC_WORD ME;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_WORD CMD;\n    IEC_WORD COUNTER;\n    TON TIMER;\n    IEC_WORD RESULT;\n    IEC_UINT ERR;\n    IEC_BOOL FIN;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_NMT();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_NMT() = default;\n};\n",
      "cpp": "CO_NMT::CO_NMT() {\n    // Initialize variables\n}\n\nvoid CO_NMT::operator()() {\n    if (ME == 0) {\n        LINK.at(24) = LINK.at(24) + 1;\n        ME = LINK.at(24);\n    }\n    if ((PHASE == 3) & (!EXECUTE)) {\n        PHASE = 0;\n        DONE = false;\n        ERROR = false;\n    }\n    ERR = 0;\n    FIN = false;\n    if (((PHASE == 0) & (EXECUTE)) & (!PREV)) {\n        DONE = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        switch (COMMAND) {\n            case 1:\n                CMD = 3;\n                break;\n            case 2:\n                CMD = 4;\n                break;\n            case 128:\n                CMD = 5;\n                break;\n            case 129:\n                CMD = 6;\n                break;\n            case 130:\n                CMD = 7;\n                break;\n            default:\n                CMD = 0;\n                break;\n        }\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (((LINK.at(21)) & (0x0002)) == 0) {\n            ERR = 22;\n        } else if ((CMD == 0) | (NODE > 127)) {\n            ERR = 6;\n        } else {\n            PHASE = 1;\n        }\n    }\n    if ((PHASE == 1) | (PHASE == 2)) {\n        TIMER.IN = true;\n        TIMER.PT = SEL(TIMEOUT == 0LL, TIMEOUT, 5000000000LL);\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (TIMER.Q) {\n            ERR = 2;\n        } else if ((PHASE == 1) & (((LINK.at(22) == 0) | (LINK.at(22) == ME)))) {\n            LINK.at(22) = ME;\n            COUNTER = LINK.at(2) + 1;\n            LINK.at(4) = COUNTER;\n            LINK.at(5) = (SHL(CMD, 8)) | (TO_WORD(NETWORK));\n            LINK.at(6) = SHL(TO_WORD(NODE), 8);\n            PHASE = 2;\n        } else if ((PHASE == 2) & (LINK.at(2) == COUNTER)) {\n            RESULT = SHR(LINK.at(3), 8);\n            if (RESULT == 0) {\n                FIN = true;\n            } else if (RESULT == 5) {\n                ERR = 5;\n            } else {\n                ERR = 6;\n            }\n        }\n    }\n    if ((ERR != 0) | (FIN)) {\n        PHASE = 3;\n        DONE = FIN;\n        ERROR = ERR != 0;\n        ERROR_ID = ERR;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (LINK.at(22) == ME) {\n            LINK.at(22) = 0;\n        }\n    }\n    BUSY = (PHASE == 1) | (PHASE == 2);\n    PREV = EXECUTE;\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "TON"
        },
        {
          "library": "iec-std-functions",
          "name": "SEL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        }
      ]
    },
    {
      "name": "CO_NODE_LIVE",
      "kind": "functionBlock",
      "header": "class CO_NODE_LIVE {\npublic:\n    // Inputs\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    // Outputs\n    IEC_BOOL LIVE;\n    // In-Out\n    Array1D<IEC_WORD, 0, 88> LINK;\n    // Local variables\n    IEC_INT BYTE_NO;\n    IEC_WORD WORD;\n    IEC_INT BIT_NO;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_NODE_LIVE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_NODE_LIVE() = default;\n};\n",
      "cpp": "CO_NODE_LIVE::CO_NODE_LIVE() {\n    // Initialize variables\n}\n\nvoid CO_NODE_LIVE::operator()() {\n    LIVE = false;\n    if ((((((LINK.at(21)) & (0x0001)) != 0) & (NETWORK < 8)) & (NODE >= 1)) & (NODE <= 127)) {\n        if (((SHR(LINK.at(21), TO_UINT(NETWORK) + 8)) & (0x0001)) != 0) {\n            BYTE_NO = TO_INT(NODE) / 8;\n            WORD = LINK.at(25 + TO_INT(NETWORK) * 8 + BYTE_NO / 2);\n            BIT_NO = TO_INT(NODE) % 8;\n            if (BYTE_NO % 2 == 0) {\n                BIT_NO = BIT_NO + 8;\n            }\n            LIVE = ((SHR(WORD, TO_UINT(BIT_NO))) & (0x0001)) != 0;\n        }\n    }\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CO_SDO_READ",
      "kind": "functionBlock",
      "header": "class CO_SDO_READ {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    IEC_UDINT DATA;\n    // In-Out\n    Array1D<IEC_WORD, 0, 88> LINK;\n    // Local variables\n    IEC_WORD ME;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_WORD COUNTER;\n    TON TIMER;\n    IEC_WORD STATE;\n    IEC_UINT ERR;\n    IEC_BOOL FIN;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_READ();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_READ() = default;\n};\n",
      "cpp": "CO_SDO_READ::CO_SDO_READ() {\n    // Initialize variables\n}\n\nvoid CO_SDO_READ::operator()() {\n    if (ME == 0) {\n        LINK.at(24) = LINK.at(24) + 1;\n        ME = LINK.at(24);\n    }\n    if ((PHASE == 3) & (!EXECUTE)) {\n        PHASE = 0;\n        DONE = false;\n        ERROR = false;\n    }\n    ERR = 0;\n    FIN = false;\n    if (((PHASE == 0) & (EXECUTE)) & (!PREV)) {\n        DONE = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        ABORT_CODE = 0;\n        DATA = 0;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (((LINK.at(21)) & (0x0004)) == 0) {\n            ERR = 22;\n        } else if ((NODE < 1) | (NODE > 127)) {\n            ERR = 6;\n        } else {\n            PHASE = 1;\n        }\n    }\n    if ((PHASE == 1) | (PHASE == 2)) {\n        TIMER.IN = true;\n        TIMER.PT = SEL(TIMEOUT == 0LL, TIMEOUT, 5000000000LL);\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (TIMER.Q) {\n            ERR = 2;\n            ABORT_CODE = 0x05040000;\n        } else if ((PHASE == 1) & (((LINK.at(23) == 0) | (LINK.at(23) == ME)))) {\n            LINK.at(23) = ME;\n            COUNTER = LINK.at(14) + 1;\n            LINK.at(7) = COUNTER;\n            LINK.at(8) = (SHL(static_cast<IEC_WORD>(1), 8)) | (TO_WORD(NETWORK));\n            LINK.at(9) = (SHL(TO_WORD(NODE), 8)) | (TO_WORD(SUBINDEX));\n            LINK.at(10) = TO_WORD(INDEX);\n            LINK.at(11) = 0;\n            LINK.at(12) = 0;\n            LINK.at(13) = 0;\n            PHASE = 2;\n        } else if ((PHASE == 2) & (LINK.at(14) == COUNTER)) {\n            STATE = SHR(LINK.at(15), 8);\n            if (STATE == 2) {\n                DATA = TO_UDINT((SHL(TO_DWORD(LINK.at(18)), 16)) | (TO_DWORD(LINK.at(19))));\n                FIN = true;\n            } else if (STATE == 3) {\n                ABORT_CODE = TO_UDINT((SHL(TO_DWORD(LINK.at(16)), 16)) | (TO_DWORD(LINK.at(17))));\n                if (ABORT_CODE == 0x08000020) {\n                    ERR = 21;\n                } else {\n                    ERR = 1;\n                }\n            }\n        }\n    }\n    if ((ERR != 0) | (FIN)) {\n        PHASE = 3;\n        DONE = FIN;\n        ERROR = ERR != 0;\n        ERROR_ID = ERR;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (LINK.at(23) == ME) {\n            LINK.at(23) = 0;\n        }\n    }\n    BUSY = (PHASE == 1) | (PHASE == 2);\n    PREV = EXECUTE;\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "TON"
        },
        {
          "library": "iec-std-functions",
          "name": "SEL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        }
      ]
    },
    {
      "name": "CO_SDO_WRITE",
      "kind": "functionBlock",
      "header": "class CO_SDO_WRITE {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_UINT INDEX;\n    IEC_USINT SUBINDEX;\n    IEC_UDINT DATA;\n    IEC_USINT SIZE;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    IEC_UDINT ABORT_CODE;\n    // In-Out\n    Array1D<IEC_WORD, 0, 88> LINK;\n    // Local variables\n    IEC_WORD ME;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_WORD COUNTER;\n    TON TIMER;\n    IEC_WORD STATE;\n    IEC_UINT ERR;\n    IEC_BOOL FIN;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_SDO_WRITE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_SDO_WRITE() = default;\n};\n",
      "cpp": "CO_SDO_WRITE::CO_SDO_WRITE() {\n    // Initialize variables\n}\n\nvoid CO_SDO_WRITE::operator()() {\n    if (ME == 0) {\n        LINK.at(24) = LINK.at(24) + 1;\n        ME = LINK.at(24);\n    }\n    if ((PHASE == 3) & (!EXECUTE)) {\n        PHASE = 0;\n        DONE = false;\n        ERROR = false;\n    }\n    ERR = 0;\n    FIN = false;\n    if (((PHASE == 0) & (EXECUTE)) & (!PREV)) {\n        DONE = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        ABORT_CODE = 0;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (((LINK.at(21)) & (0x0004)) == 0) {\n            ERR = 22;\n        } else if ((((NODE < 1) | (NODE > 127)) | (SIZE < 1)) | (SIZE > 4)) {\n            ERR = 6;\n        } else {\n            PHASE = 1;\n        }\n    }\n    if ((PHASE == 1) | (PHASE == 2)) {\n        TIMER.IN = true;\n        TIMER.PT = SEL(TIMEOUT == 0LL, TIMEOUT, 5000000000LL);\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (TIMER.Q) {\n            ERR = 2;\n            ABORT_CODE = 0x05040000;\n        } else if ((PHASE == 1) & (((LINK.at(23) == 0) | (LINK.at(23) == ME)))) {\n            LINK.at(23) = ME;\n            COUNTER = LINK.at(14) + 1;\n            LINK.at(7) = COUNTER;\n            LINK.at(8) = (SHL(static_cast<IEC_WORD>(2), 8)) | (TO_WORD(NETWORK));\n            LINK.at(9) = (SHL(TO_WORD(NODE), 8)) | (TO_WORD(SUBINDEX));\n            LINK.at(10) = TO_WORD(INDEX);\n            LINK.at(11) = SHL(TO_WORD(SIZE), 8);\n            LINK.at(12) = TO_WORD(SHR(TO_DWORD(DATA), 16));\n            LINK.at(13) = TO_WORD(TO_DWORD(DATA));\n            PHASE = 2;\n        } else if ((PHASE == 2) & (LINK.at(14) == COUNTER)) {\n            STATE = SHR(LINK.at(15), 8);\n            if (STATE == 2) {\n                FIN = true;\n            } else if (STATE == 3) {\n                ABORT_CODE = TO_UDINT((SHL(TO_DWORD(LINK.at(16)), 16)) | (TO_DWORD(LINK.at(17))));\n                if (ABORT_CODE == 0x08000020) {\n                    ERR = 21;\n                } else {\n                    ERR = 1;\n                }\n            }\n        }\n    }\n    if ((ERR != 0) | (FIN)) {\n        PHASE = 3;\n        DONE = FIN;\n        ERROR = ERR != 0;\n        ERROR_ID = ERR;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (LINK.at(23) == ME) {\n            LINK.at(23) = 0;\n        }\n    }\n    BUSY = (PHASE == 1) | (PHASE == 2);\n    PREV = EXECUTE;\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "TON"
        },
        {
          "library": "iec-std-functions",
          "name": "SEL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        }
      ]
    },
    {
      "name": "J1939_DTC_SPLIT",
      "kind": "functionBlock",
      "header": "class J1939_DTC_SPLIT {\npublic:\n    // Inputs\n    IEC_UDINT DTC;\n    // Outputs\n    IEC_UDINT SPN;\n    IEC_USINT FMI;\n    IEC_USINT OC;\n    IEC_BOOL CM;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_DTC_SPLIT();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_DTC_SPLIT() = default;\n};\n",
      "cpp": "J1939_DTC_SPLIT::J1939_DTC_SPLIT() {\n    // Initialize variables\n}\n\nvoid J1939_DTC_SPLIT::operator()() {\n    SPN = (DTC) & (0x7FFFF);\n    FMI = TO_USINT((SHR(DTC, 19)) & (0x1F));\n    OC = TO_USINT((SHR(DTC, 24)) & (0x7F));\n    CM = ((DTC) & (0x80000000)) != 0;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "J1939_NAME_SPLIT",
      "kind": "functionBlock",
      "header": "class J1939_NAME_SPLIT {\npublic:\n    // Inputs\n    IEC_LWORD NAME;\n    // Outputs\n    IEC_UDINT IDENTITY_NUMBER;\n    IEC_UINT MANUFACTURER_CODE;\n    IEC_USINT ECU_INSTANCE;\n    IEC_USINT FUNCTION_INSTANCE;\n    IEC_USINT ECU_FUNCTION;\n    IEC_USINT VEHICLE_SYSTEM;\n    IEC_USINT VEHICLE_SYSTEM_INSTANCE;\n    IEC_USINT INDUSTRY_GROUP;\n    IEC_BOOL ARBITRARY_ADDRESS_CAPABLE;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    J1939_NAME_SPLIT();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~J1939_NAME_SPLIT() = default;\n};\n",
      "cpp": "J1939_NAME_SPLIT::J1939_NAME_SPLIT() {\n    // Initialize variables\n}\n\nvoid J1939_NAME_SPLIT::operator()() {\n    IDENTITY_NUMBER = TO_UDINT((NAME) & (0x1FFFFF));\n    MANUFACTURER_CODE = TO_UINT((SHR(NAME, 21)) & (0x7FF));\n    ECU_INSTANCE = TO_USINT((SHR(NAME, 32)) & (0x7));\n    FUNCTION_INSTANCE = TO_USINT((SHR(NAME, 35)) & (0x1F));\n    ECU_FUNCTION = TO_USINT((SHR(NAME, 40)) & (0xFF));\n    VEHICLE_SYSTEM = TO_USINT((SHR(NAME, 49)) & (0x7F));\n    VEHICLE_SYSTEM_INSTANCE = TO_USINT((SHR(NAME, 56)) & (0xF));\n    INDUSTRY_GROUP = TO_USINT((SHR(NAME, 60)) & (0x7));\n    ARBITRARY_ADDRESS_CAPABLE = ((NAME) & (static_cast<IEC_LWORD>(0x8000000000000000))) != 0;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CAN_GET_BITS",
      "kind": "function",
      "header": "IEC_LINT CAN_GET_BITS(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT START_BIT, IEC_USINT BIT_LENGTH, IEC_BOOL MOTOROLA, IEC_BOOL SIGNED);",
      "cpp": "IEC_LINT CAN_GET_BITS(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT START_BIT, IEC_USINT BIT_LENGTH, IEC_BOOL MOTOROLA, IEC_BOOL SIGNED) {\n    IEC_LINT CAN_GET_BITS_result;\n    IEC_INT I;\n    IEC_INT POS;\n    IEC_LWORD BITV;\n    IEC_LWORD V;\n    V = 0;\n    POS = TO_INT(START_BIT);\n    for (I = 0; I <= TO_INT(BIT_LENGTH) - 1; I++) {\n        if ((POS >= 0) & (POS < 64)) {\n            BITV = TO_LWORD((SHR(DATA.at(POS / 8), TO_UINT(POS % 8))) & (0x01));\n        } else {\n            BITV = 0;\n        }\n        if (MOTOROLA) {\n            V = (SHL(V, 1)) | (BITV);\n            if (POS % 8 == 0) {\n                POS = POS + 15;\n            } else {\n                POS = POS - 1;\n            }\n        } else {\n            V = (V) | (SHL(BITV, TO_UINT(I)));\n            POS = POS + 1;\n        }\n    }\n    if (((SIGNED) & (BIT_LENGTH > 0)) & (BIT_LENGTH < 64)) {\n        if (((SHR(V, TO_UINT(BIT_LENGTH) - 1)) & (0x01)) == 1) {\n            V = (V) | (SHL(static_cast<IEC_LWORD>(0xFFFFFFFFFFFFFFFF), TO_UINT(BIT_LENGTH)));\n        }\n    }\n    CAN_GET_BITS_result = TO_LINT(V);\n    return CAN_GET_BITS_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CAN_GET_UINT16",
      "kind": "function",
      "header": "IEC_UINT CAN_GET_UINT16(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA);",
      "cpp": "IEC_UINT CAN_GET_UINT16(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA) {\n    IEC_UINT CAN_GET_UINT16_result;\n    IEC_INT I;\n    IEC_WORD V;\n    V = 0;\n    if (TO_INT(OFFSET) + 2 <= 8) {\n        for (I = 0; I <= 1; I++) {\n            if (MOTOROLA) {\n                V = (SHL(V, 8)) | (TO_WORD(DATA.at(TO_INT(OFFSET) + I)));\n            } else {\n                V = (V) | (SHL(TO_WORD(DATA.at(TO_INT(OFFSET) + I)), TO_UINT(8 * I)));\n            }\n        }\n    }\n    CAN_GET_UINT16_result = TO_UINT(V);\n    return CAN_GET_UINT16_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "oscat-basic",
          "name": "OFFSET"
        }
      ]
    },
    {
      "name": "CAN_GET_UINT32",
      "kind": "function",
      "header": "IEC_UDINT CAN_GET_UINT32(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA);",
      "cpp": "IEC_UDINT CAN_GET_UINT32(Array1D<IEC_BYTE, 0, 7>& DATA, IEC_USINT OFFSET, IEC_BOOL MOTOROLA) {\n    IEC_UDINT CAN_GET_UINT32_result;\n    IEC_INT I;\n    IEC_DWORD V;\n    V = 0;\n    if (TO_INT(OFFSET) + 4 <= 8) {\n        for (I = 0; I <= 3; I++) {\n            if (MOTOROLA) {\n                V = (SHL(V, 8)) | (TO_DWORD(DATA.at(TO_INT(OFFSET) + I)));\n            } else {\n                V = (V) | (SHL(TO_DWORD(DATA.at(TO_INT(OFFSET) + I)), TO_UINT(8 * I)));\n            }\n        }\n    }\n    CAN_GET_UINT32_result = TO_UDINT(V);\n    return CAN_GET_UINT32_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "oscat-basic",
          "name": "OFFSET"
        }
      ]
    },
    {
      "name": "CAN_J1939_ID",
      "kind": "function",
      "header": "IEC_UDINT CAN_J1939_ID(IEC_USINT PRIORITY, IEC_UDINT PGN, IEC_USINT SOURCE, IEC_USINT DESTINATION);",
      "cpp": "IEC_UDINT CAN_J1939_ID(IEC_USINT PRIORITY, IEC_UDINT PGN, IEC_USINT SOURCE, IEC_USINT DESTINATION) {\n    IEC_UDINT CAN_J1939_ID_result;\n    IEC_UDINT P;\n    P = (PGN) & (0x3FFFF);\n    if (((SHR(P, 8)) & (0xFF)) < 240) {\n        P = (((P) & (0x3FF00))) | (TO_UDINT(DESTINATION));\n    }\n    CAN_J1939_ID_result = ((SHL((TO_UDINT(PRIORITY)) & (0x7), 26)) | (SHL(P, 8))) | (TO_UDINT(SOURCE));\n    return CAN_J1939_ID_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHL"
        },
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CAN_J1939_PGN",
      "kind": "function",
      "header": "IEC_UDINT CAN_J1939_PGN(IEC_UDINT ID);",
      "cpp": "IEC_UDINT CAN_J1939_PGN(IEC_UDINT ID) {\n    IEC_UDINT CAN_J1939_PGN_result;\n    IEC_UDINT P;\n    P = (SHR(ID, 8)) & (0x3FFFF);\n    if (((SHR(P, 8)) & (0xFF)) < 240) {\n        P = (P) & (0x3FF00);\n    }\n    CAN_J1939_PGN_result = P;\n    return CAN_J1939_PGN_result;\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
