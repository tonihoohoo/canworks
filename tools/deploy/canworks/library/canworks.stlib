  "chunks": [
    {
      "name": "CAN_BUS_INFO",
      "kind": "functionBlock",
      "header": "class CAN_BUS_INFO {\npublic:\n    // Inputs\n    IEC_USINT NETWORK;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Outputs\n    IEC_USINT STATE;\n    IEC_UINT TX_ERRORS;\n    IEC_UINT RX_ERRORS;\n    IEC_UDINT BUS_OFF_COUNT;\n    IEC_USINT BUS_LOAD;\n    IEC_UDINT RX_COUNT;\n    IEC_UDINT TX_COUNT;\n    IEC_UDINT ERROR_FRAMES;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // Local variables\n    IEC_INT P;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CAN_BUS_INFO();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CAN_BUS_INFO() = default;\n};\n",
      "cpp": "CAN_BUS_INFO::CAN_BUS_INFO() {\n    // Initialize variables\n}\n\nvoid CAN_BUS_INFO::operator()() {\n    ERROR_ID = 0;\n    if (((LINK.at(21)) & (0x0001)) == 0) {\n        ERROR_ID = 20;\n    } else if ((((LINK.at(89)) & (0x0020)) == 0) | (NETWORK > 7)) {\n        ERROR_ID = 22;\n    } else {\n        P = 840 + 18 * TO_INT(NETWORK);\n        if (LINK.at(P + 17) == 0) {\n            ERROR_ID = 2;\n        }\n    }\n    ERROR = ERROR_ID != 0;\n    if (ERROR) {\n        STATE = 4;\n        TX_ERRORS = 0;\n        RX_ERRORS = 0;\n        BUS_OFF_COUNT = 0;\n        BUS_LOAD = 0;\n        RX_COUNT = 0;\n        TX_COUNT = 0;\n        ERROR_FRAMES = 0;\n        return;\n    }\n    STATE = TO_USINT(SHR(LINK.at(P), 8));\n    BUS_LOAD = TO_USINT((LINK.at(P)) & (0x00FF));\n    TX_ERRORS = TO_UINT(LINK.at(P + 1));\n    RX_ERRORS = TO_UINT(LINK.at(P + 2));\n    BUS_OFF_COUNT = TO_UDINT(LINK.at(P + 3)) * 65536 + TO_UDINT(LINK.at(P + 4));\n    RX_COUNT = TO_UDINT(LINK.at(P + 5)) * 65536 + TO_UDINT(LINK.at(P + 6));\n    TX_COUNT = TO_UDINT(LINK.at(P + 7)) * 65536 + TO_UDINT(LINK.at(P + 8));\n    ERROR_FRAMES = TO_UDINT(LINK.at(P + 9)) * 65536 + TO_UDINT(LINK.at(P + 10));\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "SHR"
        }
      ]
    },
    {
      "name": "CO_NMT",
      "kind": "functionBlock",
      "header": "class CO_NMT {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_USINT NETWORK;\n    IEC_USINT NODE;\n    IEC_USINT COMMAND;\n    IEC_TIME TIMEOUT;\n    // Outputs\n    IEC_BOOL BUSY;\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_UINT ERROR_ID;\n    // In-Out\n    Array1D<IEC_WORD, 0, 1279> LINK;\n    // Local variables\n    IEC_WORD ME;\n    IEC_BOOL PREV;\n    IEC_USINT PHASE;\n    IEC_WORD CMD;\n    IEC_WORD COUNTER;\n    TON TIMER;\n    IEC_WORD RESULT;\n    IEC_UINT ERR;\n    IEC_BOOL FIN;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO_NMT();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO_NMT() = default;\n};\n",
      "cpp": "CO_NMT::CO_NMT() {\n    // Initialize variables\n}\n\nvoid CO_NMT::operator()() {\n    if (ME == 0) {\n        LINK.at(24) = LINK.at(24) + 1;\n        ME = LINK.at(24);\n    }\n    if ((PHASE == 3) & (!EXECUTE)) {\n        PHASE = 0;\n        DONE = false;\n        ERROR = false;\n    }\n    ERR = 0;\n    FIN = false;\n    if (((PHASE == 0) & (EXECUTE)) & (!PREV)) {\n        DONE = false;\n        ERROR = false;\n        ERROR_ID = 0;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        switch (COMMAND) {\n            case 1:\n                CMD = 3;\n                break;\n            case 2:\n                CMD = 4;\n                break;\n            case 128:\n                CMD = 5;\n                break;\n            case 129:\n                CMD = 6;\n                break;\n            case 130:\n                CMD = 7;\n                break;\n            default:\n                CMD = 0;\n                break;\n        }\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (((LINK.at(21)) & (0x0002)) == 0) {\n            ERR = 22;\n        } else if ((CMD == 0) | (NODE > 127)) {\n            ERR = 6;\n        } else {\n            PHASE = 1;\n        }\n    }\n    if ((PHASE == 1) | (PHASE == 2)) {\n        TIMER.IN = true;\n        TIMER.PT = SEL(TIMEOUT == 0LL, TIMEOUT, 5000000000LL);\n        TIMER();\n        TIMER.ENO = true;\n        if (((LINK.at(21)) & (0x0001)) == 0) {\n            ERR = 20;\n        } else if (TIMER.Q) {\n            ERR = 2;\n        } else if ((PHASE == 1) & (((LINK.at(22) == 0) | (LINK.at(22) == ME)))) {\n            LINK.at(22) = ME;\n            COUNTER = LINK.at(2) + 1;\n            LINK.at(4) = COUNTER;\n            LINK.at(5) = (SHL(CMD, 8)) | (TO_WORD(NETWORK));\n            LINK.at(6) = SHL(TO_WORD(NODE), 8);\n            PHASE = 2;\n        } else if ((PHASE == 2) & (LINK.at(2) == COUNTER)) {\n            RESULT = SHR(LINK.at(3), 8);\n            if (RESULT == 0) {\n                FIN = true;\n            } else if (RESULT == 5) {\n                ERR = 5;\n            } else {\n                ERR = 6;\n            }\n        }\n    }\n    if ((ERR != 0) | (FIN)) {\n        PHASE = 3;\n        DONE = FIN;\n        ERROR = ERR != 0;\n        ERROR_ID = ERR;\n        TIMER.IN = false;\n        TIMER();\n        TIMER.ENO = true;\n        if (LINK.at(22) == ME) {\n            LINK.at(22) = 0;\n        }\n    }\n    BUSY = (PHASE == 1) | (PHASE == 2);\n    PREV = EXECUTE;\n}\n",
