          "$ref": "#/$defs/device_ref"
        },
        "machine": {
          "type": "string",
          "minLength": 1,
          "description": "A machine element, for a \"fault\" or \"clear\" step instead of \"node\"."
        },
        "at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "after_ms": {
          "type": "integer",
          "minimum": 0
        },
        "set": {
          "$ref": "#/$defs/values"
        },
        "override": {
          "$ref": "#/$defs/values"
        },
        "release": {
          "anyOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^0x[0-9A-Fa-f]{4}(:([0-9]{1,3}|0x[0-9A-Fa-f]{1,2}))?$"
              }
            }
          ]
        },
        "source": {
          "type": "object",
          "propertyNames": {
            "pattern": "^0x[0-9A-Fa-f]{4}(:([0-9]{1,3}|0x[0-9A-Fa-f]{1,2}))?$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/source"
              }
            ]
          }
        },
        "fault": {
          "type": "object"
        },
        "clear": {
          "type": "string"
        },
        "wait": {
          "$ref": "#/$defs/condition"
        },
        "expect": {
          "$ref": "#/$defs/condition"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "within_ms": {
          "type": "integer",
          "minimum": 1
        },
        "for_ms": {
          "type": "integer",
          "minimum": 1
        },
        "log": {
          "type": "string"
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "steps": {
              "$ref": "#/$defs/steps"
            }
          }
        },
        "device": {
          "type": "string",
          "minLength": 1,
          "description": "A plain CAN device (raw_devices), for a \"fault\" or \"clear\" step."
        }
      },
      "oneOf": [
        {
          "required": [
            "set"
          ]
        },
        {
          "required": [
            "override"
          ]
        },
        {
          "required": [
            "release"
          ]
        },
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "fault"
          ]
        },
        {
          "required": [
            "clear"
          ]
        },
        {
          "required": [
            "wait"
          ]
        },
        {
          "required": [
            "expect"
          ]
        },
        {
          "required": [
            "log"
          ]
        },
        {
          "required": [
            "repeat"
          ]
        }
      ],
      "not": {
        "required": [
          "at_ms",
          "after_ms"
        ]
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "set"
                ]
              },
              {
                "required": [
                  "override"
                ]
              },
              {
                "required": [
                  "release"
                ]
              },
              {
                "required": [
                  "source"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "node"
            ]
          }
        },
        {
          "if": {
            "required": [
              "machine"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "fault"
                ]
              },
              {
                "required": [
                  "clear"
                ]
              }
            ],
            "not": {
              "required": [
                "node"
              ]
            },
            "properties": {
              "fault": {
                "$ref": "#/$defs/machine_fault"
              },
              "clear": {
                "enum": [
                  "jam",
                  "stuck",
                  "feeder",
                  "misaligned_mm",
                  "all"
                ]
              }
            }
          },
          "else": {
            "if": {
              "required": [
                "device"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "fault"
                  ]
                },
                {
                  "required": [
                    "clear"
                  ]
                }
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "node"
                    ]
                  },
                  {
                    "required": [
                      "machine"
                    ]
                  }
                ]
              },
              "properties": {
                "fault": {
                  "$ref": "#/$defs/raw_fault"
                },
                "clear": {
                  "enum": [
                    "stop",
                    "wrong_dlc",
                    "all"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "fault": {
                  "$ref": "#/$defs/fault"
                },
                "clear": {
                  "type": "string",
                  "enum": [
                    "all",
                    "emcy",
                    "heartbeat",
                    "power",
                    "sdo_abort",
                    "sdo_delay",
                    "refuse_write_operational",
                    "tpdo_stop",
                    "identity",
                    "device_type",
                    "drive_input"
                  ]
                }
              },
              "if": {
                "anyOf": [
                  {
                    "required": [
                      "fault"
                    ]
                  },
                  {
                    "required": [
                      "clear"
                    ]
                  }
                ]
              },
              "then": {
                "required": [
                  "node"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "timeout_ms"
            ]
          },
          "then": {
            "required": [
              "wait"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "within_ms"
                ]
              },
              {
                "required": [
                  "for_ms"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "expect"
            ],
            "not": {
              "required": [
                "within_ms",
                "for_ms"
              ]
            }
          }
        }
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "autostart": {
          "type": "boolean"
        },
        "test": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "$ref": "#/$defs/steps"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^([1-9]|[1-9][0-9]|1[01][0-9]|12[0-7])$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        },
        "extra_devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extra_device"
          }
        },
        "scenarios": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scenario"
          }
        },
        "machine": {
          "type": "string",
          "minLength": 1,
          "description": "The machine file of this network, relative to this file (docs/simulator.md, Simulated machine)."
        }
      }
    },
    "machine_fault": {
      "type": "object",
      "description": "A fault of a machine element: jam (a joint), stuck (a sensor), slip (the tool), feeder and misaligned_mm (a conveyor with a feeder).",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "jam": {
          "const": true
        },
        "stuck": {
          "enum": [
            "on",
            "off"
          ]
        },
        "slip": {
          "const": true
        },
        "feeder": {
          "enum": [
            "stop",
            "empty"
          ]
        },
        "misaligned_mm": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "raw_bytes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "raw_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_bit",
        "length"
      ],
      "description": "A signal of a sent frame, numbered as in DBC files; the source gives scale * raw + offset. Every signal but a switch (multiplexer: true) needs a source.",
      "properties": {
        "name": {
          "type": "string"
        },
        "start_bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "byte_order": {
          "enum": [
            "little",
            "big"
          ]
        },
        "signed": {
          "type": "boolean"
        },
        "scale": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "offset": {
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "multiplexer": {
          "description": "A switch: its value says which other signals (those with mux on it) the frame carries. Unsigned, at most 32 bits; the simulator sets it for each page.",
          "type": "boolean"
        },
        "mux": {
          "description": "The signal is sent only in frames where switch `on` (may be left out with one switch) has one of `values` (whole numbers or [low, high] ranges).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values"
          ],
          "properties": {
            "on": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                ]
              }
            }
          }
        }
      }
    },
    "raw_send": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "period_ms"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870911
        },
        "extended": {
          "type": "boolean"
        },
        "rtr": {
          "type": "boolean"
        },
        "dlc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "data": {
          "$ref": "#/$defs/raw_bytes"
        },
        "period_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/raw_signal"
          }
        },
        "pages": {
          "description": "A send with switches: \"all\" (default) sends every page each period, \"rotate\" the next page each period.",
          "enum": [
            "all",
            "rotate"
          ]
        }
      }
    },
    "raw_reply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "send"
      ],
      "properties": {
        "on": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870911
            },
            "extended": {
              "type": "boolean"
            },
            "data": {
              "$ref": "#/$defs/raw_bytes"
            },
            "mask": {
              "$ref": "#/$defs/raw_bytes"
            }
          }
        },
        "send": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870911
            },
            "extended": {
              "type": "boolean"
            },
            "rtr": {
              "type": "boolean"
            },
            "dlc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "data": {
              "$ref": "#/$defs/raw_bytes"
            }
          }
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "raw_device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "A plain CAN device (docs/simulator.md, Plain CAN devices).",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string"
        },
        "send": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/raw_send"
          }
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/raw_reply"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "send"
          ]
        },
        {
          "required": [
            "replies"
          ]
        }
      ]
    },
    "raw_fault": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "stop": {
          "const": true
        },
        "wrong_dlc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    }
  }
}
