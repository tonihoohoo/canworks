                ]
              }
            ]
          },
          "properties": {
            "eq": {
              "type": [
                "number",
                "boolean"
              ]
            },
            "ne": {
              "type": [
                "number",
                "boolean"
              ]
            }
          },
          "oneOf": [
            {
              "required": [
                "eq"
              ]
            },
            {
              "required": [
