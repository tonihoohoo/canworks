          ]
        }
      }
    },
    "extra_device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "eds"
      ],
      "properties": {
        "default_behaviour": {
          "type": "boolean"
        },
        "tick_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "sources": {
          "type": "object",
          "propertyNames": {
            "pattern": "^0x[0-9A-Fa-f]{4}(:([0-9]{1,3}|0x[0-9A-Fa-f]{1,2}))?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/source"
          }
        },
        "drive": {
          "$ref": "#/$defs/drive"
        },
        "faults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fault"
          }
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "device_type": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "string",
              "pattern": "^(0x[0-9A-Fa-f]{1,8}|[0-9]{1,10})$"
            }
          ]
        },
        "node": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
        },
        "eds": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "node": {
            "const": 0
          }
        }
      },
      "then": {
        "required": [
          "name"
        ]
      }
    },
    "device_ref": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
        }
      ]
    },
    "values": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^0x[0-9A-Fa-f]{4}(:([0-9]{1,3}|0x[0-9A-Fa-f]{1,2}))?$"
      },
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean"
        ]
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "$ref": "#/$defs/device_ref"
        },
        "object": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{4}(:([0-9]{1,3}|0x[0-9A-Fa-f]{1,2}))?$"
        },
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "eq": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "ne": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "lt": {
          "type": "number"
        },
        "le": {
          "type": "number"
        },
        "gt": {
          "type": "number"
        },
        "ge": {
          "type": "number"
        },
        "expr": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1,
          "description": "A machine counter (fed, picked, placed, misplaced, dropped, pallets), sensor, fixture or joint."
