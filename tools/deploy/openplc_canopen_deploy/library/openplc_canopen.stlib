    }
  ],
  "sources": [
    {
      "fileName": "CO402_CyclicMoveAbsolute.st",
      "source": "(*\n * CO402_CyclicMoveAbsolute: a point-to-point move in cyclic synchronous\n * position mode (CiA 402 mode 8) on an axis of the editor's PLCopen motion\n * library (spec canopen-cia402-axis). The set-points come from the editor\n * library's S-curve trajectory planner (FB_S7RTT_Plan), one\n * per PLC cycle (Axis.fCycleTime), so the program plans the move instead of\n * the drive.\n *\n * Call it every scan while it is in use, after the axis's drive bridge and\n * with MC_Power enabled. On a rising Execute it sets the target position to\n * the actual position, selects mode 8 (operation stays enabled), plans the\n * move from the actual position at standstill once 0x6061 shows 8, and sends\n * the trajectory's positions. Done: the trajectory has ended and the actual\n * position is within Window of Position (Window 0: one drive increment).\n * Execute FALSE stops writing (the drive holds the last set-point): drop it\n * at standstill or hand the axis to MC_Halt.\n *\n * ErrorID: 1 drive not enabled, 2 mode not reached within ModeTimeout (or\n * left), 4 axis in error stop (fault or drive lost), 5 Velocity,\n * Acceleration or Jerk not above 0, or no trajectory.\n *)\nFUNCTION_BLOCK CO402_CyclicMoveAbsolute\nVAR_IN_OUT\n  Axis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n  Execute : BOOL;\n  Position : LREAL;      (* target [u] *)\n  Velocity : LREAL;      (* [u/s], above 0 *)\n  Acceleration : LREAL;  (* [u/s2], above 0 *)\n  Jerk : LREAL;          (* [u/s3], above 0 *)\n  Window : LREAL := 0.0; (* in-position window [u], 0 = one increment *)\n  ModeTimeout : TIME := T#500ms;\nEND_VAR\nVAR_OUTPUT\n  Done : BOOL;\n  Busy : BOOL;\n  InSync : BOOL;\n  Error : BOOL;\n  ErrorID : UINT;\nEND_VAR\nVAR\n  iState : INT;  (* 0 idle, 10 selecting the mode, 20 moving, 30 done, 99 error *)\n  plan : FB_S7RTT_Plan;\n  start : ST_MotionState;\n  limits : ST_MotionLimits;\n  fSet : LREAL;\n  fT : LREAL;\n  fElapsed : LREAL;\n  fDuration : LREAL;\n  fWindow : LREAL;\n  fActual : LREAL;\n  i : INT;\n  tMode : TON;\nEND_VAR\n  IF NOT Execute THEN\n    iState := 0;\n  ELSIF iState = 0 THEN\n    ErrorID := 0;\n    IF Axis.bError OR NOT Axis.bCommunication THEN\n      ErrorID := 4;\n    ELSIF (Axis.Drive.StatusWord AND UINT#16#006F) <> UINT#16#0027 THEN\n      ErrorID := 1;\n    ELSIF Velocity <= 0.0 OR Acceleration <= 0.0 OR Jerk <= 0.0 THEN\n      ErrorID := 5;\n    ELSE\n      Axis.Drive.Target_Position := Axis.Drive.Position_Actual_Value;\n      Axis.Drive.Modes_of_operation := SINT#8;\n      iState := 10;\n    END_IF\n    IF ErrorID <> 0 THEN iState := 99; END_IF\n  END_IF\n\n  IF iState = 10 OR iState = 20 OR iState = 30 THEN\n    IF Axis.bError OR NOT Axis.bCommunication THEN\n      ErrorID := 4; iState := 99;\n    ELSIF (Axis.Drive.StatusWord AND UINT#16#006F) <> UINT#16#0027 THEN\n      ErrorID := 1; iState := 99;\n    ELSIF iState <> 10 AND Axis.Drive.Modes_of_operation_display <> SINT#8 THEN\n      ErrorID := 2; iState := 99;\n    END_IF\n  END_IF\n  tMode(IN := iState = 10, PT := ModeTimeout);\n  fActual := DINT_TO_LREAL(Axis.Drive.Position_Actual_Value) / Axis.fIncPerUnit;\n  IF iState = 10 THEN\n    Axis.Drive.Modes_of_operation := SINT#8;\n    Axis.Drive.Target_Position := Axis.Drive.Position_Actual_Value;\n    IF Axis.Drive.Modes_of_operation_display = SINT#8 THEN\n      start.fPos := fActual;\n      start.fVel := 0.0;\n      start.fAcc := 0.0;\n      start.fDuration := 0.0;\n      limits.fVelMax := Velocity;\n      limits.fAccMax := Acceleration;\n      limits.fJerkMax := Jerk;\n      plan(Execute := FALSE);\n      plan(Execute := TRUE, ModeVelocity := FALSE, StartState := start, TargetPos := Position, TargetVel := 0.0,\n           Limits := limits);\n      fDuration := 0.0;\n      FOR i := 1 TO plan.SegmentCount DO\n        fDuration := fDuration + plan.Trajectory[i].fDuration;\n      END_FOR\n      fElapsed := 0.0;\n      IF plan.Error THEN\n        ErrorID := 5; iState := 99;\n      ELSE\n        iState := 20;\n      END_IF\n    ELSIF tMode.Q THEN\n      ErrorID := 2; iState := 99;\n    END_IF\n  END_IF\n  IF iState = 20 THEN\n    fElapsed := fElapsed + Axis.fCycleTime;\n    IF fElapsed >= fDuration OR plan.SegmentCount <= 0 THEN\n      Axis.Drive.Target_Position := LREAL_TO_DINT(Position * Axis.fIncPerUnit);\n      iState := 30;\n    ELSE\n      (* the planner's segment at fElapsed: p = p0 + v0 t + a0 t^2/2 + j t^3/6 *)\n      fT := fElapsed;\n      fSet := Position;\n      FOR i := 1 TO plan.SegmentCount DO\n        IF fT <= plan.Trajectory[i].fDuration THEN\n          fSet := plan.Trajectory[i].fPos + plan.Trajectory[i].fVel * fT + 0.5 * plan.Trajectory[i].fAcc * fT * fT\n                  + plan.Trajectory[i].fJerk * fT * fT * fT / 6.0;\n          EXIT;\n        END_IF\n        fT := fT - plan.Trajectory[i].fDuration;\n      END_FOR\n      Axis.Drive.Target_Position := LREAL_TO_DINT(fSet * Axis.fIncPerUnit);\n    END_IF\n  END_IF\n  IF iState = 30 THEN\n    Axis.Drive.Target_Position := LREAL_TO_DINT(Position * Axis.fIncPerUnit);\n  END_IF\n\n  fWindow := Window;\n  IF fWindow <= 0.0 THEN fWindow := 1.0 / ABS(Axis.fIncPerUnit); END_IF\n  Done := iState = 30 AND ABS(fActual - Position) <= fWindow;\n  InSync := iState = 20 OR iState = 30;\n  Busy := (iState = 10 OR iState = 20 OR iState = 30) AND NOT Done;\n  Error := iState = 99;\n  IF iState = 0 THEN ErrorID := 0; END_IF\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CO402_CyclicPosition.st",
      "source": "(*\n * CO402_CyclicPosition: cyclic synchronous position (CiA 402 mode 8) on an\n * axis of the editor's PLCopen motion library (spec canopen-cia402-axis).\n *\n * Call it every scan while it is in use, after the axis's drive bridge and\n * with MC_Power enabled. On a rising Enable it sets the target position\n * 0x607A to the actual position, selects mode 8 (operation stays enabled) and\n * follows Position once 0x6061 shows 8: one set-point per PLC cycle, applied\n * by the drive on SYNC. MaxVelocity (units/s, 0 = off) limits the step\n * between two set-points to MaxVelocity * Axis.fCycleTime; a larger step sets\n * Error (ErrorID 3) and holds the last set-point. Enable FALSE stops writing\n * the set-point (the drive holds the last one); hand the axis to another\n * block then.\n *\n * ErrorID: 1 drive not enabled, 2 mode not reached within ModeTimeout (or\n * left), 3 step limit exceeded, 4 axis in error stop (fault or drive lost).\n *)\nFUNCTION_BLOCK CO402_CyclicPosition\nVAR_IN_OUT\n  Axis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n  Enable : BOOL;\n  Position : LREAL;            (* set-point [u] *)\n  MaxVelocity : LREAL := 0.0;  (* step limit [u/s], 0 = off *)\n  ModeTimeout : TIME := T#500ms;\nEND_VAR\nVAR_OUTPUT\n  InSync : BOOL;\n  Busy : BOOL;\n  Error : BOOL;\n  ErrorID : UINT;\nEND_VAR\nVAR\n  iState : INT;  (* 0 idle, 10 selecting the mode, 20 following, 99 error *)\n  fLast : LREAL;\n  tMode : TON;\nEND_VAR\n  IF NOT Enable THEN\n    iState := 0;\n  ELSIF iState = 0 THEN\n    ErrorID := 0;\n    IF Axis.bError OR NOT Axis.bCommunication THEN\n      ErrorID := 4;\n    ELSIF (Axis.Drive.StatusWord AND UINT#16#006F) <> UINT#16#0027 THEN\n      ErrorID := 1;\n    ELSE\n      Axis.Drive.Target_Position := Axis.Drive.Position_Actual_Value;\n      fLast := DINT_TO_LREAL(Axis.Drive.Position_Actual_Value) / Axis.fIncPerUnit;\n      Axis.Drive.Modes_of_operation := SINT#8;\n      iState := 10;\n    END_IF\n    IF ErrorID <> 0 THEN iState := 99; END_IF\n  END_IF\n\n  IF iState = 10 OR iState = 20 THEN\n    IF Axis.bError OR NOT Axis.bCommunication THEN\n      ErrorID := 4; iState := 99;\n    ELSIF (Axis.Drive.StatusWord AND UINT#16#006F) <> UINT#16#0027 THEN\n      ErrorID := 1; iState := 99;\n    END_IF\n  END_IF\n  tMode(IN := iState = 10, PT := ModeTimeout);\n  IF iState = 10 THEN\n    Axis.Drive.Modes_of_operation := SINT#8;\n    Axis.Drive.Target_Position := Axis.Drive.Position_Actual_Value;  (* hold until the drive is in mode 8 *)\n    IF Axis.Drive.Modes_of_operation_display = SINT#8 THEN\n      fLast := DINT_TO_LREAL(Axis.Drive.Position_Actual_Value) / Axis.fIncPerUnit;\n      iState := 20;\n    ELSIF tMode.Q THEN\n      ErrorID := 2; iState := 99;\n    END_IF\n  END_IF\n  IF iState = 20 THEN\n    IF Axis.Drive.Modes_of_operation_display <> SINT#8 THEN\n      ErrorID := 2; iState := 99;\n    ELSIF MaxVelocity > 0.0 AND ABS(Position - fLast) > MaxVelocity * Axis.fCycleTime * 1.000001 THEN\n      ErrorID := 3; iState := 99;\n    ELSE\n      Axis.Drive.Target_Position := LREAL_TO_DINT(Position * Axis.fIncPerUnit);\n      fLast := Position;\n    END_IF\n  END_IF\n\n  InSync := iState = 20;\n  Busy := iState = 10 OR iState = 20;\n  Error := iState = 99;\n  IF iState = 0 THEN ErrorID := 0; END_IF\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CO402_CyclicTorque.st",
      "source": "(*\n * CO402_CyclicTorque: cyclic synchronous torque (CiA 402 mode 10) on an axis\n * of the editor's PLCopen motion library (spec canopen-cia402-axis).\n *\n * Call it every scan while it is in use, after the axis's drive bridge and\n * with MC_Power enabled. On a rising Enable it sets the target torque 0x6071\n * to 0, selects mode 10 (operation stays enabled) and follows Torque, in per\n * mille of the drive's rated torque (0x6076), once 0x6061 shows 10.\n * MaxTorqueRate (per mille/s, 0 = off) limits the step between two\n * set-points to MaxTorqueRate * Axis.fCycleTime; a larger step sets Error\n * (ErrorID 3) and holds the last set-point. In the scan Enable goes FALSE the\n * block sends torque 0, then stops writing.\n *\n * ErrorID: 1 drive not enabled, 2 mode not reached within ModeTimeout (or\n * left), 3 step limit exceeded, 4 axis in error stop (fault or drive lost).\n *)\nFUNCTION_BLOCK CO402_CyclicTorque\nVAR_IN_OUT\n  Axis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n  Enable : BOOL;\n  Torque : LREAL;                (* set-point [per mille of rated torque] *)\n  MaxTorqueRate : LREAL := 0.0;  (* step limit [per mille/s], 0 = off *)\n  ModeTimeout : TIME := T#500ms;\nEND_VAR\nVAR_OUTPUT\n  InSync : BOOL;\n  Busy : BOOL;\n  Error : BOOL;\n  ErrorID : UINT;\nEND_VAR\nVAR\n  iState : INT;  (* 0 idle, 10 selecting the mode, 20 following, 99 error *)\n  fLast : LREAL;\n  fSet : LREAL;\n  tMode : TON;\nEND_VAR\n  IF NOT Enable THEN\n    IF iState = 10 OR iState = 20 THEN\n      Axis.Drive.Target_torque := INT#0;\n    END_IF\n    iState := 0;\n  ELSIF iState = 0 THEN\n    ErrorID := 0;\n    IF Axis.bError OR NOT Axis.bCommunication THEN\n      ErrorID := 4;\n    ELSIF (Axis.Drive.StatusWord AND UINT#16#006F) <> UINT#16#0027 THEN\n      ErrorID := 1;\n    ELSE\n      Axis.Drive.Target_torque := INT#0;\n      fLast := 0.0;\n      Axis.Drive.Modes_of_operation := SINT#10;\n      iState := 10;\n    END_IF\n    IF ErrorID <> 0 THEN iState := 99; END_IF\n  END_IF\n\n  IF iState = 10 OR iState = 20 THEN\n    IF Axis.bError OR NOT Axis.bCommunication THEN\n      ErrorID := 4; iState := 99;\n    ELSIF (Axis.Drive.StatusWord AND UINT#16#006F) <> UINT#16#0027 THEN\n      ErrorID := 1; iState := 99;\n    END_IF\n  END_IF\n  tMode(IN := iState = 10, PT := ModeTimeout);\n  IF iState = 10 THEN\n    Axis.Drive.Modes_of_operation := SINT#10;\n    Axis.Drive.Target_torque := INT#0;\n    IF Axis.Drive.Modes_of_operation_display = SINT#10 THEN\n      iState := 20;\n    ELSIF tMode.Q THEN\n      ErrorID := 2; iState := 99;\n    END_IF\n  END_IF\n  IF iState = 20 THEN\n    IF Axis.Drive.Modes_of_operation_display <> SINT#10 THEN\n      ErrorID := 2; iState := 99;\n    ELSIF MaxTorqueRate > 0.0 AND ABS(Torque - fLast) > MaxTorqueRate * Axis.fCycleTime * 1.000001 THEN\n      ErrorID := 3; iState := 99;\n    ELSE\n      fSet := LIMIT(-32768.0, Torque, 32767.0);\n      Axis.Drive.Target_torque := LREAL_TO_INT(fSet);\n      fLast := Torque;\n    END_IF\n  END_IF\n\n  InSync := iState = 20;\n  Busy := iState = 10 OR iState = 20;\n  Error := iState = 99;\n  IF iState = 0 THEN ErrorID := 0; END_IF\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CO402_CyclicVelocity.st",
      "source": "(*\n * CO402_CyclicVelocity: cyclic synchronous velocity (CiA 402 mode 9) on an\n * axis of the editor's PLCopen motion library (spec canopen-cia402-axis).\n *\n * Call it every scan while it is in use, after the axis's drive bridge and\n * with MC_Power enabled. On a rising Enable it sets the target velocity\n * 0x60FF to 0, selects mode 9 (operation stays enabled) and follows Velocity\n * once 0x6061 shows 9. MaxAcceleration (units/s2, 0 = off) limits the step\n * between two set-points to MaxAcceleration * Axis.fCycleTime; a larger step\n * sets Error (ErrorID 3) and holds the last set-point. In the scan Enable\n * goes FALSE the block sends velocity 0, then stops writing.\n *\n * ErrorID: 1 drive not enabled, 2 mode not reached within ModeTimeout (or\n * left), 3 step limit exceeded, 4 axis in error stop (fault or drive lost).\n *)\nFUNCTION_BLOCK CO402_CyclicVelocity\nVAR_IN_OUT\n  Axis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n  Enable : BOOL;\n  Velocity : LREAL;                (* set-point [u/s] *)\n  MaxAcceleration : LREAL := 0.0;  (* step limit [u/s2], 0 = off *)\n  ModeTimeout : TIME := T#500ms;\nEND_VAR\nVAR_OUTPUT\n  InSync : BOOL;\n  Busy : BOOL;\n  Error : BOOL;\n  ErrorID : UINT;\nEND_VAR\nVAR\n  iState : INT;  (* 0 idle, 10 selecting the mode, 20 following, 99 error *)\n  fLast : LREAL;\n  tMode : TON;\nEND_VAR\n  IF NOT Enable THEN\n    IF iState = 10 OR iState = 20 THEN\n      Axis.Drive.Target_Velocity := DINT#0;\n    END_IF\n    iState := 0;\n  ELSIF iState = 0 THEN\n    ErrorID := 0;\n    IF Axis.bError OR NOT Axis.bCommunication THEN\n      ErrorID := 4;\n    ELSIF (Axis.Drive.StatusWord AND UINT#16#006F) <> UINT#16#0027 THEN\n      ErrorID := 1;\n    ELSE\n      Axis.Drive.Target_Velocity := DINT#0;\n      fLast := 0.0;\n      Axis.Drive.Modes_of_operation := SINT#9;\n      iState := 10;\n    END_IF\n    IF ErrorID <> 0 THEN iState := 99; END_IF\n  END_IF\n\n  IF iState = 10 OR iState = 20 THEN\n    IF Axis.bError OR NOT Axis.bCommunication THEN\n      ErrorID := 4; iState := 99;\n    ELSIF (Axis.Drive.StatusWord AND UINT#16#006F) <> UINT#16#0027 THEN\n      ErrorID := 1; iState := 99;\n    END_IF\n  END_IF\n  tMode(IN := iState = 10, PT := ModeTimeout);\n  IF iState = 10 THEN\n    Axis.Drive.Modes_of_operation := SINT#9;\n    Axis.Drive.Target_Velocity := DINT#0;\n    IF Axis.Drive.Modes_of_operation_display = SINT#9 THEN\n      iState := 20;\n    ELSIF tMode.Q THEN\n      ErrorID := 2; iState := 99;\n    END_IF\n  END_IF\n  IF iState = 20 THEN\n    IF Axis.Drive.Modes_of_operation_display <> SINT#9 THEN\n      ErrorID := 2; iState := 99;\n    ELSIF MaxAcceleration > 0.0 AND ABS(Velocity - fLast) > MaxAcceleration * Axis.fCycleTime * 1.000001 THEN\n      ErrorID := 3; iState := 99;\n    ELSE\n      Axis.Drive.Target_Velocity := LREAL_TO_DINT(Velocity * Axis.fIncPerUnit);\n      fLast := Velocity;\n    END_IF\n  END_IF\n\n  InSync := iState = 20;\n  Busy := iState = 10 OR iState = 20;\n  Error := iState = 99;\n  IF iState = 0 THEN ErrorID := 0; END_IF\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CO_SDO_READ.cpp",
      "source": "FUNCTION_BLOCK CO_SDO_READ\nVAR_INPUT\n  EXECUTE : BOOL;\n  NETWORK : USINT;\n  NODE : USINT;\n  INDEX : UINT;\n  SUBINDEX : USINT;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  BUSY : BOOL;\n  DONE : BOOL;\n  ERROR : BOOL;\n  ERROR_ID : UINT;\n  ABORT_CODE : UDINT;\n  DATA : LWORD;\n  SIZE : UINT;\nEND_VAR\nVAR\n  co_handle : UDINT;\n  co_prev : BOOL;\n  co_phase : USINT;\nEND_VAR\n// Shared code of the openplc_canopen SDO function blocks (spec\n// canopen-plc-sdo). library/generate.py copies it into every block's source,\n// because the editor grafts each library C++ block into one\n// c_blocks_code.cpp and offers no other place for shared code; the include\n// guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so\n// nothing here uses a pin or local name (the pins are upper case, the shared\n// code is lower case), nor the keyword that closes a variable section. No system header is included after\n// those defines: dlopen and dlsym are declared here as glibc does.\n#ifndef CO_SDO_COMMON_INCLUDED\n#define CO_SDO_COMMON_INCLUDED\nextern \"C\" void* dlopen(const char* file, int mode) noexcept(true);\nextern \"C\" void* dlsym(void* handle, const char* name) noexcept(true);\n\nnamespace co_sdo {\n\n// The plugin's C interface, version 1 (plugin/src/canopen_plc_api.h).\nconst unsigned api_version = 1;\nconst unsigned max_data = 1024;\nstruct request {\n  unsigned char network;\n  unsigned char node;\n  unsigned short index;\n  unsigned char subindex;\n  unsigned char write;\n  unsigned char kind;\n  unsigned char size;\n  unsigned int timeout_ms;\n  const unsigned char* data;\n  unsigned int length;\n};\nstruct result {\n  unsigned short error_id;\n  unsigned int abort_code;\n  unsigned int size;\n};\nstruct api_v1 {\n  unsigned int size;\n  unsigned int (*start)(const request* req, unsigned short* error_id);\n  int (*poll)(unsigned int handle, result* res, unsigned char* data, unsigned int cap);\n};\nenum { kind_int = 0, kind_real = 1, kind_string = 2, kind_bytes = 3 };\nenum { err_not_running = 4, err_input = 6, err_too_big = 7 };\n\n// The loaded plugin's table, looked up by its SONAME without loading it\n// again (RTLD_NOW | RTLD_NOLOAD). Looked up again on each start until found;\n// kept once found, since the runtime unloads plugins only when it exits.\n// (The plugin's own tests link the blocks into one process with the master\n// and name the entry point with -DCO_SDO_TEST_ENTRY.)\n#ifdef CO_SDO_TEST_ENTRY\n}  // namespace co_sdo\nextern \"C\" const void* CO_SDO_TEST_ENTRY(unsigned int version);\nnamespace co_sdo {\n#endif\ninline const api_v1* api() {\n  static const api_v1* table = nullptr;\n  if (table) return table;\n  typedef const void* (*entry_t)(unsigned int);\n#ifdef CO_SDO_TEST_ENTRY\n  entry_t entry = CO_SDO_TEST_ENTRY;\n#else\n  void* lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);\n  if (!lib) return nullptr;\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n#endif\n  if (!entry) return nullptr;\n  const api_v1* t = static_cast<const api_v1*>(entry(api_version));\n  if (t && t->size >= sizeof(api_v1)) table = t;\n  return table;\n}\n\n// TIME (nanoseconds) to the timeout in ms; 0 and negative mean the default.\ninline unsigned int timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<unsigned int>(ms);\n}\n\n// One block instance's handshake (PLCopen style). The block keeps `handle`\n// and `phase` in its locals and maps the outcome to its pins.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // a rising edge: clear the outputs and start a transfer\n  bool clear;   // the result was shown and EXECUTE is FALSE: clear DONE/ERROR\n};\ninline step begin(bool execute, bool& prev, unsigned char& phase) {\n  step s{false, false};\n  bool rising = execute && !prev;\n  prev = execute;\n  if (phase == phase_ended && !execute) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`; returns the handle or 0 with `error` set.\ninline unsigned int start(request& req, unsigned short& error) {\n  const api_v1* t = api();\n  if (!t) {\n    error = err_not_running;\n    return 0;\n  }\n  error = 0;\n  return t->start(&req, &error);\n}\n\n// 0 busy, 1 done, 2 error (`res` filled).\ninline int poll(unsigned int handle, result& res, unsigned char* data, unsigned int cap) {\n  const api_v1* t = api();\n  if (!t) {\n    res = result{err_not_running, 0, 0};\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void put_le(unsigned char* out, unsigned long long v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<unsigned char>(v >> (8 * b));\n}\n\ninline unsigned long long get_le(const unsigned char* in, unsigned n) {\n  unsigned long long v = 0;\n  for (unsigned b = 0; b < n; ++b) v |= static_cast<unsigned long long>(in[b]) << (8 * b);\n  return v;\n}\n\n}  // namespace co_sdo\n#endif\n// CO_SDO_READ: reads an integer or bit string object (up to 8 bytes) into DATA\n// Generated by library/generate.py; edit that file or src/common.inc.\n\nvoid setup() {\n}\n\nvoid loop() {\n  bool prev = co_prev;\n  unsigned char phase = co_phase;\n  co_sdo::step s = co_sdo::begin(EXECUTE, prev, phase);\n  co_prev = prev;\n  co_phase = phase;\n  if (s.clear) {\n    DONE = false;\n    ERROR = false;\n  }\n  if (s.start) {\n    DONE = false;\n    ERROR = false;\n    ERROR_ID = 0;\n    ABORT_CODE = 0;\n    DATA = 0ULL;\n    SIZE = 0;\n    unsigned short err = 0;\n    co_sdo::request req = {};\n    req.network = NETWORK;\n    req.node = NODE;\n    req.index = INDEX;\n    req.subindex = SUBINDEX;\n    req.write = 0;\n    req.kind = co_sdo::kind_int;\n    req.timeout_ms = co_sdo::timeout_ms(TIMEOUT);\n    unsigned int handle = err ? 0 : co_sdo::start(req, err);\n    if (handle) {\n      co_handle = handle;\n      BUSY = true;\n      co_phase = co_sdo::phase_busy;\n    } else {\n      BUSY = false;\n      ERROR = true;\n      ERROR_ID = err;\n      co_phase = co_sdo::phase_ended;\n    }\n  }\n  if (co_phase == co_sdo::phase_busy) {\n    co_sdo::result res = {};\n    unsigned char reply[9];\n    int st = co_sdo::poll(co_handle, res, reply, sizeof reply);\n    if (st != 0) {\n      BUSY = false;\n      co_handle = 0;\n      co_phase = co_sdo::phase_ended;\n      unsigned short err = st == 2 ? res.error_id : 0;\n      if (!err) {\n        if (res.size > 8) {\n          err = co_sdo::err_too_big;\n          SIZE = static_cast<unsigned short>(res.size > 65535u ? 65535u : res.size);\n        } else {\n          DATA = co_sdo::get_le(reply, res.size);\n          SIZE = static_cast<unsigned short>(res.size);\n        }\n      }\n      if (err) {\n        ERROR = true;\n        ERROR_ID = err;\n        ABORT_CODE = (err == 1 || err == 2) ? res.abort_code : 0u;\n      } else {\n        DONE = true;\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CO_SDO_READ_BYTES.cpp",
      "source": "FUNCTION_BLOCK CO_SDO_READ_BYTES\nVAR_INPUT\n  EXECUTE : BOOL;\n  NETWORK : USINT;\n  NODE : USINT;\n  INDEX : UINT;\n  SUBINDEX : USINT;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  BUSY : BOOL;\n  DONE : BOOL;\n  ERROR : BOOL;\n  ERROR_ID : UINT;\n  ABORT_CODE : UDINT;\n  SIZE : UINT;\nEND_VAR\nVAR_IN_OUT\n  BUFFER : ARRAY[0..1023] OF BYTE;\nEND_VAR\nVAR\n  co_handle : UDINT;\n  co_prev : BOOL;\n  co_phase : USINT;\nEND_VAR\n// Shared code of the openplc_canopen SDO function blocks (spec\n// canopen-plc-sdo). library/generate.py copies it into every block's source,\n// because the editor grafts each library C++ block into one\n// c_blocks_code.cpp and offers no other place for shared code; the include\n// guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so\n// nothing here uses a pin or local name (the pins are upper case, the shared\n// code is lower case), nor the keyword that closes a variable section. No system header is included after\n// those defines: dlopen and dlsym are declared here as glibc does.\n#ifndef CO_SDO_COMMON_INCLUDED\n#define CO_SDO_COMMON_INCLUDED\nextern \"C\" void* dlopen(const char* file, int mode) noexcept(true);\nextern \"C\" void* dlsym(void* handle, const char* name) noexcept(true);\n\nnamespace co_sdo {\n\n// The plugin's C interface, version 1 (plugin/src/canopen_plc_api.h).\nconst unsigned api_version = 1;\nconst unsigned max_data = 1024;\nstruct request {\n  unsigned char network;\n  unsigned char node;\n  unsigned short index;\n  unsigned char subindex;\n  unsigned char write;\n  unsigned char kind;\n  unsigned char size;\n  unsigned int timeout_ms;\n  const unsigned char* data;\n  unsigned int length;\n};\nstruct result {\n  unsigned short error_id;\n  unsigned int abort_code;\n  unsigned int size;\n};\nstruct api_v1 {\n  unsigned int size;\n  unsigned int (*start)(const request* req, unsigned short* error_id);\n  int (*poll)(unsigned int handle, result* res, unsigned char* data, unsigned int cap);\n};\nenum { kind_int = 0, kind_real = 1, kind_string = 2, kind_bytes = 3 };\nenum { err_not_running = 4, err_input = 6, err_too_big = 7 };\n\n// The loaded plugin's table, looked up by its SONAME without loading it\n// again (RTLD_NOW | RTLD_NOLOAD). Looked up again on each start until found;\n// kept once found, since the runtime unloads plugins only when it exits.\n// (The plugin's own tests link the blocks into one process with the master\n// and name the entry point with -DCO_SDO_TEST_ENTRY.)\n#ifdef CO_SDO_TEST_ENTRY\n}  // namespace co_sdo\nextern \"C\" const void* CO_SDO_TEST_ENTRY(unsigned int version);\nnamespace co_sdo {\n#endif\ninline const api_v1* api() {\n  static const api_v1* table = nullptr;\n  if (table) return table;\n  typedef const void* (*entry_t)(unsigned int);\n#ifdef CO_SDO_TEST_ENTRY\n  entry_t entry = CO_SDO_TEST_ENTRY;\n#else\n  void* lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);\n  if (!lib) return nullptr;\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n#endif\n  if (!entry) return nullptr;\n  const api_v1* t = static_cast<const api_v1*>(entry(api_version));\n  if (t && t->size >= sizeof(api_v1)) table = t;\n  return table;\n}\n\n// TIME (nanoseconds) to the timeout in ms; 0 and negative mean the default.\ninline unsigned int timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<unsigned int>(ms);\n}\n\n// One block instance's handshake (PLCopen style). The block keeps `handle`\n// and `phase` in its locals and maps the outcome to its pins.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // a rising edge: clear the outputs and start a transfer\n  bool clear;   // the result was shown and EXECUTE is FALSE: clear DONE/ERROR\n};\ninline step begin(bool execute, bool& prev, unsigned char& phase) {\n  step s{false, false};\n  bool rising = execute && !prev;\n  prev = execute;\n  if (phase == phase_ended && !execute) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`; returns the handle or 0 with `error` set.\ninline unsigned int start(request& req, unsigned short& error) {\n  const api_v1* t = api();\n  if (!t) {\n    error = err_not_running;\n    return 0;\n  }\n  error = 0;\n  return t->start(&req, &error);\n}\n\n// 0 busy, 1 done, 2 error (`res` filled).\ninline int poll(unsigned int handle, result& res, unsigned char* data, unsigned int cap) {\n  const api_v1* t = api();\n  if (!t) {\n    res = result{err_not_running, 0, 0};\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void put_le(unsigned char* out, unsigned long long v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<unsigned char>(v >> (8 * b));\n}\n\ninline unsigned long long get_le(const unsigned char* in, unsigned n) {\n  unsigned long long v = 0;\n  for (unsigned b = 0; b < n; ++b) v |= static_cast<unsigned long long>(in[b]) << (8 * b);\n  return v;\n}\n\n}  // namespace co_sdo\n#endif\n// CO_SDO_READ_BYTES: reads any object (up to 1024 bytes) into BUFFER\n// Generated by library/generate.py; edit that file or src/common.inc.\n\nvoid setup() {\n}\n\nvoid loop() {\n  bool prev = co_prev;\n  unsigned char phase = co_phase;\n  co_sdo::step s = co_sdo::begin(EXECUTE, prev, phase);\n  co_prev = prev;\n  co_phase = phase;\n  if (s.clear) {\n    DONE = false;\n    ERROR = false;\n  }\n  if (s.start) {\n    DONE = false;\n    ERROR = false;\n    ERROR_ID = 0;\n    ABORT_CODE = 0;\n    SIZE = 0;\n    unsigned short err = 0;\n    co_sdo::request req = {};\n    req.network = NETWORK;\n    req.node = NODE;\n    req.index = INDEX;\n    req.subindex = SUBINDEX;\n    req.write = 0;\n    req.kind = co_sdo::kind_bytes;\n    req.timeout_ms = co_sdo::timeout_ms(TIMEOUT);\n    unsigned int handle = err ? 0 : co_sdo::start(req, err);\n    if (handle) {\n      co_handle = handle;\n      BUSY = true;\n      co_phase = co_sdo::phase_busy;\n    } else {\n      BUSY = false;\n      ERROR = true;\n      ERROR_ID = err;\n      co_phase = co_sdo::phase_ended;\n    }\n  }\n  if (co_phase == co_sdo::phase_busy) {\n    co_sdo::result res = {};\n    unsigned char reply[1024];\n    int st = co_sdo::poll(co_handle, res, reply, sizeof reply);\n    if (st != 0) {\n      BUSY = false;\n      co_handle = 0;\n      co_phase = co_sdo::phase_ended;\n      unsigned short err = st == 2 ? res.error_id : 0;\n      if (!err) {\n        SIZE = static_cast<unsigned short>(res.size > 65535u ? 65535u : res.size);\n        if (res.size > co_sdo::max_data) {\n          err = co_sdo::err_too_big;\n        } else {\n          for (unsigned int i = 0; i < res.size; ++i) BUFFER[i] = reply[i];\n        }\n      }\n      if (err) {\n        ERROR = true;\n        ERROR_ID = err;\n        ABORT_CODE = (err == 1 || err == 2) ? res.abort_code : 0u;\n      } else {\n        DONE = true;\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "CO_SDO_READ_REAL.cpp",
      "source": "FUNCTION_BLOCK CO_SDO_READ_REAL\nVAR_INPUT\n  EXECUTE : BOOL;\n  NETWORK : USINT;\n  NODE : USINT;\n  INDEX : UINT;\n  SUBINDEX : USINT;\n  TIMEOUT : TIME;\nEND_VAR\nVAR_OUTPUT\n  BUSY : BOOL;\n  DONE : BOOL;\n  ERROR : BOOL;\n  ERROR_ID : UINT;\n  ABORT_CODE : UDINT;\n  VALUE : LREAL;\nEND_VAR\nVAR\n  co_handle : UDINT;\n  co_prev : BOOL;\n  co_phase : USINT;\nEND_VAR\n// Shared code of the openplc_canopen SDO function blocks (spec\n// canopen-plc-sdo). library/generate.py copies it into every block's source,\n// because the editor grafts each library C++ block into one\n// c_blocks_code.cpp and offers no other place for shared code; the include\n// guard keeps one copy per program.\n//\n// The editor binds every pin and local of a block to a #define of its name, so\n// nothing here uses a pin or local name (the pins are upper case, the shared\n// code is lower case), nor the keyword that closes a variable section. No system header is included after\n// those defines: dlopen and dlsym are declared here as glibc does.\n#ifndef CO_SDO_COMMON_INCLUDED\n#define CO_SDO_COMMON_INCLUDED\nextern \"C\" void* dlopen(const char* file, int mode) noexcept(true);\nextern \"C\" void* dlsym(void* handle, const char* name) noexcept(true);\n\nnamespace co_sdo {\n\n// The plugin's C interface, version 1 (plugin/src/canopen_plc_api.h).\nconst unsigned api_version = 1;\nconst unsigned max_data = 1024;\nstruct request {\n  unsigned char network;\n  unsigned char node;\n  unsigned short index;\n  unsigned char subindex;\n  unsigned char write;\n  unsigned char kind;\n  unsigned char size;\n  unsigned int timeout_ms;\n  const unsigned char* data;\n  unsigned int length;\n};\nstruct result {\n  unsigned short error_id;\n  unsigned int abort_code;\n  unsigned int size;\n};\nstruct api_v1 {\n  unsigned int size;\n  unsigned int (*start)(const request* req, unsigned short* error_id);\n  int (*poll)(unsigned int handle, result* res, unsigned char* data, unsigned int cap);\n};\nenum { kind_int = 0, kind_real = 1, kind_string = 2, kind_bytes = 3 };\nenum { err_not_running = 4, err_input = 6, err_too_big = 7 };\n\n// The loaded plugin's table, looked up by its SONAME without loading it\n// again (RTLD_NOW | RTLD_NOLOAD). Looked up again on each start until found;\n// kept once found, since the runtime unloads plugins only when it exits.\n// (The plugin's own tests link the blocks into one process with the master\n// and name the entry point with -DCO_SDO_TEST_ENTRY.)\n#ifdef CO_SDO_TEST_ENTRY\n}  // namespace co_sdo\nextern \"C\" const void* CO_SDO_TEST_ENTRY(unsigned int version);\nnamespace co_sdo {\n#endif\ninline const api_v1* api() {\n  static const api_v1* table = nullptr;\n  if (table) return table;\n  typedef const void* (*entry_t)(unsigned int);\n#ifdef CO_SDO_TEST_ENTRY\n  entry_t entry = CO_SDO_TEST_ENTRY;\n#else\n  void* lib = dlopen(\"libcanopen_plugin.so\", 0x2 | 0x4);\n  if (!lib) return nullptr;\n  entry_t entry = reinterpret_cast<entry_t>(dlsym(lib, \"canopen_plc_api\"));\n#endif\n  if (!entry) return nullptr;\n  const api_v1* t = static_cast<const api_v1*>(entry(api_version));\n  if (t && t->size >= sizeof(api_v1)) table = t;\n  return table;\n}\n\n// TIME (nanoseconds) to the timeout in ms; 0 and negative mean the default.\ninline unsigned int timeout_ms(long long ns) {\n  if (ns <= 0) return 0;\n  long long ms = (ns + 999999) / 1000000;\n  return ms > 3600000 ? 3600000u : static_cast<unsigned int>(ms);\n}\n\n// One block instance's handshake (PLCopen style). The block keeps `handle`\n// and `phase` in its locals and maps the outcome to its pins.\nenum { phase_idle = 0, phase_busy = 1, phase_ended = 2 };\nstruct step {\n  bool start;   // a rising edge: clear the outputs and start a transfer\n  bool clear;   // the result was shown and EXECUTE is FALSE: clear DONE/ERROR\n};\ninline step begin(bool execute, bool& prev, unsigned char& phase) {\n  step s{false, false};\n  bool rising = execute && !prev;\n  prev = execute;\n  if (phase == phase_ended && !execute) {\n    s.clear = true;\n    phase = phase_idle;\n  }\n  if (rising && phase != phase_busy) s.start = true;\n  return s;\n}\n\n// Starts `req`; returns the handle or 0 with `error` set.\ninline unsigned int start(request& req, unsigned short& error) {\n  const api_v1* t = api();\n  if (!t) {\n    error = err_not_running;\n    return 0;\n  }\n  error = 0;\n  return t->start(&req, &error);\n}\n\n// 0 busy, 1 done, 2 error (`res` filled).\ninline int poll(unsigned int handle, result& res, unsigned char* data, unsigned int cap) {\n  const api_v1* t = api();\n  if (!t) {\n    res = result{err_not_running, 0, 0};\n    return 2;\n  }\n  return t->poll(handle, &res, data, cap);\n}\n\ninline void put_le(unsigned char* out, unsigned long long v, unsigned n) {\n  for (unsigned b = 0; b < n; ++b) out[b] = static_cast<unsigned char>(v >> (8 * b));\n}\n\ninline unsigned long long get_le(const unsigned char* in, unsigned n) {\n  unsigned long long v = 0;\n  for (unsigned b = 0; b < n; ++b) v |= static_cast<unsigned long long>(in[b]) << (8 * b);\n  return v;\n}\n\n}  // namespace co_sdo\n#endif\n// CO_SDO_READ_REAL: reads a REAL32 or REAL64 object into VALUE\n// Generated by library/generate.py; edit that file or src/common.inc.\n\nvoid setup() {\n}\n\nvoid loop() {\n  bool prev = co_prev;\n  unsigned char phase = co_phase;\n  co_sdo::step s = co_sdo::begin(EXECUTE, prev, phase);\n  co_prev = prev;\n  co_phase = phase;\n  if (s.clear) {\n    DONE = false;\n    ERROR = false;\n  }\n  if (s.start) {\n    DONE = false;\n    ERROR = false;\n    ERROR_ID = 0;\n    ABORT_CODE = 0;\n    unsigned short err = 0;\n    co_sdo::request req = {};\n    req.network = NETWORK;\n    req.node = NODE;\n    req.index = INDEX;\n    req.subindex = SUBINDEX;\n    req.write = 0;\n    req.kind = co_sdo::kind_real;\n    req.timeout_ms = co_sdo::timeout_ms(TIMEOUT);\n    unsigned int handle = err ? 0 : co_sdo::start(req, err);\n    if (handle) {\n      co_handle = handle;\n      BUSY = true;\n      co_phase = co_sdo::phase_busy;\n    } else {\n      BUSY = false;\n      ERROR = true;\n      ERROR_ID = err;\n      co_phase = co_sdo::phase_ended;\n    }\n  }\n  if (co_phase == co_sdo::phase_busy) {\n    co_sdo::result res = {};\n    unsigned char reply[9];\n    int st = co_sdo::poll(co_handle, res, reply, sizeof reply);\n    if (st != 0) {\n      BUSY = false;\n      co_handle = 0;\n      co_phase = co_sdo::phase_ended;\n      unsigned short err = st == 2 ? res.error_id : 0;\n      if (!err) {\n        if (res.size == 4) {\n          unsigned int bits = static_cast<unsigned int>(co_sdo::get_le(reply, 4));\n          float f;\n          memcpy(&f, &bits, sizeof f);\n          VALUE = static_cast<double>(f);\n        } else if (res.size == 8) {\n          unsigned long long bits = co_sdo::get_le(reply, 8);\n          double d;\n          memcpy(&d, &bits, sizeof d);\n          VALUE = d;\n        } else {\n          err = co_sdo::err_too_big;\n        }\n      }\n      if (err) {\n        ERROR = true;\n        ERROR_ID = err;\n        ABORT_CODE = (err == 1 || err == 2) ? res.abort_code : 0u;\n      } else {\n        DONE = true;\n      }\n    }\n  }\n}\nEND_FUNCTION_BLOCK\n"
    },
