  "chunks": [
    {
      "name": "CO402_CYCLICMOVEABSOLUTE",
      "kind": "functionBlock",
      "header": "class CO402_CYCLICMOVEABSOLUTE {\npublic:\n    // In-Out\n    AXIS_REF_SM3 AXIS;\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_LREAL POSITION;\n    IEC_LREAL VELOCITY;\n    IEC_LREAL ACCELERATION;\n    IEC_LREAL JERK;\n    IEC_LREAL WINDOW;\n    IEC_TIME MODETIMEOUT;\n    // Outputs\n    IEC_BOOL DONE;\n    IEC_BOOL BUSY;\n    IEC_BOOL INSYNC;\n    IEC_BOOL ERROR;\n    IEC_UINT ERRORID;\n    // Local variables\n    IEC_INT ISTATE;\n    FB_S7RTT_PLAN PLAN;\n    ST_MOTIONSTATE START;\n    ST_MOTIONLIMITS LIMITS;\n    IEC_LREAL FSET;\n    IEC_LREAL FT;\n    IEC_LREAL FELAPSED;\n    IEC_LREAL FDURATION;\n    IEC_LREAL FWINDOW;\n    IEC_LREAL FACTUAL;\n    IEC_INT I;\n    TON TMODE;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO402_CYCLICMOVEABSOLUTE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO402_CYCLICMOVEABSOLUTE() = default;\n};\n",
      "cpp": "CO402_CYCLICMOVEABSOLUTE::CO402_CYCLICMOVEABSOLUTE()\n    : WINDOW(0.0), MODETIMEOUT(500000000LL)\n{\n    // Initialize variables\n}\n\nvoid CO402_CYCLICMOVEABSOLUTE::operator()() {\n    if (!EXECUTE) {\n        ISTATE = 0;\n    } else if (ISTATE == 0) {\n        ERRORID = 0;\n        if ((AXIS.BERROR) | (!AXIS.BCOMMUNICATION)) {\n            ERRORID = 4;\n        } else if (((AXIS.DRIVE.STATUSWORD) & (static_cast<IEC_UINT>(0x006F))) != static_cast<IEC_UINT>(0x0027)) {\n            ERRORID = 1;\n        } else if (((VELOCITY <= 0.0) | (ACCELERATION <= 0.0)) | (JERK <= 0.0)) {\n            ERRORID = 5;\n        } else {\n            AXIS.DRIVE.TARGET_POSITION = AXIS.DRIVE.POSITION_ACTUAL_VALUE;\n            AXIS.DRIVE.MODES_OF_OPERATION = static_cast<IEC_SINT>(8);\n            ISTATE = 10;\n        }\n        if (ERRORID != 0) {\n            ISTATE = 99;\n        }\n    }\n    if (((ISTATE == 10) | (ISTATE == 20)) | (ISTATE == 30)) {\n        if ((AXIS.BERROR) | (!AXIS.BCOMMUNICATION)) {\n            ERRORID = 4;\n            ISTATE = 99;\n        } else if (((AXIS.DRIVE.STATUSWORD) & (static_cast<IEC_UINT>(0x006F))) != static_cast<IEC_UINT>(0x0027)) {\n            ERRORID = 1;\n            ISTATE = 99;\n        } else if ((ISTATE != 10) & (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY != static_cast<IEC_SINT>(8))) {\n            ERRORID = 2;\n            ISTATE = 99;\n        }\n    }\n    TMODE.IN = ISTATE == 10;\n    TMODE.PT = MODETIMEOUT;\n    TMODE();\n    TMODE.ENO = true;\n    FACTUAL = TO_LREAL(AXIS.DRIVE.POSITION_ACTUAL_VALUE) / AXIS.FINCPERUNIT;\n    if (ISTATE == 10) {\n        AXIS.DRIVE.MODES_OF_OPERATION = static_cast<IEC_SINT>(8);\n        AXIS.DRIVE.TARGET_POSITION = AXIS.DRIVE.POSITION_ACTUAL_VALUE;\n        if (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY == static_cast<IEC_SINT>(8)) {\n            START.FPOS = FACTUAL;\n            START.FVEL = 0.0;\n            START.FACC = 0.0;\n            START.FDURATION = 0.0;\n            LIMITS.FVELMAX = VELOCITY;\n            LIMITS.FACCMAX = ACCELERATION;\n            LIMITS.FJERKMAX = JERK;\n            PLAN.EXECUTE = false;\n            PLAN();\n            PLAN.ENO = true;\n            PLAN.EXECUTE = true;\n            PLAN.MODEVELOCITY = false;\n            PLAN.STARTSTATE = START;\n            PLAN.TARGETPOS = POSITION;\n            PLAN.TARGETVEL = 0.0;\n            PLAN.LIMITS = LIMITS;\n            PLAN();\n            PLAN.ENO = true;\n            FDURATION = 0.0;\n            for (I = 1; I <= PLAN.SEGMENTCOUNT; I++) {\n                FDURATION = FDURATION + PLAN.TRAJECTORY.at(I).FDURATION;\n            }\n            FELAPSED = 0.0;\n            if (PLAN.ERROR) {\n                ERRORID = 5;\n                ISTATE = 99;\n            } else {\n                ISTATE = 20;\n            }\n        } else if (TMODE.Q) {\n            ERRORID = 2;\n            ISTATE = 99;\n        }\n    }\n    if (ISTATE == 20) {\n        FELAPSED = FELAPSED + AXIS.FCYCLETIME;\n        if ((FELAPSED >= FDURATION) | (PLAN.SEGMENTCOUNT <= 0)) {\n            AXIS.DRIVE.TARGET_POSITION = TO_DINT(POSITION * AXIS.FINCPERUNIT);\n            ISTATE = 30;\n        } else {\n            FT = FELAPSED;\n            FSET = POSITION;\n            for (I = 1; I <= PLAN.SEGMENTCOUNT; I++) {\n                if (FT <= PLAN.TRAJECTORY.at(I).FDURATION) {\n                    FSET = PLAN.TRAJECTORY.at(I).FPOS + PLAN.TRAJECTORY.at(I).FVEL * FT + 0.5 * PLAN.TRAJECTORY.at(I).FACC * FT * FT + PLAN.TRAJECTORY.at(I).FJERK * FT * FT * FT / 6.0;\n                    goto __strucpp_loop_exit_1;\n                }\n                FT = FT - PLAN.TRAJECTORY.at(I).FDURATION;\n            }\n            __strucpp_loop_exit_1: ;\n            AXIS.DRIVE.TARGET_POSITION = TO_DINT(FSET * AXIS.FINCPERUNIT);\n        }\n    }\n    if (ISTATE == 30) {\n        AXIS.DRIVE.TARGET_POSITION = TO_DINT(POSITION * AXIS.FINCPERUNIT);\n    }\n    FWINDOW = WINDOW;\n    if (FWINDOW <= 0.0) {\n        FWINDOW = 1.0 / ABS(AXIS.FINCPERUNIT);\n    }\n    DONE = (ISTATE == 30) & (ABS(FACTUAL - POSITION) <= FWINDOW);\n    INSYNC = (ISTATE == 20) | (ISTATE == 30);\n    BUSY = ((((ISTATE == 10) | (ISTATE == 20)) | (ISTATE == 30))) & (!DONE);\n    ERROR = ISTATE == 99;\n    if (ISTATE == 0) {\n        ERRORID = 0;\n    }\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "TON"
        },
        {
          "library": "iec-std-functions",
          "name": "ABS"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        },
        {
          "library": "oscat-basic",
          "name": "WINDOW"
        },
        {
          "library": "plcopen-softmotion",
          "name": "AXIS_REF_SM3"
        },
        {
          "library": "plcopen-softmotion",
          "name": "FB_S7RTT_PLAN"
        },
        {
          "library": "plcopen-softmotion",
          "name": "ST_MOTIONLIMITS"
        },
        {
          "library": "plcopen-softmotion",
          "name": "ST_MOTIONSTATE"
        }
      ]
    },
    {
      "name": "CO402_CYCLICPOSITION",
      "kind": "functionBlock",
      "header": "class CO402_CYCLICPOSITION {\npublic:\n    // In-Out\n    AXIS_REF_SM3 AXIS;\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_LREAL POSITION;\n    IEC_LREAL MAXVELOCITY;\n    IEC_TIME MODETIMEOUT;\n    // Outputs\n    IEC_BOOL INSYNC;\n    IEC_BOOL BUSY;\n    IEC_BOOL ERROR;\n    IEC_UINT ERRORID;\n    // Local variables\n    IEC_INT ISTATE;\n    IEC_LREAL FLAST;\n    TON TMODE;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO402_CYCLICPOSITION();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO402_CYCLICPOSITION() = default;\n};\n",
      "cpp": "CO402_CYCLICPOSITION::CO402_CYCLICPOSITION()\n    : MAXVELOCITY(0.0), MODETIMEOUT(500000000LL)\n{\n    // Initialize variables\n}\n\nvoid CO402_CYCLICPOSITION::operator()() {\n    if (!ENABLE) {\n        ISTATE = 0;\n    } else if (ISTATE == 0) {\n        ERRORID = 0;\n        if ((AXIS.BERROR) | (!AXIS.BCOMMUNICATION)) {\n            ERRORID = 4;\n        } else if (((AXIS.DRIVE.STATUSWORD) & (static_cast<IEC_UINT>(0x006F))) != static_cast<IEC_UINT>(0x0027)) {\n            ERRORID = 1;\n        } else {\n            AXIS.DRIVE.TARGET_POSITION = AXIS.DRIVE.POSITION_ACTUAL_VALUE;\n            FLAST = TO_LREAL(AXIS.DRIVE.POSITION_ACTUAL_VALUE) / AXIS.FINCPERUNIT;\n            AXIS.DRIVE.MODES_OF_OPERATION = static_cast<IEC_SINT>(8);\n            ISTATE = 10;\n        }\n        if (ERRORID != 0) {\n            ISTATE = 99;\n        }\n    }\n    if ((ISTATE == 10) | (ISTATE == 20)) {\n        if ((AXIS.BERROR) | (!AXIS.BCOMMUNICATION)) {\n            ERRORID = 4;\n            ISTATE = 99;\n        } else if (((AXIS.DRIVE.STATUSWORD) & (static_cast<IEC_UINT>(0x006F))) != static_cast<IEC_UINT>(0x0027)) {\n            ERRORID = 1;\n            ISTATE = 99;\n        }\n    }\n    TMODE.IN = ISTATE == 10;\n    TMODE.PT = MODETIMEOUT;\n    TMODE();\n    TMODE.ENO = true;\n    if (ISTATE == 10) {\n        AXIS.DRIVE.MODES_OF_OPERATION = static_cast<IEC_SINT>(8);\n        AXIS.DRIVE.TARGET_POSITION = AXIS.DRIVE.POSITION_ACTUAL_VALUE;\n        if (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY == static_cast<IEC_SINT>(8)) {\n            FLAST = TO_LREAL(AXIS.DRIVE.POSITION_ACTUAL_VALUE) / AXIS.FINCPERUNIT;\n            ISTATE = 20;\n        } else if (TMODE.Q) {\n            ERRORID = 2;\n            ISTATE = 99;\n        }\n    }\n    if (ISTATE == 20) {\n        if (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY != static_cast<IEC_SINT>(8)) {\n            ERRORID = 2;\n            ISTATE = 99;\n        } else if ((MAXVELOCITY > 0.0) & (ABS(POSITION - FLAST) > MAXVELOCITY * AXIS.FCYCLETIME * 1.000001)) {\n            ERRORID = 3;\n            ISTATE = 99;\n        } else {\n            AXIS.DRIVE.TARGET_POSITION = TO_DINT(POSITION * AXIS.FINCPERUNIT);\n            FLAST = POSITION;\n        }\n    }\n    INSYNC = ISTATE == 20;\n    BUSY = (ISTATE == 10) | (ISTATE == 20);\n    ERROR = ISTATE == 99;\n    if (ISTATE == 0) {\n        ERRORID = 0;\n    }\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "TON"
        },
        {
          "library": "iec-std-functions",
          "name": "ABS"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        },
        {
          "library": "plcopen-softmotion",
          "name": "AXIS_REF_SM3"
        }
      ]
    },
    {
      "name": "CO402_CYCLICTORQUE",
      "kind": "functionBlock",
      "header": "class CO402_CYCLICTORQUE {\npublic:\n    // In-Out\n    AXIS_REF_SM3 AXIS;\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_LREAL TORQUE;\n    IEC_LREAL MAXTORQUERATE;\n    IEC_TIME MODETIMEOUT;\n    // Outputs\n    IEC_BOOL INSYNC;\n    IEC_BOOL BUSY;\n    IEC_BOOL ERROR;\n    IEC_UINT ERRORID;\n    // Local variables\n    IEC_INT ISTATE;\n    IEC_LREAL FLAST;\n    IEC_LREAL FSET;\n    TON TMODE;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO402_CYCLICTORQUE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO402_CYCLICTORQUE() = default;\n};\n",
      "cpp": "CO402_CYCLICTORQUE::CO402_CYCLICTORQUE()\n    : MAXTORQUERATE(0.0), MODETIMEOUT(500000000LL)\n{\n    // Initialize variables\n}\n\nvoid CO402_CYCLICTORQUE::operator()() {\n    if (!ENABLE) {\n        if ((ISTATE == 10) | (ISTATE == 20)) {\n            AXIS.DRIVE.TARGET_TORQUE = static_cast<IEC_INT>(0);\n        }\n        ISTATE = 0;\n    } else if (ISTATE == 0) {\n        ERRORID = 0;\n        if ((AXIS.BERROR) | (!AXIS.BCOMMUNICATION)) {\n            ERRORID = 4;\n        } else if (((AXIS.DRIVE.STATUSWORD) & (static_cast<IEC_UINT>(0x006F))) != static_cast<IEC_UINT>(0x0027)) {\n            ERRORID = 1;\n        } else {\n            AXIS.DRIVE.TARGET_TORQUE = static_cast<IEC_INT>(0);\n            FLAST = 0.0;\n            AXIS.DRIVE.MODES_OF_OPERATION = static_cast<IEC_SINT>(10);\n            ISTATE = 10;\n        }\n        if (ERRORID != 0) {\n            ISTATE = 99;\n        }\n    }\n    if ((ISTATE == 10) | (ISTATE == 20)) {\n        if ((AXIS.BERROR) | (!AXIS.BCOMMUNICATION)) {\n            ERRORID = 4;\n            ISTATE = 99;\n        } else if (((AXIS.DRIVE.STATUSWORD) & (static_cast<IEC_UINT>(0x006F))) != static_cast<IEC_UINT>(0x0027)) {\n            ERRORID = 1;\n            ISTATE = 99;\n        }\n    }\n    TMODE.IN = ISTATE == 10;\n    TMODE.PT = MODETIMEOUT;\n    TMODE();\n    TMODE.ENO = true;\n    if (ISTATE == 10) {\n        AXIS.DRIVE.MODES_OF_OPERATION = static_cast<IEC_SINT>(10);\n        AXIS.DRIVE.TARGET_TORQUE = static_cast<IEC_INT>(0);\n        if (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY == static_cast<IEC_SINT>(10)) {\n            ISTATE = 20;\n        } else if (TMODE.Q) {\n            ERRORID = 2;\n            ISTATE = 99;\n        }\n    }\n    if (ISTATE == 20) {\n        if (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY != static_cast<IEC_SINT>(10)) {\n            ERRORID = 2;\n            ISTATE = 99;\n        } else if ((MAXTORQUERATE > 0.0) & (ABS(TORQUE - FLAST) > MAXTORQUERATE * AXIS.FCYCLETIME * 1.000001)) {\n            ERRORID = 3;\n            ISTATE = 99;\n        } else {\n            FSET = LIMIT(static_cast<IEC_LREAL>(-32768.0), TORQUE, static_cast<IEC_LREAL>(32767.0));\n            AXIS.DRIVE.TARGET_TORQUE = TO_INT(FSET);\n            FLAST = TORQUE;\n        }\n    }\n    INSYNC = ISTATE == 20;\n    BUSY = (ISTATE == 10) | (ISTATE == 20);\n    ERROR = ISTATE == 99;\n    if (ISTATE == 0) {\n        ERRORID = 0;\n    }\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "TON"
        },
        {
          "library": "iec-std-functions",
          "name": "ABS"
        },
        {
          "library": "iec-std-functions",
          "name": "LIMIT"
        },
        {
          "library": "iec-std-functions",
          "name": "TIME"
        },
        {
          "library": "plcopen-softmotion",
          "name": "AXIS_REF_SM3"
        }
      ]
    },
    {
      "name": "CO402_CYCLICVELOCITY",
      "kind": "functionBlock",
      "header": "class CO402_CYCLICVELOCITY {\npublic:\n    // In-Out\n    AXIS_REF_SM3 AXIS;\n    // Inputs\n    IEC_BOOL ENABLE;\n    IEC_LREAL VELOCITY;\n    IEC_LREAL MAXACCELERATION;\n    IEC_TIME MODETIMEOUT;\n    // Outputs\n    IEC_BOOL INSYNC;\n    IEC_BOOL BUSY;\n    IEC_BOOL ERROR;\n    IEC_UINT ERRORID;\n    // Local variables\n    IEC_INT ISTATE;\n    IEC_LREAL FLAST;\n    TON TMODE;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    CO402_CYCLICVELOCITY();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~CO402_CYCLICVELOCITY() = default;\n};\n",
      "cpp": "CO402_CYCLICVELOCITY::CO402_CYCLICVELOCITY()\n    : MAXACCELERATION(0.0), MODETIMEOUT(500000000LL)\n{\n    // Initialize variables\n}\n\nvoid CO402_CYCLICVELOCITY::operator()() {\n    if (!ENABLE) {\n        if ((ISTATE == 10) | (ISTATE == 20)) {\n            AXIS.DRIVE.TARGET_VELOCITY = static_cast<IEC_DINT>(0);\n        }\n        ISTATE = 0;\n    } else if (ISTATE == 0) {\n        ERRORID = 0;\n        if ((AXIS.BERROR) | (!AXIS.BCOMMUNICATION)) {\n            ERRORID = 4;\n        } else if (((AXIS.DRIVE.STATUSWORD) & (static_cast<IEC_UINT>(0x006F))) != static_cast<IEC_UINT>(0x0027)) {\n            ERRORID = 1;\n        } else {\n            AXIS.DRIVE.TARGET_VELOCITY = static_cast<IEC_DINT>(0);\n            FLAST = 0.0;\n            AXIS.DRIVE.MODES_OF_OPERATION = static_cast<IEC_SINT>(9);\n            ISTATE = 10;\n        }\n        if (ERRORID != 0) {\n            ISTATE = 99;\n        }\n    }\n    if ((ISTATE == 10) | (ISTATE == 20)) {\n        if ((AXIS.BERROR) | (!AXIS.BCOMMUNICATION)) {\n            ERRORID = 4;\n            ISTATE = 99;\n        } else if (((AXIS.DRIVE.STATUSWORD) & (static_cast<IEC_UINT>(0x006F))) != static_cast<IEC_UINT>(0x0027)) {\n            ERRORID = 1;\n            ISTATE = 99;\n        }\n    }\n    TMODE.IN = ISTATE == 10;\n    TMODE.PT = MODETIMEOUT;\n    TMODE();\n    TMODE.ENO = true;\n    if (ISTATE == 10) {\n        AXIS.DRIVE.MODES_OF_OPERATION = static_cast<IEC_SINT>(9);\n        AXIS.DRIVE.TARGET_VELOCITY = static_cast<IEC_DINT>(0);\n        if (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY == static_cast<IEC_SINT>(9)) {\n            ISTATE = 20;\n        } else if (TMODE.Q) {\n            ERRORID = 2;\n            ISTATE = 99;\n        }\n    }\n    if (ISTATE == 20) {\n        if (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY != static_cast<IEC_SINT>(9)) {\n            ERRORID = 2;\n            ISTATE = 99;\n        } else if ((MAXACCELERATION > 0.0) & (ABS(VELOCITY - FLAST) > MAXACCELERATION * AXIS.FCYCLETIME * 1.000001)) {\n            ERRORID = 3;\n            ISTATE = 99;\n        } else {\n            AXIS.DRIVE.TARGET_VELOCITY = TO_DINT(VELOCITY * AXIS.FINCPERUNIT);\n            FLAST = VELOCITY;\n        }\n    }\n    INSYNC = ISTATE == 20;\n    BUSY = (ISTATE == 10) | (ISTATE == 20);\n    ERROR = ISTATE == 99;\n    if (ISTATE == 0) {\n        ERRORID = 0;\n    }\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "TON"
        },
