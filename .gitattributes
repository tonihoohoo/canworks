# DBC golden files are CRLF on purpose (what the export writes).
tools/deploy/tests/data/dbc/*.dbc -text

# EDS and DCF files ship to the PLC byte for byte, and the tests compare them
# that way: never convert their line endings on checkout (Windows autocrlf).
*.eds -text
*.dcf -text

# Trace golden files: ASC and TRC are CRLF on purpose (what the export writes).
tools/deploy/tests/data/trace/* -text

# Example configs: the HTML document golden files embed their text and SHA-256,
# so keep them LF on every checkout (Windows autocrlf would add CR).
config/**/*.json text eol=lf
examples/**/*.json text eol=lf

# Frame explanation golden text: LF on every checkout (Windows autocrlf would
# add CR and the comparison is byte for byte).
tools/deploy/tests/data/explain/* text eol=lf

# A source copy made with git archive (no .git) still knows its version:
# install-bridge.sh reads it when git describe cannot run.
scripts/SOURCE_VERSION export-subst

# Shell scripts run in Linux containers (the examples' start.sh is mounted
# into Docker): LF on every checkout, or sh fails on a Windows clone with
# autocrlf.
*.sh text eol=lf
