{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tonihoohoo/canworks/schema/canworks-sim-machine.v1.schema.json",
  "title": "canworks machine file, version 1",
  "description": "A made-up machine around the simulated devices of one network, named by that network's simulation file section (\"machine\": \"machine.json\"; docs/machine.md). Lengths are millimetres: x and y on the table, heights above the table top. Checks the schema cannot express (travel, limits and hard stops in order, part kinds defined, element names unique, no input bit bound twice, panel keys unique, the safety relay's inputs, reset, joints and conveyors, protective fields inside warning fields, joints on simulated CiA 402 axis nodes, bound objects in the node's EDS with a type the bit fits, outputs written by the master in an RPDO and inputs not) are run by the plugin, the simulator and the deploy tool's check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "joints"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Shown in logs and in the configurator."
    },
    "kind": {
      "const": "gantry_xyz",
      "description": "The built-in kinematics and drawing; gantry_xyz is the only kind in this version."
    },
    "units": {
      "const": "mm"
    },
    "tick_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "The machine model's step (default 2 ms)."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Seed of the feeders' random intervals (default 1), so runs repeat."
    },
    "joints": {
      "type": "object",
      "description": "A gantry_xyz machine has the joints x, y and z, each driven by one CiA 402 axis node.",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/joint"
        },
        "y": {
          "$ref": "#/$defs/joint"
        },
        "z": {
          "$ref": "#/$defs/joint"
        }
      }
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "parts": {
      "type": "object",
      "description": "Part kinds by name.",
      "additionalProperties": {
        "$ref": "#/$defs/part"
      }
    },
    "conveyors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conveyor"
      }
    },
    "sensors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sensor"
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "panel": {
      "$ref": "#/$defs/panel"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "visual": {
      "$ref": "#/$defs/visual"
    }
  },
  "$defs": {
    "bit": {
      "type": "object",
      "description": "One bit of an object of a node, as in scenario conditions.",
      "additionalProperties": false,
      "required": [
        "node",
        "object",
        "bit"
      ],
      "properties": {
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "object": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{4}(:([0-9]{1,3}|0x[0-9A-Fa-f]{1,2}))?$"
        },
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        }
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "travel"
      ],
      "properties": {
        "node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127,
          "description": "The CiA 402 axis node that drives the joint."
        },
        "travel": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[low, high], low < high."
        },
        "counts_per_mm": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000000,
          "description": "Drive position counts per millimetre (default 1000)."
        },
        "offset_mm": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000,
          "description": "Joint position at drive position 0."
        },
        "direction": {
          "enum": [
            1,
            -1
          ],
          "description": "-1: drive counts run against the joint."
        },
        "down": {
          "type": "boolean",
          "description": "z: a positive joint position lowers the tool."
        },
        "home_flag": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000,
          "description": "The drive's home switch is on at and below this position."
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Limit switches on at and beyond [low, high]."
        },
        "hard_stops": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "The joint cannot pass [low, high]; outside the limits and the travel."
        },
        "load": {
          "type": "object",
          "description": "Load in per mille of rated torque.",
          "additionalProperties": false,
          "properties": {
            "hold_permille": {
              "type": "number",
              "minimum": -5000,
              "maximum": 5000
            },
            "per_kg_permille": {
              "type": "number",
              "minimum": -5000,
              "maximum": 5000
            },
            "per_m_s2_permille": {
              "type": "number",
              "minimum": -5000,
              "maximum": 5000
            }
          }
        },
        "brake": {
          "type": "boolean",
          "description": "The joint holds its position while its drive is in safe torque off (default false: it coasts to a stop)."
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "close"
      ],
      "properties": {
        "type": {
          "const": "gripper"
        },
        "close": {
          "$ref": "#/$defs/bit",
          "description": "Output: closes the gripper while on."
        },
        "gripped": {
          "$ref": "#/$defs/bit",
          "description": "Input: on while a part is held."
        },
        "stroke_ms": {
          "type": "number",
          "minimum": 1,
          "maximum": 60000
        },
        "open_mm": {
          "type": "number",
          "minimum": 1,
          "maximum": 2000
        },
        "closed_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000,
          "description": "Smaller than open_mm."
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ],
          "description": "The fingers close along x or y."
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Tool point at joint position 0: x, y, height."
        },
        "pick_tolerance_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "finger": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Pad thickness (along the axis), width, height."
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 2000
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "x, y, height."
        },
        "mass_kg": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "conveyor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "from",
        "to",
        "run"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Start [x, y]; from and to share x or y (the belt runs along y or x)."
        },
        "to": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "End [x, y], at the end stop."
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 5000
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "speed_mm_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "gap_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "run": {
          "$ref": "#/$defs/bit",
          "description": "Output: the belt runs while on."
        },
        "feed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "part",
            "every_s"
          ],
          "properties": {
            "part": {
              "type": "string",
              "minLength": 1,
              "description": "A part kind of \"parts\"."
            },
            "every_s": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 3600
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[shortest, longest] interval."
            }
          }
        }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "at",
        "size",
        "output"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Centre of the detection box: x, y, height."
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "detects": {
          "enum": [
            "part",
            "tool"
          ]
        },
        "output": {
          "$ref": "#/$defs/bit",
          "description": "Input: on while something is in the box."
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slots"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "pitch",
            "count"
          ],
          "properties": {
            "origin": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "The first slot's centre."
            },
            "pitch": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 1,
                "maximum": 10000
              },
              "minItems": 2,
              "maxItems": 2
            },
            "count": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000,
          "description": "Pallet top."
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "place_tolerance_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "ready"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/bit",
              "description": "Output: a pallet change while on."
            },
            "ready": {
              "$ref": "#/$defs/bit",
              "description": "Input: on while the pallet is in place."
            },
            "time_s": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 3600
            },
            "move": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Where the pallet goes during a change."
            }
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "description": "An operator panel: buttons and lamps on bits of a simulated I/O node. Button and lamp names share the machine's element names.",
      "additionalProperties": false,
      "properties": {
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/button"
          }
        },
        "lamps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lamp"
          }
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key",
        "input"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Shown in the configurator (default the name)."
        },
        "key": {
          "type": "string",
          "pattern": "^([A-Z0-9]|Space|Enter|Shift|Backspace|Delete|Insert|Home|End|PageUp|PageDown|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|F([1-9]|1[0-2]))$",
          "description": "The key that presses the button in the Machine view: a letter (upper case) or digit, Space, Enter, Shift, Backspace, Delete, Insert, Home, End, PageUp, PageDown, an arrow key or F1-F12. Tab and Escape are the view's own."
        },
        "kind": {
          "enum": [
            "momentary",
            "switch",
            "latching"
          ],
          "description": "momentary (default): on while pressed; switch: keeps the position it was last set to; latching: an emergency stop, a press latches it and a second press releases it."
        },
        "input": {
          "$ref": "#/$defs/bit",
          "description": "Input: on while the button is on."
        }
      }
    },
    "lamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "output"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Shown in the configurator (default the name)."
        },
        "output": {
          "$ref": "#/$defs/bit",
          "description": "Output: the lamp is lit while on."
        }
      }
    },
    "safety": {
      "type": "object",
      "description": "A virtual safety relay and safety scanners: a simulation for trying a PLC program's reaction, no safety function.",
      "additionalProperties": false,
      "required": [
        "relay"
      ],
      "properties": {
        "relay": {
          "$ref": "#/$defs/relay"
        },
        "scanners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scanner"
          }
        }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "reset"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Latching panel buttons (emergency stops) and scanners (their protective fields) that open the relay."
        },
        "reset": {
          "type": "string",
          "minLength": 1,
          "description": "A momentary panel button; its rising edge closes the relay once every input is clear."
        },
        "stop_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Time from opening to safe torque off (stop category 1; default 300)."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The joints whose drives it switches off (default all)."
        },
        "conveyors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The conveyors it cuts (default all)."
        },
        "feedback": {
          "$ref": "#/$defs/bit",
          "description": "Input: on while the relay is closed."
        }
      }
    },
    "box": {
      "type": "object",
      "description": "A box on the floor: a corner and the size along x and y.",
      "additionalProperties": false,
      "required": [
        "origin",
        "size"
      ],
      "properties": {
        "origin": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "at",
        "warning",
        "protective"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "The mounting point [x, y]."
        },
        "warning": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/box"
          },
          "description": "The warning field."
        },
        "protective": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/box"
          },
          "description": "The protective field, inside the warning field: an input of the relay."
        },
        "warning_output": {
          "$ref": "#/$defs/bit",
          "description": "Input: on while the warning field is occupied."
        }
      }
    },
    "visual": {
      "type": "object",
      "description": "For the configurator's Machine tab only; the simulator does not read it. Other keys are allowed.",
      "properties": {
        "floor": {
          "type": "object",
          "properties": {
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[w, d]"
            }
          }
        },
        "table": {
          "type": "object",
          "properties": {
            "origin": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y] of a corner"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[w, d]"
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000,
              "description": "Table top above the floor."
            }
          }
        },
        "frame": {
          "type": "object",
          "properties": {
            "origin": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[w, d]"
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "profile_mm": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000,
              "description": "T-slot profile size."
            }
          }
        },
        "fence": {
          "type": "object",
          "properties": {
            "origin": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[w, d]"
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        "stack_light": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[x, y]"
        },
        "colors": {
          "type": "object",
          "description": "Element name -> colour.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    }
  }
}
