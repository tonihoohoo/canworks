(*
 * J1939_NAME_MAKE: a 64-bit J1939 NAME from its fields (spec
 * j1939-plc-blocks), packed as the config's ecu.name and the PC tools pack
 * it. Each field is cut to its width.
 *)
FUNCTION J1939_NAME_MAKE : LWORD
VAR_INPUT
  IDENTITY_NUMBER : UDINT;
  MANUFACTURER_CODE : UINT;
  ECU_INSTANCE : USINT;
  FUNCTION_INSTANCE : USINT;
  ECU_FUNCTION : USINT;
  VEHICLE_SYSTEM : USINT;
  VEHICLE_SYSTEM_INSTANCE : USINT;
  INDUSTRY_GROUP : USINT;
  ARBITRARY_ADDRESS_CAPABLE : BOOL;
END_VAR
VAR
  n : LWORD;
END_VAR
  n := UDINT_TO_LWORD(IDENTITY_NUMBER) AND 16#1FFFFF;
  n := n OR SHL(UINT_TO_LWORD(MANUFACTURER_CODE) AND 16#7FF, 21);
  n := n OR SHL(USINT_TO_LWORD(ECU_INSTANCE) AND 16#7, 32);
  n := n OR SHL(USINT_TO_LWORD(FUNCTION_INSTANCE) AND 16#1F, 35);
  n := n OR SHL(USINT_TO_LWORD(ECU_FUNCTION) AND 16#FF, 40);
  n := n OR SHL(USINT_TO_LWORD(VEHICLE_SYSTEM) AND 16#7F, 49);
  n := n OR SHL(USINT_TO_LWORD(VEHICLE_SYSTEM_INSTANCE) AND 16#F, 56);
  n := n OR SHL(USINT_TO_LWORD(INDUSTRY_GROUP) AND 16#7, 60);
  IF ARBITRARY_ADDRESS_CAPABLE THEN
    n := n OR LWORD#16#8000000000000000;
  END_IF;
  J1939_NAME_MAKE := n;
END_FUNCTION
