(*
 * J1939_NAME_MAKE: a 64-bit J1939 NAME from its fields (spec
 * j1939-plc-blocks), packed as the config's ecu.name and the PC tools pack
 * it. Each field is cut to its width.
 *)
FUNCTION J1939_NAME_MAKE : LWORD
VAR_INPUT
  IDENTITY_NUMBER : UDINT;
  MANUFACTURER_CODE : UINT;
  ECU_INSTANCE : USINT;
  FUNCTION_INSTANCE : USINT;
  ECU_FUNCTION : USINT;
  VEHICLE_SYSTEM : USINT;
  VEHICLE_SYSTEM_INSTANCE : USINT;
  INDUSTRY_GROUP : USINT;
  ARBITRARY_ADDRESS_CAPABLE : BOOL;
END_VAR
VAR
  bits : LWORD;
END_VAR
  bits := UDINT_TO_LWORD(IDENTITY_NUMBER) AND LWORD#16#1FFFFF;
  bits := bits OR SHL(UINT_TO_LWORD(MANUFACTURER_CODE) AND LWORD#16#7FF, 21);
  bits := bits OR SHL(USINT_TO_LWORD(ECU_INSTANCE) AND LWORD#16#7, 32);
  bits := bits OR SHL(USINT_TO_LWORD(FUNCTION_INSTANCE) AND LWORD#16#1F, 35);
  bits := bits OR SHL(USINT_TO_LWORD(ECU_FUNCTION) AND LWORD#16#FF, 40);
  bits := bits OR SHL(USINT_TO_LWORD(VEHICLE_SYSTEM) AND LWORD#16#7F, 49);
  bits := bits OR SHL(USINT_TO_LWORD(VEHICLE_SYSTEM_INSTANCE) AND LWORD#16#F, 56);
  bits := bits OR SHL(USINT_TO_LWORD(INDUSTRY_GROUP) AND LWORD#16#7, 60);
  IF ARBITRARY_ADDRESS_CAPABLE THEN
    bits := bits OR SHL(LWORD#1, 63);
  END_IF;
  J1939_NAME_MAKE := bits;
END_FUNCTION
