(*
 * J1939_NAME_SPLIT: the fields of a 64-bit J1939 NAME (spec
 * j1939-plc-blocks), the reverse of J1939_NAME_MAKE.
 *)
FUNCTION_BLOCK J1939_NAME_SPLIT
VAR_INPUT
  NAME : LWORD;
END_VAR
VAR_OUTPUT
  IDENTITY_NUMBER : UDINT;
  MANUFACTURER_CODE : UINT;
  ECU_INSTANCE : USINT;
  FUNCTION_INSTANCE : USINT;
  ECU_FUNCTION : USINT;
  VEHICLE_SYSTEM : USINT;
  VEHICLE_SYSTEM_INSTANCE : USINT;
  INDUSTRY_GROUP : USINT;
  ARBITRARY_ADDRESS_CAPABLE : BOOL;
END_VAR
  IDENTITY_NUMBER := LWORD_TO_UDINT(NAME AND 16#1FFFFF);
  MANUFACTURER_CODE := LWORD_TO_UINT(SHR(NAME, 21) AND 16#7FF);
  ECU_INSTANCE := LWORD_TO_USINT(SHR(NAME, 32) AND 16#7);
  FUNCTION_INSTANCE := LWORD_TO_USINT(SHR(NAME, 35) AND 16#1F);
  ECU_FUNCTION := LWORD_TO_USINT(SHR(NAME, 40) AND 16#FF);
  VEHICLE_SYSTEM := LWORD_TO_USINT(SHR(NAME, 49) AND 16#7F);
  VEHICLE_SYSTEM_INSTANCE := LWORD_TO_USINT(SHR(NAME, 56) AND 16#F);
  INDUSTRY_GROUP := LWORD_TO_USINT(SHR(NAME, 60) AND 16#7);
  ARBITRARY_ADDRESS_CAPABLE := (NAME AND LWORD#16#8000000000000000) <> 0;
END_FUNCTION_BLOCK
