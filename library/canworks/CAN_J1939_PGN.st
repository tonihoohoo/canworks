(*
 * CAN_J1939_PGN: the PGN of a 29-bit J1939 identifier; for a PDU1 PGN (PF
 * below 240) the destination byte is cleared.
 *)
FUNCTION CAN_J1939_PGN : UDINT
VAR_INPUT
  ID : UDINT;
END_VAR
VAR
  p : DWORD;
END_VAR
  p := SHR(UDINT_TO_DWORD(ID), 8) AND DWORD#16#3FFFF;
  IF (SHR(p, 8) AND DWORD#16#FF) < DWORD#240 THEN
    p := p AND DWORD#16#3FF00;
  END_IF;
  CAN_J1939_PGN := DWORD_TO_UDINT(p);
END_FUNCTION
