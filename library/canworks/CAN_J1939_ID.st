(*
 * CAN_J1939_ID: the 29-bit identifier of a J1939 frame (send it with
 * EXTENDED := TRUE). For a PDU1 PGN (PF below 240) DESTINATION goes into the
 * PS byte; for a PDU2 PGN it is ignored.
 *)
FUNCTION CAN_J1939_ID : UDINT
VAR_INPUT
  PRIORITY : USINT;
  PGN : UDINT;
  SOURCE : USINT;
  DESTINATION : USINT;
END_VAR
VAR
  p : UDINT;
END_VAR
  p := PGN AND 16#3FFFF;
  IF (SHR(p, 8) AND 16#FF) < 240 THEN
    p := (p AND 16#3FF00) OR USINT_TO_UDINT(DESTINATION);
  END_IF;
  CAN_J1939_ID := SHL(USINT_TO_UDINT(PRIORITY) AND 16#7, 26) OR SHL(p, 8) OR USINT_TO_UDINT(SOURCE);
END_FUNCTION
